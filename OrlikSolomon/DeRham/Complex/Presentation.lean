/-!
# Differential ideals and the canonical presentation

An ideal `I` of a `k`-algebra `P` generates a *differential ideal* of forms,
`J = I Ω_P^• + dI ∧ Ω_P^•`, which is two-sided and stable under `d`. For a surjection `φ : P → S`
with kernel `I`, the map of forms along `φ` is surjective with kernel `J`, so forms on `S` are the
quotient of forms on `P` by `J`, compatibly with `d` and with degrees.

This is `lem:dr-presentation` for an arbitrary surjection, and `lem:dr-quotient` will apply it to
`A → A ⧸ (f)`. The canonical presentation `P_A = k[X_a | a ∈ A]` of the blueprint is its case
`φ = presentationHom k A`. No part of the library depends on that presentation, since `d` is not
constructed from it. Its role here is to show that the operator descended from `P_A`, as in
`def:dr-complex`, is `d`, in `presentationEquiv_dQuotient`.

## Main definitions

* `OrlikSolomon.DeRham.differentialIdeal k I`: the differential ideal `J` of an ideal `I`.
* `OrlikSolomon.DeRham.differentialIdealPower k I n`: its part `J^n` of degree `n`.
* `OrlikSolomon.DeRham.presentationHom k A`: the map `ε : k[X_a | a ∈ A] → A`.
* `OrlikSolomon.DeRham.quotientEquiv` and `OrlikSolomon.DeRham.quotientPowerEquiv`: the quotient of
  forms by `J`, in total degree and in degree `n`.

## Main results

Blueprint `lem:dr-presentation`:

* `OrlikSolomon.DeRham.d_mem_differentialIdeal`: `J` is stable under `d`, and
  `OrlikSolomon.DeRham.mul_mem_differentialIdeal_left` and
  `OrlikSolomon.DeRham.mul_mem_differentialIdeal_right` say that it is two-sided.
* `OrlikSolomon.DeRham.differentialIdealPower_zero` and
  `OrlikSolomon.DeRham.differentialIdealPower_succ`: the blueprint's description of `J^n`.
* `OrlikSolomon.DeRham.ker_kaehlerMap_of_surjective`: the kernel on one-forms.
* `OrlikSolomon.DeRham.Forms.map_eq_zero_iff_of_surjective`: the kernel on forms.
* `OrlikSolomon.DeRham.quotientEquiv_dQuotient`: the operator induced by `d` on the quotient is the
  differential of `S`, and `OrlikSolomon.DeRham.presentationEquiv_dQuotient` is this for `P_A`.

For `lem:dr-quotient`, `OrlikSolomon.DeRham.differentialIdeal_span` and
`OrlikSolomon.DeRham.differentialIdealPower_span` describe the differential ideal of an ideal by
generators of that ideal, such as `f Ω^n + df ∧ Ω^(n-1)` for `(f)`.
-/

@[expose] public section

open scoped TensorProduct

namespace OrlikSolomon.DeRham

open ExteriorAlgebra (ι)
open KaehlerDifferential (D)

universe u v v'

variable (k : Type u) [CommRing k] {P : Type v} [CommRing P] [Algebra k P]
  {S : Type v'} [CommRing S] [Algebra k S]

/-! ### The kernel on one-forms -/

section Kaehler

variable (S) [Algebra P S] [IsScalarTower k P S]

/-- For a surjection `P → S` with kernel `I`, the kernel of `Ω[P⁄k] → Ω[S⁄k]` is
`I Ω[P⁄k] + P dI`.

Blueprint: `lem:dr-presentation`, the module represents derivations from `S`. -/
theorem ker_kaehlerMap_of_surjective (h : Function.Surjective (algebraMap P S)) :
    LinearMap.ker (KaehlerDifferential.map k k P S) =
      RingHom.ker (algebraMap P S) • ⊤ ⊔
        Submodule.span P (D k P '' (RingHom.ker (algebraMap P S) : Set P)) := by
  apply le_antisymm
  · intro ω hω
    have h0 : KaehlerDifferential.mapBaseChange k P S ((1 : S) ⊗ₜ ω) = 0 := by
      rw [KaehlerDifferential.mapBaseChange_tmul, LinearMap.mem_ker.1 hω, smul_zero]
    obtain ⟨y, hy⟩ :=
      (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k P S h _).1 h0
    obtain ⟨c, rfl⟩ := Ideal.toCotangent_surjective _ y
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hy
    have hz : (1 : S) ⊗ₜ[P] (ω - D k P c) = 0 := by
      rw [TensorProduct.tmul_sub, hy, sub_self]
    have hω' : ω = (ω - D k P c) + D k P c := by abel
    rw [hω']
    exact add_mem (Submodule.mem_sup_left (mem_smul_top_of_one_tmul_eq_zero S h hz))
      (Submodule.mem_sup_right (Submodule.subset_span ⟨c, c.2, rfl⟩))
  · refine sup_le ?_ ?_
    · rw [Submodule.smul_le]
      rintro i hi ω -
      rw [LinearMap.mem_ker, map_smul, ← algebraMap_smul S i, RingHom.mem_ker.1 hi, zero_smul]
    · rw [Submodule.span_le]
      rintro _ ⟨c, hc, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, KaehlerDifferential.map_D, RingHom.mem_ker.1 hc,
        map_zero]

end Kaehler

/-! ### The differential ideal -/

/-- The differential ideal `I Ω^• + dI ∧ Ω^•` of forms generated by an ideal `I` of `P`. By
`mem_differentialIdealPower_iff`, its part of degree `n` is `differentialIdealPower k I n`, the
blueprint's `J^n`. It is the kernel of the map of forms along a surjection with kernel `I`, by
`Forms.map_eq_zero_iff_of_surjective`. Use `differentialIdeal_induction` rather than this
definition.

Blueprint: `lem:dr-presentation`. -/
noncomputable def differentialIdeal (I : Ideal P) : Submodule P (Forms k P) :=
  I • ⊤ ⊔ wedgeIdeal (Submodule.span P (D k P '' (I : Set P)))

variable {k} {I : Ideal P}

theorem smul_mem_differentialIdeal {c : P} (hc : c ∈ I) (x : Forms k P) :
    c • x ∈ differentialIdeal k I :=
  Submodule.mem_sup_left (Submodule.smul_mem_smul hc Submodule.mem_top)

theorem diff_mul_mem_differentialIdeal {c : P} (hc : c ∈ I) (x : Forms k P) :
    diff k c * x ∈ differentialIdeal k I := by
  refine Submodule.mem_sup_right (ι_mul_mem_wedgeIdeal (n := D k P c) ?_ x)
  exact Submodule.subset_span ⟨c, hc, rfl⟩

/-- Induction over the differential ideal: it suffices to treat `c • x` and `dc ∧ x` for `c` in the
ideal, and sums. -/
@[elab_as_elim]
theorem differentialIdeal_induction {p : (x : Forms k P) → x ∈ differentialIdeal k I → Prop}
    (smul : ∀ (c : P) (hc : c ∈ I) (x : Forms k P), p (c • x) (smul_mem_differentialIdeal hc x))
    (diff_mul : ∀ (c : P) (hc : c ∈ I) (x : Forms k P),
      p (diff k c * x) (diff_mul_mem_differentialIdeal hc x))
    (add : ∀ x hx y hy, p x hx → p y hy → p (x + y) (add_mem hx hy))
    {x : Forms k P} (hx : x ∈ differentialIdeal k I) : p x hx := by
  have hadd {x y : Forms k P} : (∃ h, p x h) → (∃ h, p y h) → ∃ h, p (x + y) h :=
    fun ⟨h₁, h₁'⟩ ⟨h₂, h₂'⟩ => ⟨_, add x h₁ y h₂ h₁' h₂'⟩
  have hcast {x y : Forms k P} (e : x = y) : (∃ h, p x h) → ∃ h, p y h := fun h => e ▸ h
  have hzero : ∃ h, p 0 h := hcast (smul_zero (0 : P)) ⟨_, smul 0 I.zero_mem 0⟩
  have h₁ {a : Forms k P} (ha : a ∈ I • (⊤ : Submodule P (Forms k P))) : ∃ h, p a h := by
    induction ha using Submodule.smul_induction_on' with
    | smul c hc x _ => exact ⟨_, smul c hc x⟩
    | add a _ b _ ha hb => exact hadd ha hb
  have h₂ {b : Forms k P}
      (hb : b ∈ wedgeIdeal (Submodule.span P (D k P '' (I : Set P)))) : ∃ h, p b h := by
    induction hb using wedgeIdeal_induction with
    | mul n hn y =>
      induction hn using Submodule.span_induction generalizing y with
      | mem n hn =>
        obtain ⟨c, hc, rfl⟩ := hn
        exact ⟨_, diff_mul c hc y⟩
      | zero => exact hcast (by simp) hzero
      | add m n _ _ hm hn => exact hcast (by simp [add_mul]) (hadd (hm y) (hn y))
      | smul c n _ hn => exact hcast (by simp) (hn (c • y))
    | add a _ b _ ha hb => exact hadd ha hb
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 hx
  exact (hcast hab (hadd (h₁ ha) (h₂ hb))).2

/-- The differential ideal is a right ideal.

Blueprint: `lem:dr-presentation`. -/
theorem mul_mem_differentialIdeal_right {x : Forms k P} (hx : x ∈ differentialIdeal k I)
    (y : Forms k P) : x * y ∈ differentialIdeal k I := by
  induction hx using differentialIdeal_induction with
  | smul c hc x =>
    rw [smul_mul_assoc]
    exact smul_mem_differentialIdeal hc _
  | diff_mul c hc x =>
    rw [mul_assoc]
    exact diff_mul_mem_differentialIdeal hc _
  | add a _ b _ ha hb =>
    rw [add_mul]
    exact add_mem ha hb

/-- The differential ideal is a left ideal.

Blueprint: `lem:dr-presentation`. -/
theorem mul_mem_differentialIdeal_left (y : Forms k P) {x : Forms k P}
    (hx : x ∈ differentialIdeal k I) : y * x ∈ differentialIdeal k I := by
  have h₁ {a : Forms k P} (ha : a ∈ I • (⊤ : Submodule P (Forms k P))) :
      y * a ∈ I • (⊤ : Submodule P (Forms k P)) := by
    induction ha using Submodule.smul_induction_on' with
    | smul c hc x _ =>
      rw [mul_smul_comm]
      exact Submodule.smul_mem_smul hc Submodule.mem_top
    | add a _ b _ ha hb =>
      rw [mul_add]
      exact add_mem ha hb
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hx
  rw [mul_add]
  exact add_mem (Submodule.mem_sup_left (h₁ ha))
    (Submodule.mem_sup_right (mul_mem_wedgeIdeal_left y hb))

/-- The differential ideal is stable under `d`, because
`d (c • x) = dc ∧ x + c • dx` and `d (dc ∧ x) = -dc ∧ dx`.

Blueprint: `lem:dr-presentation`. -/
theorem d_mem_differentialIdeal {x : Forms k P} (hx : x ∈ differentialIdeal k I) :
    d k x ∈ differentialIdeal k I := by
  induction hx using differentialIdeal_induction with
  | smul c hc x =>
    rw [d_smul]
    exact add_mem (diff_mul_mem_differentialIdeal hc x) (smul_mem_differentialIdeal hc _)
  | diff_mul c hc x =>
    rw [d_diff_mul, ← mul_neg]
    exact diff_mul_mem_differentialIdeal hc _
  | add a _ b _ ha hb =>
    rw [map_add]
    exact add_mem ha hb

/-! ### The part of degree `n` -/

variable (k) in
/-- The part `J^n = I Ω^n + dI ∧ Ω^(n-1)` of the differential ideal in degree `n`, as a submodule of
the forms of degree `n`. This is the blueprint's display: see `differentialIdealPower_zero`,
`differentialIdealPower_succ` and `mem_differentialIdealPower_iff`.

Blueprint: `lem:dr-presentation`. -/
noncomputable def differentialIdealPower (I : Ideal P) (n : ℕ) : Submodule P (⋀[P]^n Ω[P⁄k]) :=
  I • ⊤ ⊔ wedgeSubmodule (Submodule.span P (D k P '' (I : Set P))) n

/-- In degree zero, `J⁰ = I Ω⁰`. -/
@[simp]
theorem differentialIdealPower_zero (I : Ideal P) :
    differentialIdealPower k I 0 = I • ⊤ := by
  rw [differentialIdealPower, wedgeSubmodule_zero, sup_bot_eq]

/-- In degree `n + 1`, the module `J^(n+1)` is spanned by `I Ω^(n+1)` and the wedges `dh ∧ η` for
`h ∈ I` and `η ∈ Ω^n`.

Blueprint: `lem:dr-presentation`. -/
theorem differentialIdealPower_succ (I : Ideal P) (n : ℕ) :
    differentialIdealPower k I (n + 1) =
      I • ⊤ ⊔ Submodule.span P
        {x | ∃ h ∈ I, ∃ η : ⋀[P]^n Ω[P⁄k], wedgeLeft (D k P h) n η = x} := by
  rw [differentialIdealPower, wedgeSubmodule_span]
  congr 2
  ext x
  simp

/-- An element of degree `n` lies in `I ⋀ M + (N)` if and only if it lies in `I ⋀^n M + N ∧ ⋀^(n-1) M`.
This says that the ideal is homogeneous. -/
theorem coe_mem_smul_top_sup_wedgeIdeal_iff {M : Type*} [AddCommGroup M] [Module P M] (I : Ideal P)
    (N : Submodule P M) {n : ℕ} {x : ⋀[P]^n M} :
    (x : ExteriorAlgebra P M) ∈ I • (⊤ : Submodule P (ExteriorAlgebra P M)) ⊔ wedgeIdeal N ↔
      x ∈ I • (⊤ : Submodule P (⋀[P]^n M)) ⊔ wedgeSubmodule N n := by
  constructor
  · intro hx
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 hx
    have h : x = exteriorProj n a + exteriorProj n b := by
      rw [← map_add, hab, exteriorProj_coe]
    have ha' : exteriorProj n a ∈ I • (⊤ : Submodule P (⋀[P]^n M)) := by
      have := Submodule.mem_map_of_mem (f := exteriorProj n) ha
      rw [Submodule.map_smul''] at this
      exact Submodule.smul_mono le_rfl le_top this
    rw [h]
    exact add_mem (Submodule.mem_sup_left ha')
      (Submodule.mem_sup_right (exteriorProj_mem_wedgeSubmodule hb n))
  · intro hx
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hx
    refine add_mem (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right hb)
    have := Submodule.mem_map_of_mem (f := (⋀[P]^n M).subtype) ha
    rw [Submodule.map_smul''] at this
    exact Submodule.smul_mono le_rfl le_top this

/-- A form of degree `n` lies in `J^n` if and only if it lies in the differential ideal.

Blueprint: `lem:dr-presentation`, that the ideal is homogeneous. -/
theorem mem_differentialIdealPower_iff {n : ℕ} {x : ⋀[P]^n Ω[P⁄k]} :
    x ∈ differentialIdealPower k I n ↔ (x : Forms k P) ∈ differentialIdeal k I :=
  (coe_mem_smul_top_sup_wedgeIdeal_iff I _).symm

/-! ### Generators -/

/-- The differentials of an ideal generated by `s` are generated, modulo the ideal, by those of
`s`. This is the Leibniz rule. -/
private theorem span_D_span_le (s : Set P) :
    Submodule.span P (D k P '' (Ideal.span s : Set P)) ≤
      Ideal.span s • ⊤ ⊔ Submodule.span P (D k P '' s) := by
  rw [Submodule.span_le]
  rintro _ ⟨c, hc, rfl⟩
  induction hc using Submodule.span_induction with
  | mem c hc => exact Submodule.mem_sup_right (Submodule.subset_span ⟨c, hc, rfl⟩)
  | zero => simp
  | add a b _ _ ha hb =>
    rw [map_add]
    exact add_mem ha hb
  | smul a c hc hc' =>
    rw [smul_eq_mul, Derivation.leibniz]
    exact add_mem (Submodule.smul_mem _ a hc')
      (Submodule.mem_sup_left (Submodule.smul_mem_smul hc Submodule.mem_top))

/-- Wedging with `I M` is contained in multiplying by `I`. -/
theorem wedgeIdeal_smul_top_le {M : Type*} [AddCommGroup M] [Module P M] (I : Ideal P) :
    wedgeIdeal (I • ⊤ : Submodule P M) ≤ I • ⊤ := by
  intro x hx
  induction hx using wedgeIdeal_induction with
  | mul n hn y =>
    induction hn using Submodule.smul_induction_on' with
    | smul c hc m _ =>
      rw [map_smul, smul_mul_assoc]
      exact Submodule.smul_mem_smul hc Submodule.mem_top
    | add m _ n _ hm hn =>
      rw [map_add, add_mul]
      exact add_mem hm hn
  | add a _ b _ ha hb => exact add_mem ha hb

/-- The differential ideal of an ideal generated by `s` is generated by `s` and `ds`. For a
principal ideal this is `f Ω^• + df ∧ Ω^•`.

Blueprint: `lem:dr-quotient` uses this form. -/
theorem differentialIdeal_span (s : Set P) :
    differentialIdeal k (Ideal.span s) =
      Ideal.span s • ⊤ ⊔ wedgeIdeal (Submodule.span P (D k P '' s)) := by
  apply le_antisymm
  · refine sup_le le_sup_left ?_
    refine (wedgeIdeal_mono (span_D_span_le s)).trans ?_
    rw [wedgeIdeal_sup]
    exact sup_le_sup_right (wedgeIdeal_smul_top_le _) _
  · refine sup_le_sup_left (wedgeIdeal_mono (Submodule.span_mono ?_)) _
    exact Set.image_mono Ideal.subset_span

/-- The part of degree `n` of the differential ideal of an ideal generated by `s`. For a principal
ideal this is `f Ω^n + df ∧ Ω^(n-1)`.

Blueprint: `lem:dr-quotient` uses this form. -/
theorem differentialIdealPower_span (s : Set P) (n : ℕ) :
    differentialIdealPower k (Ideal.span s) n =
      Ideal.span s • ⊤ ⊔ wedgeSubmodule (Submodule.span P (D k P '' s)) n := by
  ext x
  rw [mem_differentialIdealPower_iff, differentialIdeal_span, coe_mem_smul_top_sup_wedgeIdeal_iff]

/-! ### The map of forms along a surjection -/

namespace Forms

variable {φ : P →ₐ[k] S}

/-- A surjection of algebras induces a surjection on forms. -/
theorem map_surjective (hφ : Function.Surjective φ) : Function.Surjective (map φ) := by
  intro y
  induction y using Forms.induction with
  | word a l =>
    obtain ⟨a, rfl⟩ := hφ a
    obtain ⟨l, rfl⟩ : ∃ l' : List P, l'.map φ = l := by
      refine ⟨l.map (Function.surjInv hφ), ?_⟩
      simp [Function.comp_def, Function.surjInv_eq hφ]
    exact ⟨a • word (diff k) l, map_smul_word φ a l⟩
  | add x y hx hy =>
    obtain ⟨x, rfl⟩ := hx
    obtain ⟨y, rfl⟩ := hy
    exact ⟨x + y, map_add _ x y⟩

/-- The map on forms in degree `n` along a surjection of algebras is surjective.

Blueprint: `lem:dr-presentation`. -/
theorem mapPower_surjective (hφ : Function.Surjective φ) (n : ℕ) :
    Function.Surjective (mapPower φ n) := by
  intro y
  obtain ⟨y, hy⟩ := y
  induction hy using Forms.induction_exteriorPower with
  | word a l hl =>
    obtain ⟨a, rfl⟩ := hφ a
    obtain ⟨l, rfl⟩ : ∃ l' : List P, l'.map φ = l := by
      refine ⟨l.map (Function.surjInv hφ), ?_⟩
      simp [Function.comp_def, Function.surjInv_eq hφ]
    refine ⟨⟨a • word (diff k) l, smul_word_diff_mem_exteriorPower k a (by simpa using hl)⟩, ?_⟩
    exact Subtype.ext (map_smul_word φ a l)
  | add x hx y hy hx' hy' =>
    obtain ⟨x', hx'⟩ := hx'
    obtain ⟨y', hy'⟩ := hy'
    exact ⟨x' + y', by rw [map_add, hx', hy']; rfl⟩

/-- The differential ideal of the kernel maps to zero, with no surjectivity. -/
theorem map_eq_zero_of_mem_differentialIdeal {x : Forms k P}
    (hx : x ∈ differentialIdeal k (RingHom.ker φ)) : map φ x = 0 := by
  induction hx using differentialIdeal_induction with
  | smul c hc x => rw [map_smul, RingHom.mem_ker.1 hc, zero_smul]
  | diff_mul c hc x => rw [map_mul, map_diff, RingHom.mem_ker.1 hc]; simp
  | add a _ b _ ha hb => rw [map_add, ha, hb, add_zero]

/-- The kernel of the map on forms along a surjection `φ` is the differential ideal of `ker φ`.

Blueprint: `lem:dr-presentation`. -/
theorem map_eq_zero_iff_of_surjective (hφ : Function.Surjective φ) {x : Forms k P} :
    map φ x = 0 ↔ x ∈ differentialIdeal k (RingHom.ker φ) := by
  refine ⟨fun hx => ?_, map_eq_zero_of_mem_differentialIdeal⟩
  let : Algebra P S := φ.toAlgebra
  have : IsScalarTower k P S := .of_algebraMap_eq fun c => (φ.commutes c).symm
  have hker : RingHom.ker (algebraMap P S) = RingHom.ker φ := rfl
  have hg := KaehlerDifferential.map_surjective_of_surjective k k P S hφ
  have hx' : x ∈ LinearMap.ker (exteriorMap S (KaehlerDifferential.map k k P S)).toLinearMap := by
    rw [LinearMap.mem_ker]
    change exteriorMap S _ x = 0
    rw [← map_toAlgHom k P S]
    exact hx
  rw [ker_exteriorMap S hφ hg, ker_kaehlerMap_of_surjective k S hφ, wedgeIdeal_sup, hker,
    ← sup_assoc, sup_eq_left.2 (wedgeIdeal_smul_top_le _)] at hx'
  exact hx'

/-- The kernel of the map on forms along a surjection, as an equality of `k`-submodules.

Blueprint: `lem:dr-presentation`. -/
theorem ker_map_of_surjective (hφ : Function.Surjective φ) :
    LinearMap.ker (map φ).toLinearMap =
      (differentialIdeal k (RingHom.ker φ)).restrictScalars k :=
  Submodule.ext fun _ => map_eq_zero_iff_of_surjective hφ

/-- The kernel of the map in degree `n` along a surjection `φ` is `J^n`, for `J` the differential
ideal of `ker φ`.

Blueprint: `lem:dr-presentation`. -/
theorem mapPower_eq_zero_iff_of_surjective (hφ : Function.Surjective φ) {n : ℕ}
    {x : ⋀[P]^n Ω[P⁄k]} :
    mapPower φ n x = 0 ↔ x ∈ differentialIdealPower k (RingHom.ker φ) n := by
  rw [mem_differentialIdealPower_iff, ← map_eq_zero_iff_of_surjective hφ, ← Subtype.coe_inj,
    coe_mapPower]
  rfl

/-- The kernel of the map in degree `n`, as an equality of `k`-submodules.

Blueprint: `lem:dr-presentation`. -/
theorem ker_mapPower_of_surjective (hφ : Function.Surjective φ) (n : ℕ) :
    LinearMap.ker (mapPower φ n) =
      (differentialIdealPower k (RingHom.ker φ) n).restrictScalars k :=
  Submodule.ext fun _ => mapPower_eq_zero_iff_of_surjective hφ

end Forms

/-! ### The quotient of forms by a differential ideal -/

/-- The operator that `d` induces on the quotient of forms by a differential ideal. -/
noncomputable def dQuotient (I : Ideal P) :
    (Forms k P ⧸ (differentialIdeal k I).restrictScalars k) →ₗ[k]
      (Forms k P ⧸ (differentialIdeal k I).restrictScalars k) :=
  ((differentialIdeal k I).restrictScalars k).mapQ _ (d k) fun _ hx => d_mem_differentialIdeal hx

@[simp]
theorem dQuotient_mk (I : Ideal P) (x : Forms k P) :
    dQuotient I (Submodule.Quotient.mk x) = Submodule.Quotient.mk (d k x) :=
  rfl

section Quotient

variable {φ : P →ₐ[k] S} (hφ : Function.Surjective φ)

/-- Forms on `S` are the quotient of forms on `P` by the differential ideal of the kernel, for a
surjection `φ : P → S`. The equivalence sends the class of `x` to `Forms.map φ x`.

Blueprint: `lem:dr-presentation`. -/
noncomputable def quotientEquiv :
    (Forms k P ⧸ (differentialIdeal k (RingHom.ker φ)).restrictScalars k) ≃ₗ[k] Forms k S :=
  (Submodule.quotEquivOfEq _ _ (Forms.ker_map_of_surjective hφ).symm).trans
    ((Forms.map φ).toLinearMap.quotKerEquivOfSurjective (Forms.map_surjective hφ))

@[simp]
theorem quotientEquiv_mk (x : Forms k P) :
    quotientEquiv hφ (Submodule.Quotient.mk x) = Forms.map φ x :=
  rfl

/-- The equivalence is multiplicative, since `Forms.map φ` is an algebra map. Together with
`quotientEquiv_mk`, this is the identification of the quotient as a graded algebra: the two-sided
ideal is `differentialIdeal`, it is homogeneous by `mem_differentialIdealPower_iff`, and the
quotient of each degree is `quotientPowerEquiv`.

Blueprint: `lem:dr-presentation`. -/
theorem quotientEquiv_mk_mul (x y : Forms k P) :
    quotientEquiv hφ (Submodule.Quotient.mk (x * y)) =
      quotientEquiv hφ (Submodule.Quotient.mk x) * quotientEquiv hφ (Submodule.Quotient.mk y) :=
  map_mul (Forms.map φ) x y

/-- The operator descended from `d` on `P` is the differential of `S`. So the blueprint's definition
of the differential by descent agrees with `d`.

Blueprint: `lem:dr-presentation` and `def:dr-complex`. -/
theorem quotientEquiv_dQuotient
    (x : Forms k P ⧸ (differentialIdeal k (RingHom.ker φ)).restrictScalars k) :
    quotientEquiv hφ (dQuotient _ x) = d k (quotientEquiv hφ x) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  exact Forms.map_d φ x

/-- Forms of degree `n` on `S` are the quotient of forms of degree `n` on `P` by `J^n`, for a
surjection `φ : P → S`.

Blueprint: `lem:dr-presentation`. -/
noncomputable def quotientPowerEquiv (n : ℕ) :
    (⋀[P]^n Ω[P⁄k] ⧸ (differentialIdealPower k (RingHom.ker φ) n).restrictScalars k) ≃ₗ[k]
      ⋀[S]^n Ω[S⁄k] :=
  (Submodule.quotEquivOfEq _ _ (Forms.ker_mapPower_of_surjective hφ n).symm).trans
    ((Forms.mapPower φ n).quotKerEquivOfSurjective (Forms.mapPower_surjective hφ n))

@[simp]
theorem quotientPowerEquiv_mk (n : ℕ) (x : ⋀[P]^n Ω[P⁄k]) :
    quotientPowerEquiv hφ n (Submodule.Quotient.mk x) = Forms.mapPower φ n x :=
  rfl

end Quotient

/-! ### The canonical presentation -/

section Presentation

variable (k) (A : Type v) [CommRing A] [Algebra k A]

open MvPolynomial (X)

/-- The canonical presentation `ε : P_A = k[X_a | a ∈ A] → A`, sending `X_a` to `a`.

Blueprint: `lem:dr-presentation`. -/
noncomputable def presentationHom : MvPolynomial A k →ₐ[k] A :=
  MvPolynomial.aeval id

@[simp]
theorem presentationHom_X (a : A) : presentationHom k A (X a) = a :=
  MvPolynomial.aeval_X _ a

theorem presentationHom_surjective : Function.Surjective (presentationHom k A) :=
  fun a => ⟨X a, presentationHom_X k A a⟩

/-- Forms on `A` are the quotient of forms on the canonical presentation by its differential ideal.

Blueprint: `lem:dr-presentation`. -/
noncomputable abbrev presentationEquiv :
    (Forms k (MvPolynomial A k) ⧸
      (differentialIdeal k (RingHom.ker (presentationHom k A))).restrictScalars k) ≃ₗ[k]
      Forms k A :=
  quotientEquiv (presentationHom_surjective k A)

/-- The operator descended from `d` on the canonical presentation is the differential of `A`. This
is how the blueprint defines the differential, so the blueprint's differential is `d`, which does
not depend on a presentation.

Blueprint: `lem:dr-presentation` and `def:dr-complex`. -/
theorem presentationEquiv_dQuotient
    (x : Forms k (MvPolynomial A k) ⧸
      (differentialIdeal k (RingHom.ker (presentationHom k A))).restrictScalars k) :
    presentationEquiv k A (dQuotient _ x) = d k (presentationEquiv k A x) :=
  quotientEquiv_dQuotient (presentationHom_surjective k A) x

end Presentation

end OrlikSolomon.DeRham
