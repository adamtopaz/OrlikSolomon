module

public import OrlikSolomon.DeRham.Exterior.BaseChange
public import OrlikSolomon.DeRham.Exterior.Contraction
public import OrlikSolomon.DeRham.Exterior.Quotient

import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!
# Exterior powers: base change, quotients and contraction

This is the module to import for exterior algebra over an arbitrary commutative ring, with no
division by two. It imports `DeRham/Exterior/Basic`, `DeRham/Exterior/Contraction`,
`DeRham/Exterior/BaseChange` and `DeRham/Exterior/Quotient`, whose headers list their results, and
it proves what combines a change of rings with a quotient.

## Summary of the blueprint

Blueprint `lem:dr-exterior`:

* base change: `OrlikSolomon.DeRham.isBaseChange_powerMap` and
  `OrlikSolomon.DeRham.powerBaseChangeEquiv`;
* quotients: `OrlikSolomon.DeRham.ker_exteriorPower_map` and
  `OrlikSolomon.DeRham.powerQuotientEquiv`;
* spanning, squares and signs: `OrlikSolomon.DeRham.span_word_ι_length`,
  `OrlikSolomon.DeRham.mul_self_eq_zero_of_mem_exteriorPower_one` and
  `OrlikSolomon.DeRham.mul_comm_of_mem_exteriorPower`.

Blueprint `lem:dr-contraction`: `OrlikSolomon.DeRham.exteriorContraction`,
`OrlikSolomon.DeRham.exteriorContraction_ιMulti`,
`OrlikSolomon.DeRham.exteriorContraction_mul_of_mem_exteriorPower`,
`OrlikSolomon.DeRham.exteriorContraction_ι_mul_add` and `OrlikSolomon.DeRham.ker_wedgeLeft_succ`.

## Main results of this file

For a surjection of rings `A → S` with kernel `I`, and a surjective `A`-linear map `g : M → M'` to
an `S`-module:

* `OrlikSolomon.DeRham.ker_exteriorMap`: the kernel of `⋀_A M → ⋀_S M'` is `I ⋀ M + (ker g) ⋀ M`.
* `OrlikSolomon.DeRham.ker_powerMap`: the kernel of `⋀_A^n M → ⋀_S^n M'` is
  `I ⋀^n M + (ker g) ∧ ⋀^(n-1) M`.
* `OrlikSolomon.DeRham.ker_powerMap_of_ker_eq`: if `ker g = I M + N'`, this kernel is
  `I ⋀^n M + N' ∧ ⋀^(n-1) M`, the form of the denominators of `lem:dr-presentation` and
  `lem:dr-quotient`. Follow it with `wedgeSubmodule_span` to write it in terms of generators of
  `N'`.
* `OrlikSolomon.DeRham.powerMap_surjective`: this map is surjective.

As in the blueprint, the proof reduces to the two identifications: it passes through `S ⊗_A M`,
using base change for `⋀ M → ⋀_S (S ⊗_A M)` and the quotient formula over `S` for `S ⊗_A M → M'`.
-/

@[expose] public section

open scoped TensorProduct

namespace OrlikSolomon.DeRham

open ExteriorAlgebra (ι ιMulti)

variable {A : Type*} [CommRing A] {M : Type*} [AddCommGroup M] [Module A M]

variable (S : Type*) [CommRing S] [Algebra A S]
  {M' : Type*} [AddCommGroup M'] [Module A M'] [Module S M'] [IsScalarTower A S M']

/-- If `1 ⊗ y` vanishes in `S ⊗_A X` for a surjection `A → S`, then `y` is divisible by its kernel.
-/
private theorem mem_smul_top_of_one_tmul_eq_zero (hS : Function.Surjective (algebraMap A S))
    {X : Type*} [AddCommGroup X] [Module A X] {y : X} (h : (1 : S) ⊗ₜ[A] y = 0) :
    y ∈ RingHom.ker (algebraMap A S) • (⊤ : Submodule A X) := by
  have hexact : Function.Exact (RingHom.ker (algebraMap A S)).subtype (Algebra.linearMap A S) := by
    intro a
    simp [RingHom.mem_ker]
  have hr := rTensor_exact X hexact hS
  obtain ⟨t, ht⟩ := (hr ((1 : A) ⊗ₜ y)).1 (by simpa using h)
  have key : ∀ t : RingHom.ker (algebraMap A S) ⊗[A] X,
      TensorProduct.lid A X ((RingHom.ker (algebraMap A S)).subtype.rTensor X t) ∈
        RingHom.ker (algebraMap A S) • (⊤ : Submodule A X) := fun t => by
    induction t using TensorProduct.inductionOn with
    | tmul i x => simpa using Submodule.smul_mem_smul i.2 Submodule.mem_top
    | add a b ha hb =>
      rw [map_add, map_add]
      exact add_mem ha hb
  simpa [ht] using key t

/-- The kernel of `⋀_A M → ⋀_S M'` for surjections `A → S` and `g : M → M'` is generated by the
kernel `I` of `A → S` and by `ker g`.

Blueprint: `lem:dr-exterior`, in total degree, combining base change and quotients. -/
theorem ker_exteriorMap {g : M →ₗ[A] M'} (hS : Function.Surjective (algebraMap A S))
    (hg : Function.Surjective g) :
    LinearMap.ker (exteriorMap S g).toLinearMap =
      RingHom.ker (algebraMap A S) • ⊤ ⊔ wedgeIdeal (LinearMap.ker g) := by
  apply le_antisymm
  · intro x hx
    rw [LinearMap.mem_ker] at hx
    let g' : S ⊗[A] M →ₗ[S] M' := g.liftBaseChange S
    have hg' : Function.Surjective g' := fun y => by
      obtain ⟨m, rfl⟩ := hg y
      exact ⟨1 ⊗ₜ m, by simp [g']⟩
    let φ := exteriorMap S (TensorProduct.mk A S M 1)
    have hφ : ∀ u, ExteriorAlgebra.map g' (φ u) = exteriorMap S g u := fun u => by
      induction u using ExteriorAlgebra.induction with
      | algebraMap a => simp [φ]
      | ι m => simp [φ, g']
      | mul a b ha hb => simp only [map_mul, ha, hb]
      | add a b ha hb => simp only [map_add, ha, hb]
    have hmk : Function.Surjective (TensorProduct.mk A S M 1) := fun t => by
      induction t using TensorProduct.inductionOn with
      | tmul s m =>
        obtain ⟨a, rfl⟩ := hS s
        refine ⟨a • m, ?_⟩
        simp [TensorProduct.smul_tmul', Algebra.smul_def]
      | add a b ha hb =>
        obtain ⟨a, rfl⟩ := ha
        obtain ⟨b, rfl⟩ := hb
        exact ⟨a + b, map_add _ a b⟩
    have hφsurj : Function.Surjective φ := exteriorMap_surjective S hS hmk
    have hker : φ x ∈ wedgeIdeal (LinearMap.ker g') := by
      rw [← ker_exteriorAlgebra_map hg', LinearMap.mem_ker]
      exact (hφ x).trans hx
    have hlift : ∀ u ∈ wedgeIdeal (LinearMap.ker g'), ∃ w ∈ wedgeIdeal (LinearMap.ker g),
        φ w = u := fun u hu => by
      induction hu using wedgeIdeal_induction with
      | mul k hk y =>
        obtain ⟨m, rfl⟩ := hmk k
        obtain ⟨z, rfl⟩ := hφsurj y
        have hm : m ∈ LinearMap.ker g := by simpa [g'] using hk
        exact ⟨ι A m * z, ι_mul_mem_wedgeIdeal hm z, by simp [φ]⟩
      | add a _ b _ ha hb =>
        obtain ⟨a', ha', rfl⟩ := ha
        obtain ⟨b', hb', rfl⟩ := hb
        exact ⟨a' + b', add_mem ha' hb', map_add _ _ _⟩
    obtain ⟨w, hw, hwx⟩ := hlift _ hker
    have hzero : (1 : S) ⊗ₜ[A] (x - w) = 0 := by
      apply (ExteriorAlgebra.baseChangeEquiv A M S).injective
      rw [baseChangeEquiv_one_tmul, map_zero, map_sub, sub_eq_zero]
      exact hwx.symm
    have hsum := mem_smul_top_of_one_tmul_eq_zero S hS hzero
    have hx' : x = (x - w) + w := by abel
    rw [hx']
    exact add_mem (Submodule.mem_sup_left hsum) (Submodule.mem_sup_right hw)
  · refine sup_le ?_ ?_
    · rw [Submodule.smul_le]
      intro i hi x _
      rw [LinearMap.mem_ker]
      change exteriorMap S g (i • x) = 0
      rw [map_smul, ← algebraMap_smul S i, (RingHom.mem_ker).1 hi, zero_smul]
    · intro x hx
      rw [LinearMap.mem_ker]
      induction hx using wedgeIdeal_induction with
      | mul n hn y => simp [LinearMap.mem_ker.1 hn]
      | add a _ b _ ha hb =>
        change exteriorMap S g (a + b) = 0
        rw [map_add]
        exact (congrArg₂ (· + ·) ha hb).trans (add_zero 0)

/-- If the ring map and the module map are surjective then so is `powerMap`. -/
theorem powerMap_surjective {g : M →ₗ[A] M'} (hS : Function.Surjective (algebraMap A S))
    (hg : Function.Surjective g) (n : ℕ) : Function.Surjective (powerMap S g n) := by
  intro y
  have hy : y ∈ Submodule.span S (Set.range (exteriorPower.ιMulti S n)) := by
    rw [exteriorPower.ιMulti_span]
    exact Submodule.mem_top
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, rfl⟩ := hy
    obtain ⟨m, rfl⟩ : ∃ m : Fin n → M, g ∘ m = a :=
      ⟨fun i => (hg (a i)).choose, funext fun i => (hg (a i)).choose_spec⟩
    exact ⟨exteriorPower.ιMulti A n m, powerMap_ιMulti S g m⟩
  | zero => exact ⟨0, map_zero _⟩
  | add a b _ _ ha hb =>
    obtain ⟨a, rfl⟩ := ha
    obtain ⟨b, rfl⟩ := hb
    exact ⟨a + b, map_add _ a b⟩
  | smul s a _ ha =>
    obtain ⟨a, rfl⟩ := ha
    obtain ⟨c, rfl⟩ := hS s
    exact ⟨c • a, by rw [map_smul, algebraMap_smul]⟩

/-- The kernel of `⋀_A^n M → ⋀_S^n M'` for surjections `A → S` and `g : M → M'` with `I` the kernel
of `A → S`: it is `I ⋀^n M + (ker g) ∧ ⋀^(n-1) M`. The first term matters only in degree zero.

Blueprint: `lem:dr-exterior`, combining base change and quotients. -/
theorem ker_powerMap {g : M →ₗ[A] M'} (hS : Function.Surjective (algebraMap A S))
    (hg : Function.Surjective g) (n : ℕ) :
    LinearMap.ker (powerMap S g n) =
      RingHom.ker (algebraMap A S) • ⊤ ⊔ wedgeSubmodule (LinearMap.ker g) n := by
  apply le_antisymm
  · intro x hx
    have hx' : (x : ExteriorAlgebra A M) ∈ LinearMap.ker (exteriorMap S g).toLinearMap :=
      congrArg Subtype.val (LinearMap.mem_ker.1 hx)
    rw [ker_exteriorMap S hS hg] at hx'
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 hx'
    have h : x = exteriorProj n a + exteriorProj n b := by
      rw [← map_add, hab, exteriorProj_coe]
    have ha' : exteriorProj n a ∈ RingHom.ker (algebraMap A S) • (⊤ : Submodule A (⋀[A]^n M)) := by
      have := Submodule.mem_map_of_mem (f := exteriorProj n) ha
      rw [Submodule.map_smul''] at this
      exact Submodule.smul_mono le_rfl le_top this
    rw [h]
    exact add_mem (Submodule.mem_sup_left ha')
      (Submodule.mem_sup_right (exteriorProj_mem_wedgeSubmodule hb n))
  · have hker := ker_exteriorMap S hS hg
    intro x hx
    rw [LinearMap.mem_ker]
    refine Subtype.ext ?_
    rw [coe_powerMap]
    have hmem : (x : ExteriorAlgebra A M) ∈ LinearMap.ker (exteriorMap S g).toLinearMap := by
      rw [hker]
      obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hx
      refine add_mem ?_ (Submodule.mem_sup_right hb)
      refine Submodule.mem_sup_left ?_
      have := Submodule.mem_map_of_mem (f := (⋀[A]^n M).subtype) ha
      rw [Submodule.map_smul''] at this
      exact Submodule.smul_mono le_rfl le_top this
    exact LinearMap.mem_ker.1 hmem

/-- The form of `ker_powerMap` used for presentations: if `ker g = I M + N'` with `I` the kernel of
`A → S`, then the kernel of `⋀_A^n M → ⋀_S^n M'` is `I ⋀^n M + N' ∧ ⋀^(n-1) M`.

With `wedgeSubmodule_span`, this is the form of the denominators in `lem:dr-presentation` and
`lem:dr-quotient`.

Blueprint: `lem:dr-exterior`, combining base change and quotients. -/
theorem ker_powerMap_of_ker_eq {g : M →ₗ[A] M'} (hS : Function.Surjective (algebraMap A S))
    (hg : Function.Surjective g) {N' : Submodule A M}
    (hN : LinearMap.ker g = RingHom.ker (algebraMap A S) • ⊤ ⊔ N') (n : ℕ) :
    LinearMap.ker (powerMap S g n) =
      RingHom.ker (algebraMap A S) • ⊤ ⊔ wedgeSubmodule N' n := by
  rw [ker_powerMap S hS hg, hN]
  cases n with
  | zero => simp
  | succ n => rw [wedgeSubmodule_sup, wedgeSubmodule_smul_top, ← sup_assoc, sup_idem]

end OrlikSolomon.DeRham
