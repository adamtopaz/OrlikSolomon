module

public import OrlikSolomon.DeRham.Complex

/-!
# Forms on a principal quotient

Let `φ : A → S` be a surjection of `k`-algebras whose kernel is generated by one element `f`, so
that this file applies to certified pairs and not only to `A ⧸ (f)`. Forms on `S` are the quotient
of forms on `A` by `f Ω_A^n + df ∧ Ω_A^(n-1)`, compatibly with `d`, and the conormal sequence
`(f)/(f²) → S ⊗_A Ω_A^1 → Ω_S^1 → 0` is right exact. No injectivity on the left is claimed, and
nothing here needs smoothness. The element `f` may be a unit, so that `S` is the zero ring, it may
be zero, and `A` may be the zero ring.

This is the case of a principal ideal of `lem:dr-presentation`, whose differential ideal is
`differentialIdeal k (Ideal.span {f})`.

## Main definitions

* `OrlikSolomon.DeRham.principalQuotientPowerEquiv`: the identification
  `Ω_A^n / (f Ω_A^n + df ∧ Ω_A^(n-1)) ≃ Ω_S^n`.
* `OrlikSolomon.DeRham.principalConormalMap`: the map `(f)/(f²) → S ⊗_A Ω_A^1`.

## Main results

Blueprint `lem:dr-quotient`:

* `OrlikSolomon.DeRham.Forms.mapPower_surjective`: the restriction maps are surjective in each
  degree. This is in `DeRham/Complex/Presentation`.
* `OrlikSolomon.DeRham.differentialIdealPower_span_singleton_zero` and
  `OrlikSolomon.DeRham.differentialIdealPower_span_singleton_succ`: the denominator, which is
  `f Ω_A^0` in degree zero and `f Ω_A^(n+1) + df ∧ Ω_A^n` in degree `n + 1`.
* `OrlikSolomon.DeRham.Forms.mapPower_zero_eq_zero_iff_of_ker_eq_span_singleton`,
  `OrlikSolomon.DeRham.Forms.mapPower_succ_eq_zero_iff_of_ker_eq_span_singleton` and
  `OrlikSolomon.DeRham.Forms.map_eq_zero_iff_of_ker_eq_span_singleton`: the same denominator, as the
  kernel of restriction, in terms of elements.
* `OrlikSolomon.DeRham.principalQuotientPowerEquiv_mk` and
  `OrlikSolomon.DeRham.principalQuotientPowerEquiv_smul`: the identification sends the class of `x`
  to its restriction, and it is semilinear.
* `OrlikSolomon.DeRham.Forms.mapPower_powerD` and
  `OrlikSolomon.DeRham.principalQuotientPowerEquiv_mk_powerD`: restriction commutes with `d`. The
  former is in `DeRham/Complex/Functoriality`.
  `OrlikSolomon.DeRham.powerD_mem_differentialIdealPower` says that `d` preserves the denominators.
* `OrlikSolomon.DeRham.principalConormalMap_self`,
  `OrlikSolomon.DeRham.exact_principalConormalMap` and Mathlib's
  `KaehlerDifferential.mapBaseChange_surjective`: the right exact conormal sequence.
  `OrlikSolomon.DeRham.range_principalConormalMap` says that its image is `S df`.
* `OrlikSolomon.DeRham.ker_kaehlerMap_of_ker_eq_span_singleton` and
  `OrlikSolomon.DeRham.ker_mapBaseChange_of_ker_eq_span_singleton`: the kernels of
  `Ω_A^1 → Ω_S^1` and of `S ⊗_A Ω_A^1 → Ω_S^1`.
-/

@[expose] public section

open scoped TensorProduct

namespace OrlikSolomon.DeRham

open KaehlerDifferential (D)

variable {k : Type*} [CommRing k] {A : Type*} [CommRing A] [Algebra k A] {S : Type*} [CommRing S]

/-! ### The denominator -/

section Denominator

variable (k) (f : A)

/-- The differential ideal of `(f)` is `f Ω^• + df ∧ Ω^•`, in terms of elements.

Blueprint: `lem:dr-quotient`, in total degree. -/
theorem mem_differentialIdeal_span_singleton {x : Forms k A} :
    x ∈ differentialIdeal k (Ideal.span {f}) ↔ ∃ y z, f • y + diff k f * z = x := by
  rw [differentialIdeal_span, Set.image_singleton, Submodule.mem_sup,
    Submodule.ideal_span_singleton_smul]
  constructor
  · rintro ⟨_, hy, _, hz, rfl⟩
    obtain ⟨y, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hy
    obtain ⟨z, rfl⟩ := mem_wedgeIdeal_span_singleton.1 hz
    exact ⟨y, z, rfl⟩
  · rintro ⟨y, z, rfl⟩
    exact ⟨f • y, Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top, diff k f * z,
      mem_wedgeIdeal_span_singleton.2 ⟨z, rfl⟩, rfl⟩

/-- In degree zero, the denominator of `lem:dr-quotient` is `f Ω_A^0`.

Blueprint: `lem:dr-quotient`. -/
theorem differentialIdealPower_span_singleton_zero :
    differentialIdealPower k (Ideal.span {f}) 0 = Ideal.span {f} • ⊤ :=
  differentialIdealPower_zero _

/-- In degree `n + 1`, the denominator of `lem:dr-quotient` is `f Ω_A^(n+1) + df ∧ Ω_A^n`.

Blueprint: `lem:dr-quotient`. -/
theorem differentialIdealPower_span_singleton_succ (n : ℕ) :
    differentialIdealPower k (Ideal.span {f}) (n + 1) =
      Ideal.span {f} • ⊤ ⊔ LinearMap.range (wedgeLeft (D k A f) n) := by
  rw [differentialIdealPower_span, Set.image_singleton, wedgeSubmodule_span]
  congr 1
  simp only [Set.mem_singleton_iff, exists_eq_left]
  exact Submodule.span_eq (LinearMap.range (wedgeLeft (D k A f) n))

/-- The denominator in degree zero, in terms of elements.

Blueprint: `lem:dr-quotient`. -/
theorem mem_differentialIdealPower_span_singleton_zero {x : ⋀[A]^0 Ω[A⁄k]} :
    x ∈ differentialIdealPower k (Ideal.span {f}) 0 ↔ ∃ y, f • y = x := by
  rw [differentialIdealPower_span_singleton_zero, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists]
  simp

/-- The denominator in degree `n + 1`, in terms of elements.

Blueprint: `lem:dr-quotient`. -/
theorem mem_differentialIdealPower_span_singleton_succ {n : ℕ} {x : ⋀[A]^(n + 1) Ω[A⁄k]} :
    x ∈ differentialIdealPower k (Ideal.span {f}) (n + 1) ↔
      ∃ y z, f • y + wedgeLeft (D k A f) n z = x := by
  rw [differentialIdealPower_span_singleton_succ, Submodule.mem_sup,
    Submodule.ideal_span_singleton_smul]
  constructor
  · rintro ⟨_, hy, _, ⟨z, rfl⟩, rfl⟩
    obtain ⟨y, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hy
    exact ⟨y, z, rfl⟩
  · rintro ⟨y, z, rfl⟩
    exact ⟨f • y, Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top, _, ⟨z, rfl⟩, rfl⟩

end Denominator

/-! ### The kernel of restriction -/

namespace Forms

variable [Algebra k S] {φ : A →ₐ[k] S} {f : A}

/-- A form on `A` restricts to zero on `S` exactly when it is `f y + df ∧ z`.

Blueprint: `lem:dr-quotient`, in total degree. -/
theorem map_eq_zero_iff_of_ker_eq_span_singleton (hφ : Function.Surjective φ)
    (hker : RingHom.ker φ = Ideal.span {f}) {x : Forms k A} :
    map φ x = 0 ↔ ∃ y z, f • y + diff k f * z = x := by
  rw [map_eq_zero_iff_of_surjective hφ, hker, mem_differentialIdeal_span_singleton]

/-- A function on `A`, regarded as a form of degree zero, restricts to zero exactly when it is
`f y`.

Blueprint: `lem:dr-quotient`. -/
theorem mapPower_zero_eq_zero_iff_of_ker_eq_span_singleton (hφ : Function.Surjective φ)
    (hker : RingHom.ker φ = Ideal.span {f}) {x : ⋀[A]^0 Ω[A⁄k]} :
    mapPower φ 0 x = 0 ↔ ∃ y, f • y = x := by
  rw [mapPower_eq_zero_iff_of_surjective hφ, hker, mem_differentialIdealPower_span_singleton_zero]

/-- A form of degree `n + 1` on `A` restricts to zero exactly when it is `f y + df ∧ z`, with `y` of
degree `n + 1` and `z` of degree `n`.

Blueprint: `lem:dr-quotient`. -/
theorem mapPower_succ_eq_zero_iff_of_ker_eq_span_singleton (hφ : Function.Surjective φ)
    (hker : RingHom.ker φ = Ideal.span {f}) {n : ℕ} {x : ⋀[A]^(n + 1) Ω[A⁄k]} :
    mapPower φ (n + 1) x = 0 ↔ ∃ y z, f • y + wedgeLeft (D k A f) n z = x := by
  rw [mapPower_eq_zero_iff_of_surjective hφ, hker, mem_differentialIdealPower_span_singleton_succ]

end Forms

/-! ### The identification -/

section Identification

variable [Algebra k S] {φ : A →ₐ[k] S} (hφ : Function.Surjective φ) {f : A}
  (hker : RingHom.ker φ = Ideal.span {f})

/-- The identification `Ω_A^n / (f Ω_A^n + df ∧ Ω_A^(n-1)) ≃ Ω_S^n` for a surjection `φ : A → S`
with kernel `(f)`. It sends the class of a form to its restriction. It is `k`-linear, and it is
semilinear over `φ`, by `principalQuotientPowerEquiv_smul`. The denominator is
`differentialIdealPower_span_singleton_zero` and `differentialIdealPower_span_singleton_succ`.

Blueprint: `lem:dr-quotient`. -/
noncomputable def principalQuotientPowerEquiv (n : ℕ) :
    (⋀[A]^n Ω[A⁄k] ⧸ differentialIdealPower k (Ideal.span {f}) n) ≃ₗ[k] ⋀[S]^n Ω[S⁄k] :=
  (Submodule.Quotient.restrictScalarsEquiv k _).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ (by rw [hker]) ≪≫ₗ quotientPowerEquiv hφ n

/-- The identification sends the class of a form to its restriction.

Blueprint: `lem:dr-quotient`. -/
@[simp]
theorem principalQuotientPowerEquiv_mk (n : ℕ) (x : ⋀[A]^n Ω[A⁄k]) :
    principalQuotientPowerEquiv hφ hker n (Submodule.Quotient.mk x) = Forms.mapPower φ n x :=
  rfl

/-- The identification is semilinear over `φ`.

Blueprint: `lem:dr-quotient`. -/
@[simp]
theorem principalQuotientPowerEquiv_smul (n : ℕ) (a : A)
    (q : ⋀[A]^n Ω[A⁄k] ⧸ differentialIdealPower k (Ideal.span {f}) n) :
    principalQuotientPowerEquiv hφ hker n (a • q) =
      φ a • principalQuotientPowerEquiv hφ hker n q := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  rw [← Submodule.Quotient.mk_smul, principalQuotientPowerEquiv_mk, principalQuotientPowerEquiv_mk,
    Forms.mapPower_smul]

@[simp]
theorem principalQuotientPowerEquiv_symm_mapPower (n : ℕ) (x : ⋀[A]^n Ω[A⁄k]) :
    (principalQuotientPowerEquiv hφ hker n).symm (Forms.mapPower φ n x) =
      Submodule.Quotient.mk x := by
  rw [LinearEquiv.symm_apply_eq, principalQuotientPowerEquiv_mk]

/-- The differential preserves the degree `n` parts of a differential ideal. So `d` descends to the
quotients of `lem:dr-presentation` and `lem:dr-quotient`. -/
theorem powerD_mem_differentialIdealPower {I : Ideal A} {n : ℕ} {x : ⋀[A]^n Ω[A⁄k]}
    (hx : x ∈ differentialIdealPower k I n) :
    powerD k A n x ∈ differentialIdealPower k I (n + 1) := by
  rw [mem_differentialIdealPower_iff] at hx ⊢
  rw [coe_powerD]
  exact d_mem_differentialIdeal hx

/-- The identification commutes with `d`. This is `Forms.mapPower_powerD`, written for the
identification.

Blueprint: `lem:dr-quotient`. -/
theorem principalQuotientPowerEquiv_mk_powerD (n : ℕ) (x : ⋀[A]^n Ω[A⁄k]) :
    principalQuotientPowerEquiv hφ hker (n + 1) (Submodule.Quotient.mk (powerD k A n x)) =
      powerD k S n (principalQuotientPowerEquiv hφ hker n (Submodule.Quotient.mk x)) :=
  Forms.mapPower_powerD φ n x

end Identification

/-! ### The conormal sequence -/

section Conormal

variable (k) {f : A} (S) [Algebra A S]

/-- The kernel of `Ω_A^1 → Ω_S^1` is `f Ω_A^1 + A df` for a surjection `A → S` with kernel `(f)`.
This is the blueprint's description of the differential module of `S` as
`(Ω_A^1 / f Ω_A^1) / (S df)`.

Blueprint: `lem:dr-quotient`. -/
theorem ker_kaehlerMap_of_ker_eq_span_singleton [Algebra k S] [IsScalarTower k A S]
    (hS : Function.Surjective (algebraMap A S))
    (hker : RingHom.ker (algebraMap A S) = Ideal.span {f}) :
    LinearMap.ker (KaehlerDifferential.map k k A S) =
      Ideal.span {f} • ⊤ ⊔ Submodule.span A {D k A f} := by
  rw [ker_kaehlerMap_of_surjective k S hS, hker]
  refine le_antisymm (sup_le le_sup_left ?_) (sup_le_sup_left (Submodule.span_mono ?_) _)
  · rw [Submodule.span_le]
    rintro _ ⟨c, hc, rfl⟩
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hc
    rw [Derivation.leibniz]
    exact add_mem
      (Submodule.mem_sup_right (Submodule.smul_mem _ a (Submodule.mem_span_singleton_self _)))
      (Submodule.mem_sup_left
        (Submodule.smul_mem_smul (Ideal.mem_span_singleton_self f) Submodule.mem_top))
  · rw [Set.singleton_subset_iff]
    exact ⟨f, Ideal.mem_span_singleton_self f, rfl⟩

/-- The map `(f)/(f²) → S ⊗_A Ω_A^1`, sending the class of `a` to `1 ⊗ da`. Mathlib's
`KaehlerDifferential.kerCotangentToTensor` is the same map with the kernel of `A → S` as its source,
which is equal to `(f)` for a surjection with that kernel, but only propositionally.

It is defined whenever `f` maps to zero. For the sequence of `exact_principalConormalMap`, `(f)` is
the whole kernel. No injectivity is claimed, and there is none in general.

Blueprint: `lem:dr-quotient`. -/
noncomputable def principalConormalMap (hf : algebraMap A S f = 0) :
    (Ideal.span {f}).Cotangent →ₗ[A] S ⊗[A] Ω[A⁄k] :=
  KaehlerDifferential.kerCotangentToTensor k A S ∘ₗ
    Ideal.mapCotangent (Ideal.span {f}) (RingHom.ker (algebraMap A S)) (AlgHom.id A A)
      ((Ideal.span_singleton_le_iff_mem _).2 (RingHom.mem_ker.2 hf))

/-- The map sends the class of `a` to `1 ⊗ da`.

Blueprint: `lem:dr-quotient`. -/
@[simp]
theorem principalConormalMap_toCotangent (hf : algebraMap A S f = 0) (x : Ideal.span {f}) :
    principalConormalMap k S hf ((Ideal.span {f}).toCotangent x) = 1 ⊗ₜ D k A (x : A) :=
  rfl

/-- The map sends `f mod f²` to `df mod f`.

Blueprint: `lem:dr-quotient`. -/
theorem principalConormalMap_self (hf : algebraMap A S f = 0) :
    principalConormalMap k S hf
        ((Ideal.span {f}).toCotangent ⟨f, Ideal.mem_span_singleton_self f⟩) =
      1 ⊗ₜ D k A f :=
  rfl

/-- The sequence `(f)/(f²) → S ⊗_A Ω_A^1 → Ω_S^1` is exact, for a surjection `A → S` with kernel
`(f)`. Mathlib's `KaehlerDifferential.mapBaseChange_surjective` is exactness at `Ω_S^1`. So this is
the right exact conormal sequence.

Blueprint: `lem:dr-quotient`. -/
theorem exact_principalConormalMap [Algebra k S] [IsScalarTower k A S]
    (hS : Function.Surjective (algebraMap A S))
    (hker : RingHom.ker (algebraMap A S) = Ideal.span {f}) (hf : algebraMap A S f = 0) :
    Function.Exact (principalConormalMap k S hf) (KaehlerDifferential.mapBaseChange k A S) := by
  intro y
  constructor
  · intro hy
    obtain ⟨z, rfl⟩ :=
      (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k A S hS y).1 hy
    obtain ⟨c, rfl⟩ := Ideal.toCotangent_surjective _ z
    exact ⟨(Ideal.span {f}).toCotangent ⟨c, hker ▸ c.2⟩, rfl⟩
  · rintro ⟨z, rfl⟩
    obtain ⟨c, rfl⟩ := Ideal.toCotangent_surjective _ z
    rw [principalConormalMap_toCotangent, KaehlerDifferential.mapBaseChange_tmul,
      KaehlerDifferential.map_D, RingHom.mem_ker.1 (hker.ge c.2), map_zero, smul_zero]

/-- In `S ⊗_A Ω_A^1`, the form `d(a f)` is `a df`, since `f` maps to zero in `S`. -/
theorem one_tmul_D_mul_self (hf : algebraMap A S f = 0) (a : A) :
    (1 : S) ⊗ₜ[A] D k A (a * f) = algebraMap A S a • ((1 : S) ⊗ₜ[A] D k A f) := by
  rw [Derivation.leibniz, TensorProduct.tmul_add, TensorProduct.tmul_smul, TensorProduct.tmul_smul,
    ← algebraMap_smul S a, ← algebraMap_smul S f, hf, zero_smul, add_zero]

/-- The image of the conormal map is `S df`.

Blueprint: `lem:dr-quotient`. -/
theorem range_principalConormalMap (hS : Function.Surjective (algebraMap A S))
    (hf : algebraMap A S f = 0) :
    LinearMap.range (principalConormalMap k S hf) =
      (Submodule.span S {(1 : S) ⊗ₜ[A] D k A f}).restrictScalars A := by
  apply le_antisymm
  · rintro _ ⟨z, rfl⟩
    obtain ⟨⟨c, hc⟩, rfl⟩ := Ideal.toCotangent_surjective _ z
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hc
    rw [principalConormalMap_toCotangent, one_tmul_D_mul_self k S hf,
      Submodule.restrictScalars_mem]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
  · intro y hy
    obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.1 ((Submodule.restrictScalars_mem _ _ _).1 hy)
    obtain ⟨a, rfl⟩ := hS s
    refine ⟨(Ideal.span {f}).toCotangent
      ⟨a * f, Ideal.mul_mem_left _ a (Ideal.mem_span_singleton_self f)⟩, ?_⟩
    rw [principalConormalMap_toCotangent, one_tmul_D_mul_self k S hf]

/-- The kernel of `S ⊗_A Ω_A^1 → Ω_S^1` is `S df`, for a surjection `A → S` with kernel `(f)`.

Blueprint: `lem:dr-quotient`. -/
theorem ker_mapBaseChange_of_ker_eq_span_singleton [Algebra k S] [IsScalarTower k A S]
    (hS : Function.Surjective (algebraMap A S))
    (hker : RingHom.ker (algebraMap A S) = Ideal.span {f}) :
    LinearMap.ker (KaehlerDifferential.mapBaseChange k A S) =
      Submodule.span S {(1 : S) ⊗ₜ[A] D k A f} := by
  have hf : algebraMap A S f = 0 := RingHom.mem_ker.1 (hker.ge (Ideal.mem_span_singleton_self f))
  ext y
  rw [LinearMap.mem_ker, exact_principalConormalMap k S hS hker hf y, ← LinearMap.coe_range,
    range_principalConormalMap k S hS hf, Submodule.coe_restrictScalars, SetLike.mem_coe]

end Conormal

end OrlikSolomon.DeRham
