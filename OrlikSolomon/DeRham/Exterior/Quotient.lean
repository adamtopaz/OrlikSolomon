module

public import OrlikSolomon.DeRham.Exterior.Basic

/-!
# Exterior powers of a quotient module

For a submodule `N` of `M`, the kernel of `⋀ M → ⋀ (M ⧸ N)` is the two-sided ideal generated by `N`,
and its degree `n` part is the submodule `N ∧ ⋀^(n-1) M` of `⋀^n M`. This is the quotient formula of
`lem:dr-exterior`, over any commutative ring.

We invert the natural surjection by letting `⋀ (M ⧸ N)` act on the quotient of `⋀ M` by the ideal:
the action of `m` is left multiplication by `m`, and it depends only on the class of `m`. The value
of this action on `1` is the inverse, and it is the blueprint's argument, that changing a lift by an
element of `N` does not change the wedge in the quotient.

## Main definitions

* `OrlikSolomon.DeRham.wedgeIdeal N`: the two-sided ideal of `⋀ M` generated by `N`, as a submodule.
* `OrlikSolomon.DeRham.wedgeSubmodule N n`: its degree `n` part, a submodule of `⋀^n M`.
* `OrlikSolomon.DeRham.powerQuotientEquiv N n`: the equivalence
  `⋀^n M ⧸ (N ∧ ⋀^(n-1) M) ≃ ⋀^n (M ⧸ N)`.

## Main results

Blueprint `lem:dr-exterior`:

* `OrlikSolomon.DeRham.ker_exteriorAlgebra_map_mkQ` and
  `OrlikSolomon.DeRham.ker_exteriorAlgebra_map`: the kernel on the total exterior algebra.
* `OrlikSolomon.DeRham.ker_exteriorPower_map`: the kernel in degree `n`.
* `OrlikSolomon.DeRham.wedgeSubmodule_zero`, `OrlikSolomon.DeRham.map_wedgeSubmodule_succ` and
  `OrlikSolomon.DeRham.wedgeSubmodule_span`: the submodule is zero in degree zero, and in degree
  `n + 1` it is spanned by the wedges `m ∧ y` with `y` in `⋀^n M`.
-/

@[expose] public section

namespace OrlikSolomon.DeRham

open ExteriorAlgebra (ι ιMulti)

variable {A : Type*} [CommRing A] {M : Type*} [AddCommGroup M] [Module A M]

/-- The two-sided ideal of `⋀ M` generated by a submodule `N` of `M`, as a submodule. It is the
kernel of `⋀ M → ⋀ (M ⧸ N)`, by `ker_exteriorAlgebra_map_mkQ`. -/
def wedgeIdeal (N : Submodule A M) : Submodule A (ExteriorAlgebra A M) :=
  N.map (ι A) * ⊤

variable {N N₁ N₂ : Submodule A M}

theorem ι_mul_mem_wedgeIdeal {n : M} (hn : n ∈ N) (y : ExteriorAlgebra A M) :
    ι A n * y ∈ wedgeIdeal N :=
  Submodule.mul_mem_mul (Submodule.mem_map_of_mem hn) Submodule.mem_top

/-- Induction over `wedgeIdeal N`: it suffices to treat `n ∧ y` for `n ∈ N`, and sums. -/
@[elab_as_elim]
theorem wedgeIdeal_induction {p : (x : ExteriorAlgebra A M) → x ∈ wedgeIdeal N → Prop}
    (mul : ∀ (n : M) (hn : n ∈ N) (y), p (ι A n * y) (ι_mul_mem_wedgeIdeal hn y))
    (add : ∀ x hx y hy, p x hx → p y hy → p (x + y) (add_mem hx hy))
    {x : ExteriorAlgebra A M} (hx : x ∈ wedgeIdeal N) : p x hx := by
  refine Submodule.mul_induction_on' ?_ add hx
  rintro _ ⟨n, hn, rfl⟩ y -
  exact mul n hn y

theorem mul_mem_wedgeIdeal_right (y : ExteriorAlgebra A M) {x : ExteriorAlgebra A M}
    (hx : x ∈ wedgeIdeal N) : x * y ∈ wedgeIdeal N := by
  induction hx using wedgeIdeal_induction with
  | mul n hn z =>
    rw [mul_assoc]
    exact ι_mul_mem_wedgeIdeal hn _
  | add a _ b _ ha hb =>
    rw [add_mul]
    exact add_mem ha hb

/-- `wedgeIdeal N` is stable under left multiplication, because letters anticommute. -/
theorem mul_mem_wedgeIdeal_left (y : ExteriorAlgebra A M) {x : ExteriorAlgebra A M}
    (hx : x ∈ wedgeIdeal N) : y * x ∈ wedgeIdeal N := by
  induction y using ExteriorAlgebra.induction generalizing x with
  | algebraMap a =>
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem _ a hx
  | ι m =>
    induction hx using wedgeIdeal_induction with
    | mul n hn z =>
      have h : ι A m * ι A n = -(ι A n * ι A m) :=
        eq_neg_of_add_eq_zero_left (ExteriorAlgebra.ι_add_mul_swap m n)
      rw [← mul_assoc, h, neg_mul, mul_assoc, ← mul_neg]
      exact ι_mul_mem_wedgeIdeal hn _
    | add a _ b _ ha hb =>
      rw [mul_add]
      exact add_mem ha hb
  | mul a b ha hb =>
    rw [mul_assoc]
    exact ha (hb hx)
  | add a b ha hb =>
    rw [add_mul]
    exact add_mem (ha hx) (hb hx)

theorem wedgeIdeal_mono (h : N₁ ≤ N₂) : wedgeIdeal N₁ ≤ wedgeIdeal N₂ := by
  refine Submodule.mul_le.2 ?_
  rintro _ ⟨m, hm, rfl⟩ y -
  exact ι_mul_mem_wedgeIdeal (h hm) y

theorem wedgeIdeal_sup : wedgeIdeal (N₁ ⊔ N₂) = wedgeIdeal N₁ ⊔ wedgeIdeal N₂ := by
  rw [wedgeIdeal, Submodule.map_sup, Submodule.sup_mul]
  rfl

/-- Left multiplication by `m` on the quotient of `⋀ M` by `wedgeIdeal N`. -/
private noncomputable def wedgeMul (N : Submodule A M) (m : M) :
    Module.End A (ExteriorAlgebra A M ⧸ wedgeIdeal N) :=
  (wedgeIdeal N).mapQ (wedgeIdeal N) (LinearMap.mulLeft A (ι A m)) fun _ hx =>
    mul_mem_wedgeIdeal_left _ hx

/-- The action of `M` on the quotient of `⋀ M` by `wedgeIdeal N`. -/
private noncomputable def wedgeAction (N : Submodule A M) :
    M →ₗ[A] Module.End A (ExteriorAlgebra A M ⧸ wedgeIdeal N) where
  toFun := wedgeMul N
  map_add' m₁ m₂ := Submodule.linearMap_qext _ (LinearMap.ext fun x => by
    change (wedgeIdeal N).mkQ (ι A (m₁ + m₂) * x) =
      (wedgeIdeal N).mkQ (ι A m₁ * x) + (wedgeIdeal N).mkQ (ι A m₂ * x)
    rw [map_add, add_mul, map_add])
  map_smul' a m := Submodule.linearMap_qext _ (LinearMap.ext fun x => by
    change (wedgeIdeal N).mkQ (ι A (a • m) * x) = a • (wedgeIdeal N).mkQ (ι A m * x)
    rw [map_smul, smul_mul_assoc, map_smul])

/-- The action of `M` on the quotient of `⋀ M` by `wedgeIdeal N` factors through `M ⧸ N`. -/
private noncomputable def wedgeQuotientAction (N : Submodule A M) :
    (M ⧸ N) →ₗ[A] Module.End A (ExteriorAlgebra A M ⧸ wedgeIdeal N) :=
  N.liftQ (wedgeAction N) fun n hn => by
    refine LinearMap.mem_ker.2 (Submodule.linearMap_qext _ (LinearMap.ext fun x => ?_))
    change (wedgeIdeal N).mkQ (ι A n * x) = 0
    simpa using ι_mul_mem_wedgeIdeal hn x

/-- The algebra map `⋀ (M ⧸ N) → End (⋀ M ⧸ wedgeIdeal N)`. Its value on `1` is the inverse of the
natural surjection, which is how the blueprint's "changing a lift" argument appears here. -/
private noncomputable def wedgeQuotientLift (N : Submodule A M) :
    ExteriorAlgebra A (M ⧸ N) →ₐ[A] Module.End A (ExteriorAlgebra A M ⧸ wedgeIdeal N) :=
  ExteriorAlgebra.lift A ⟨wedgeQuotientAction N, fun m => by
    obtain ⟨m, rfl⟩ := N.mkQ_surjective m
    refine Submodule.linearMap_qext _ (LinearMap.ext fun x => ?_)
    change (wedgeIdeal N).mkQ (ι A m * (ι A m * x)) = 0
    simp [← mul_assoc]⟩

private theorem wedgeQuotientLift_map_mkQ (N : Submodule A M) (x y : ExteriorAlgebra A M) :
    wedgeQuotientLift N (ExteriorAlgebra.map N.mkQ x) ((wedgeIdeal N).mkQ y) =
      (wedgeIdeal N).mkQ (x * y) := by
  induction x using ExteriorAlgebra.induction generalizing y with
  | algebraMap a =>
    simp [Algebra.algebraMap_eq_smul_one]
  | ι m =>
    rw [ExteriorAlgebra.map_apply_ι, wedgeQuotientLift, ExteriorAlgebra.lift_ι_apply]
    rfl
  | mul a b ha hb =>
    rw [map_mul, map_mul, mul_apply_eq_comp, hb, ha, mul_assoc]
  | add a b ha hb =>
    rw [map_add, map_add, LinearMap.add_apply, ha, hb, add_mul, map_add]

/-- The kernel of `⋀ M → ⋀ (M ⧸ N)` is the two-sided ideal generated by `N`.

Blueprint: `lem:dr-exterior`, in total degree. -/
theorem ker_exteriorAlgebra_map_mkQ (N : Submodule A M) :
    LinearMap.ker (ExteriorAlgebra.map N.mkQ).toLinearMap = wedgeIdeal N := by
  apply le_antisymm
  · intro x hx
    have hx' : ExteriorAlgebra.map N.mkQ x = 0 := hx
    have h := wedgeQuotientLift_map_mkQ N x 1
    rw [hx', map_zero, LinearMap.zero_apply, mul_one, eq_comm, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero] at h
    exact h
  · intro x hx
    change ExteriorAlgebra.map N.mkQ x = 0
    induction hx using wedgeIdeal_induction with
    | mul n hn y => simp [(Submodule.Quotient.mk_eq_zero N).2 hn]
    | add a _ b _ ha hb => rw [map_add, ha, hb, add_zero]

variable {M' : Type*} [AddCommGroup M'] [Module A M']

/-- The kernel of `⋀ M → ⋀ M'` for a surjective linear map `g : M → M'` is the two-sided ideal
generated by `ker g`.

Blueprint: `lem:dr-exterior`, in total degree. -/
theorem ker_exteriorAlgebra_map {g : M →ₗ[A] M'} (hg : Function.Surjective g) :
    LinearMap.ker (ExteriorAlgebra.map g).toLinearMap = wedgeIdeal (LinearMap.ker g) := by
  have hcomp : (g.quotKerEquivOfSurjective hg).toLinearMap ∘ₗ (LinearMap.ker g).mkQ = g := by
    refine LinearMap.ext fun m => ?_
    simp
  have h (x : ExteriorAlgebra A M) : ExteriorAlgebra.map g x =
      exteriorCongr (g.quotKerEquivOfSurjective hg)
        (ExteriorAlgebra.map (LinearMap.ker g).mkQ x) := by
    rw [exteriorCongr_apply, ← AlgHom.comp_apply, ExteriorAlgebra.map_comp_map, hcomp]
  rw [← ker_exteriorAlgebra_map_mkQ]
  refine Submodule.ext fun x => ?_
  change ExteriorAlgebra.map g x = 0 ↔ ExteriorAlgebra.map (LinearMap.ker g).mkQ x = 0
  rw [h, EmbeddingLike.map_eq_zero_iff]

/-- The submodule `N ∧ ⋀^(n-1) M` of `⋀^n M`, the degree `n` part of `wedgeIdeal N`. For `n = 0` it
is zero, by `wedgeSubmodule_zero`, and `map_wedgeSubmodule_succ` and `wedgeSubmodule_span` describe
it for `n + 1` by the blueprint's wedges.

Blueprint: the denominator in `lem:dr-exterior`. -/
def wedgeSubmodule (N : Submodule A M) (n : ℕ) : Submodule A (⋀[A]^n M) :=
  (wedgeIdeal N).comap (⋀[A]^n M).subtype

@[simp]
theorem mem_wedgeSubmodule {n : ℕ} {x : ⋀[A]^n M} :
    x ∈ wedgeSubmodule N n ↔ (x : ExteriorAlgebra A M) ∈ wedgeIdeal N :=
  Iff.rfl

theorem exteriorProj_mem_wedgeSubmodule {x : ExteriorAlgebra A M} (hx : x ∈ wedgeIdeal N)
    (n : ℕ) : exteriorProj n x ∈ wedgeSubmodule N n := by
  induction hx using wedgeIdeal_induction with
  | mul m hm y =>
    cases n with
    | zero => simp
    | succ n =>
      rw [exteriorProj_ι_mul, mem_wedgeSubmodule, coe_wedgeLeft]
      exact ι_mul_mem_wedgeIdeal hm _
  | add a _ b _ ha hb =>
    rw [map_add]
    exact add_mem ha hb

/-- In exterior degree zero the wedge submodule vanishes.

Blueprint: `lem:dr-exterior`, whose convention is that negative degrees are zero. -/
@[simp]
theorem wedgeSubmodule_zero (N : Submodule A M) : wedgeSubmodule N 0 = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  have key : ∀ y ∈ wedgeIdeal N, exteriorProj 0 y = 0 := fun y hy => by
    induction hy using wedgeIdeal_induction with
    | mul n _ z => simp
    | add a _ b _ ha hb => rw [map_add, ha, hb, add_zero]
  have h := key _ (mem_wedgeSubmodule.1 hx)
  rw [exteriorProj_coe] at h
  simp [h]

theorem wedgeLeft_mem_wedgeSubmodule {m : M} (hm : m ∈ N) (n : ℕ) (y : ⋀[A]^n M) :
    wedgeLeft m n y ∈ wedgeSubmodule N (n + 1) :=
  ι_mul_mem_wedgeIdeal hm _

/-- `wedgeSubmodule N (n + 1)` is the smallest submodule of `⋀^(n+1) M` that contains the wedges
`m ∧ y` with `m ∈ N` and `y ∈ ⋀^n M`. This says that it is `N ∧ ⋀^n M`. -/
theorem wedgeSubmodule_succ_le {n : ℕ} {Q : Submodule A (⋀[A]^(n + 1) M)}
    (h : ∀ m ∈ N, ∀ y : ⋀[A]^n M, wedgeLeft m n y ∈ Q) : wedgeSubmodule N (n + 1) ≤ Q := by
  have key : ∀ u ∈ wedgeIdeal N, exteriorProj (n + 1) u ∈ Q := fun u hu => by
    induction hu using wedgeIdeal_induction with
    | mul m hm y =>
      rw [exteriorProj_ι_mul]
      exact h m hm _
    | add a _ b _ ha hb =>
      rw [map_add]
      exact add_mem ha hb
  intro x hx
  simpa using key _ (mem_wedgeSubmodule.1 hx)

/-- The degree `n + 1` part of `wedgeIdeal (span s)` is spanned by the wedges `m ∧ y` with `m ∈ s`
and `y ∈ ⋀^n M`.

Blueprint: the denominator in `lem:dr-exterior` and the span in `lem:dr-presentation`. -/
theorem wedgeSubmodule_span (s : Set M) (n : ℕ) :
    wedgeSubmodule (Submodule.span A s) (n + 1) =
      Submodule.span A {x | ∃ m ∈ s, ∃ y : ⋀[A]^n M, wedgeLeft m n y = x} := by
  apply le_antisymm
  · refine wedgeSubmodule_succ_le fun m hm y => ?_
    induction hm using Submodule.span_induction with
    | mem m hm => exact Submodule.subset_span ⟨m, hm, y, rfl⟩
    | zero =>
      rw [wedgeLeft_zero]
      exact zero_mem _
    | add a b _ _ ha hb =>
      rw [wedgeLeft_add]
      exact add_mem ha hb
    | smul c a _ ha =>
      rw [wedgeLeft_smul]
      exact Submodule.smul_mem _ c ha
  · rw [Submodule.span_le]
    rintro _ ⟨m, hm, y, rfl⟩
    exact wedgeLeft_mem_wedgeSubmodule (Submodule.subset_span hm) n y

/-- The degree `n + 1` part of `wedgeIdeal N` is `N ∧ ⋀^n M`, as a product of submodules of `⋀ M`.

Blueprint: the denominator in `lem:dr-exterior`. -/
theorem map_wedgeSubmodule_succ (N : Submodule A M) (n : ℕ) :
    (wedgeSubmodule N (n + 1)).map (⋀[A]^(n + 1) M).subtype = N.map (ι A) * ⋀[A]^n M := by
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap]
    refine wedgeSubmodule_succ_le fun m hm y => ?_
    exact Submodule.mul_mem_mul (Submodule.mem_map_of_mem hm) y.2
  · rw [Submodule.mul_le]
    rintro _ ⟨m, hm, rfl⟩ y hy
    exact ⟨_, wedgeLeft_mem_wedgeSubmodule hm n ⟨y, hy⟩, rfl⟩

theorem wedgeSubmodule_sup (N₁ N₂ : Submodule A M) (n : ℕ) :
    wedgeSubmodule (N₁ ⊔ N₂) n = wedgeSubmodule N₁ n ⊔ wedgeSubmodule N₂ n := by
  apply le_antisymm
  · intro x hx
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1
      (wedgeIdeal_sup (N₁ := N₁) (N₂ := N₂) ▸ mem_wedgeSubmodule.1 hx)
    have h : x = exteriorProj n a + exteriorProj n b := by
      rw [← map_add, hab, exteriorProj_coe]
    rw [h]
    exact add_mem (Submodule.mem_sup_left (exteriorProj_mem_wedgeSubmodule ha n))
      (Submodule.mem_sup_right (exteriorProj_mem_wedgeSubmodule hb n))
  · exact sup_le (Submodule.comap_mono (wedgeIdeal_mono le_sup_left))
      (Submodule.comap_mono (wedgeIdeal_mono le_sup_right))

/-- In positive degree, wedging with `I M` is the same as multiplying by `I`. In degree zero this
fails, since `wedgeSubmodule` vanishes there. -/
theorem wedgeSubmodule_smul_top (I : Ideal A) (n : ℕ) :
    wedgeSubmodule (I • ⊤ : Submodule A M) (n + 1) = I • ⊤ := by
  apply le_antisymm
  · refine wedgeSubmodule_succ_le fun m hm y => ?_
    induction hm using Submodule.smul_induction_on' with
    | smul i hi m _ =>
      rw [wedgeLeft_smul]
      exact Submodule.smul_mem_smul hi Submodule.mem_top
    | add a _ b _ ha hb =>
      rw [wedgeLeft_add]
      exact add_mem ha hb
  · rw [Submodule.smul_le]
    rintro i hi ⟨x, hx⟩ -
    rw [mem_wedgeSubmodule]
    change i • x ∈ _
    induction hx using exteriorPower_induction with
    | zero => simp
    | add a b _ _ ha hb =>
      rw [smul_add]
      exact add_mem ha hb
    | smul c a _ ha =>
      rw [smul_comm]
      exact Submodule.smul_mem _ c ha
    | word l hl =>
      match l, hl with
      | m :: l, _ =>
        rw [word_cons, ← smul_mul_assoc, ← map_smul]
        exact ι_mul_mem_wedgeIdeal (Submodule.smul_mem_smul hi Submodule.mem_top) _

/-- The kernel of `⋀^n M → ⋀^n M'` for a surjective linear map `g : M → M'` is
`ker g ∧ ⋀^(n-1) M`.

Blueprint: `lem:dr-exterior`. -/
theorem ker_exteriorPower_map {g : M →ₗ[A] M'} (hg : Function.Surjective g) (n : ℕ) :
    LinearMap.ker (exteriorPower.map n g) = wedgeSubmodule (LinearMap.ker g) n := by
  ext x
  rw [mem_wedgeSubmodule, ← ker_exteriorAlgebra_map hg, LinearMap.mem_ker, LinearMap.mem_ker,
    ← Subtype.coe_inj, exteriorPower.coe_map]
  rfl

theorem ker_exteriorPower_map_mkQ (N : Submodule A M) (n : ℕ) :
    LinearMap.ker (exteriorPower.map n N.mkQ) = wedgeSubmodule N n := by
  rw [ker_exteriorPower_map N.mkQ_surjective, N.ker_mkQ]

/-- The quotient formula `⋀^n M ⧸ (N ∧ ⋀^(n-1) M) ≃ ⋀^n (M ⧸ N)`. It sends the class of
`m₁ ∧ ⋯ ∧ mₙ` to the wedge of the classes of the `mᵢ`.

Blueprint: `lem:dr-exterior`. -/
noncomputable def powerQuotientEquiv (N : Submodule A M) (n : ℕ) :
    (⋀[A]^n M ⧸ wedgeSubmodule N n) ≃ₗ[A] ⋀[A]^n (M ⧸ N) :=
  (Submodule.quotEquivOfEq _ _ (ker_exteriorPower_map_mkQ N n).symm).trans
    ((exteriorPower.map n N.mkQ).quotKerEquivOfSurjective
      (exteriorPower.map_surjective N.mkQ_surjective))

@[simp]
theorem powerQuotientEquiv_mk (N : Submodule A M) (n : ℕ) (x : ⋀[A]^n M) :
    powerQuotientEquiv N n (Submodule.Quotient.mk x) = exteriorPower.map n N.mkQ x :=
  rfl

end OrlikSolomon.DeRham
