module

public import Mathlib.Algebra.RingQuot
public import OrlikSolomon.Presentation.ProjectiveAlgebra

/-!
# The explicit Orlik–Solomon presentation

This module connects the Mathlib-only presentation of the main theorem to the library's
central Orlik–Solomon algebra. The presentation is generic in an index type and a dependence
predicate on lists. Its definitions have the same bodies as the approved interface skeleton.

The comparison reindexes generators by an equivalence with a central arrangement. It identifies
the projective subalgebras generated by differences, and their weighted bigrading pieces.
Coefficients may have characteristic two or be the zero ring.

## Main definitions and results

* `OrlikSolomonAlgebra` and `projectiveOrlikSolomonAlgebra`: the explicit presentations.
* `osAlgebraEquiv` and `projectiveAlgebraEquiv`: the central-algebra comparisons.
* `map_orlikSolomonGrading` and `image_projectiveOrlikSolomonGrading`: identification of every
  weighted grading piece, with the latter in the set-image form of the main theorem.

Blueprint: `def:os`, `lem:os-basic`, `lem:projective-algebra`; milestone M7, issue #142.
-/

@[expose] public section

noncomputable section

universe u v w

namespace OrlikSolomon.Interface

variable (B : Type w) [CommRing B] (ι : Type v)

/-- A basis generator of the exterior algebra on the index type. -/
def exteriorGenerator (i : ι) : ExteriorAlgebra B (ι →₀ B) :=
  ExteriorAlgebra.ι B (Finsupp.single i 1)

/-- The exterior word of a list, with the empty word equal to one. -/
def exteriorWord (S : List ι) : ExteriorAlgebra B (ι →₀ B) :=
  (S.map (exteriorGenerator B ι)).prod

/-- The signed boundary, with positions counted from zero. -/
def exteriorWordBoundary (S : List ι) : ExteriorAlgebra B (ι →₀ B) :=
  ∑ j : Fin S.length, (-1 : ℤ) ^ (j : ℕ) • exteriorWord B ι (S.eraseIdx j)

variable (Dep : List ι → Prop)

/-- The relation killing boundaries of dependent lists without repetitions. -/
def orlikSolomonRel (a b : ExteriorAlgebra B (ι →₀ B)) : Prop :=
  b = 0 ∧ ∃ S : List ι, S.Nodup ∧ Dep S ∧ a = exteriorWordBoundary B ι S

/-- The explicit presentation by the dependent-list boundary relations. -/
abbrev OrlikSolomonAlgebra := RingQuot (orlikSolomonRel B ι Dep)

/-- A generator in the explicit quotient. -/
def generator (i : ι) : OrlikSolomonAlgebra B ι Dep :=
  RingQuot.mkAlgHom B (orlikSolomonRel B ι Dep) (exteriorGenerator B ι i)

/-- A word in the quotient generators. -/
def word (S : List ι) : OrlikSolomonAlgebra B ι Dep :=
  (S.map (generator B ι Dep)).prod

/-- The subalgebra generated by all differences of generators. -/
def projectiveOrlikSolomonAlgebra : Subalgebra B (OrlikSolomonAlgebra B ι Dep) :=
  Algebra.adjoin B (Set.range fun ij : ι × ι ↦ generator B ι Dep ij.1 - generator B ι Dep ij.2)

/-- A difference of generators, as a projective class. -/
def projectiveGenerator (i j : ι) : projectiveOrlikSolomonAlgebra B ι Dep :=
  ⟨generator B ι Dep i - generator B ι Dep j, Algebra.subset_adjoin ⟨(i, j), rfl⟩⟩

/-- A projective generator has the prescribed difference as its underlying quotient element. -/
@[simp] theorem coe_projectiveGenerator (i j : ι) :
    (projectiveGenerator B ι Dep i j : OrlikSolomonAlgebra B ι Dep) =
      generator B ι Dep i - generator B ι Dep j := rfl

variable {R : Type*} [CommRing R] [Algebra R B] (ℬ : ℤ → Submodule R B)

/-- The explicit word-span piece of bidegree `(p,w)`. -/
def orlikSolomonGrading (i : ℤ × ℤ) : Submodule R (OrlikSolomonAlgebra B ι Dep) :=
  Submodule.span R {x | ∃ (S : List ι) (b : B), (S.length : ℤ) = i.1 ∧ b ∈ ℬ (i.2 - i.1) ∧
    x = algebraMap B (OrlikSolomonAlgebra B ι Dep) b * word B ι Dep S}

/-- The word-span piece restricted to the projective subalgebra. -/
def projectiveOrlikSolomonGrading (i : ℤ × ℤ) :
    Submodule R (projectiveOrlikSolomonAlgebra B ι Dep) :=
  (orlikSolomonGrading B ι Dep ℬ i).comap
    ((projectiveOrlikSolomonAlgebra B ι Dep).val.toLinearMap.restrictScalars R)

/-- The explicit exterior generator is the library's basis generator. -/
theorem exteriorGenerator_eq_exteriorGen (i : ι) :
    exteriorGenerator B ι i = exteriorGen B i := rfl

/-- The explicit exterior word uses the library's order convention. -/
theorem exteriorWord_eq_word (S : List ι) :
    exteriorWord B ι S = OrlikSolomon.word (exteriorGen B) S := rfl

/-- The zero-based alternating-sum boundary equals the library's recursive boundary. -/
theorem exteriorWordBoundary_eq_wordBoundary (S : List ι) :
    exteriorWordBoundary B ι S = wordBoundary (exteriorGen B) S := by
  rw [wordBoundary_eq_sum]
  apply Finset.sum_congr rfl
  intro j _
  congr 1

/-- The quotient generators satisfy the exterior square-zero and anticommutation relations. -/
theorem isExteriorFamily_generator : IsExteriorFamily (generator B ι Dep) :=
  (isExteriorFamily_exteriorGen B).map (RingQuot.mkAlgHom B (orlikSolomonRel B ι Dep))

/-- A dependent list without repetitions has zero boundary in the explicit presentation. -/
theorem wordBoundary_generator_eq_zero (S : List ι) (hS : S.Nodup) (hDep : Dep S) :
    wordBoundary (generator B ι Dep) S = 0 := by
  have h := RingQuot.mkAlgHom_rel B
    (s := orlikSolomonRel B ι Dep) ⟨rfl, S, hS, hDep, rfl⟩
  rw [exteriorWordBoundary_eq_wordBoundary, map_wordBoundary, map_zero] at h
  exact h

/-- Algebra maps out of the explicit quotient agree when they agree on its generators. -/
@[ext 1101] theorem algHom_ext {T : Type*} [Ring T] [Algebra B T]
    {f g : OrlikSolomonAlgebra B ι Dep →ₐ[B] T}
    (h : ∀ i, f (generator B ι Dep i) = g (generator B ι Dep i)) : f = g := by
  apply RingQuot.ringQuot_ext'
  exact exteriorAlgHom_ext h

section Comparison

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V]
  {𝒞 : Arrangement k V} (σ : ι ≃ 𝒞)
  (hDep : ∀ S : List ι, S.Nodup → (Dep S ↔ Arrangement.IsDependent (S.map σ)))

/-- The map from the explicit quotient to the arrangement presentation, reindexing generators.
Only the forward implication of dependence compatibility is needed for descent. -/
def toOSAlgebra : OrlikSolomonAlgebra B ι Dep →ₐ[B] OSAlgebra B 𝒞 :=
  RingQuot.liftAlgHom B
    ⟨exteriorLift B ⟨fun i ↦ OSAlgebra.generator B 𝒞 (σ i),
      (OSAlgebra.isExteriorFamily_generator B 𝒞).comp σ⟩, by
      rintro a b ⟨rfl, S, hS, hD, rfl⟩
      rw [map_zero, exteriorWordBoundary_eq_wordBoundary, map_wordBoundary]
      simp only [exteriorLift_exteriorGen]
      simpa only [wordBoundary_map] using
        OSAlgebra.wordBoundary_eq_zero_of_isDependent B 𝒞 ((hDep S hS).1 hD)⟩

/-- The forward comparison sends each generator to its reindexed arrangement generator. -/
@[simp] theorem toOSAlgebra_generator (i : ι) :
    toOSAlgebra B ι Dep σ hDep (generator B ι Dep i) = OSAlgebra.generator B 𝒞 (σ i) := by
  simp only [toOSAlgebra, generator, RingQuot.liftAlgHom_mkAlgHom_apply,
    exteriorGenerator_eq_exteriorGen, exteriorLift_exteriorGen]

/-- Centrality removes the empty-intersection relations, giving the reverse comparison. -/
def fromOSAlgebra (h𝒞 : 𝒞.IsCentral) : OSAlgebra B 𝒞 →ₐ[B] OrlikSolomonAlgebra B ι Dep :=
  OSAlgebra.lift (fun H ↦ generator B ι Dep (σ.symm H))
    { toIsExteriorFamily := (isExteriorFamily_generator B ι Dep).comp σ.symm
      word_eq_zero := fun S _ h ↦ False.elim (h𝒞.inter_ne_bot S h)
      wordBoundary_eq_zero := fun S hS hD ↦ by
        have hD' : Dep (S.map σ.symm) := (hDep _ (hS.map σ.symm.injective)).2 (by
          simpa only [List.map_map, Function.comp_def, Equiv.apply_symm_apply,
            List.map_id'] using hD)
        simpa only [wordBoundary_map] using
          wordBoundary_generator_eq_zero B ι Dep _ (hS.map σ.symm.injective) hD' }

/-- The reverse comparison sends each arrangement generator to its corresponding index. -/
@[simp] theorem fromOSAlgebra_generator (h𝒞 : 𝒞.IsCentral) (H : 𝒞) :
    fromOSAlgebra B ι Dep σ hDep h𝒞 (OSAlgebra.generator B 𝒞 H) =
      generator B ι Dep (σ.symm H) := OSAlgebra.lift_generator _ _ _

/-- The explicit dependent-boundary presentation is the library's central Orlik–Solomon algebra. -/
def osAlgebraEquiv (h𝒞 : 𝒞.IsCentral) : OrlikSolomonAlgebra B ι Dep ≃ₐ[B] OSAlgebra B 𝒞 :=
  AlgEquiv.ofAlgHom (toOSAlgebra B ι Dep σ hDep) (fromOSAlgebra B ι Dep σ hDep h𝒞)
    (by apply OSAlgebra.algHom_ext; intro H; simp)
    (by apply algHom_ext; intro i; simp)

/-- The algebra equivalence sends generators to their reindexed library generators. -/
@[simp] theorem osAlgebraEquiv_generator (h𝒞 : 𝒞.IsCentral) (i : ι) :
    osAlgebraEquiv B ι Dep σ hDep h𝒞 (generator B ι Dep i) =
      OSAlgebra.generator B 𝒞 (σ i) := toOSAlgebra_generator B ι Dep σ hDep i

/-- The inverse equivalence sends a library generator to its inverse reindexing. -/
@[simp] theorem osAlgebraEquiv_symm_generator (h𝒞 : 𝒞.IsCentral) (H : 𝒞) :
    (osAlgebraEquiv B ι Dep σ hDep h𝒞).symm (OSAlgebra.generator B 𝒞 H) =
      generator B ι Dep (σ.symm H) := fromOSAlgebra_generator B ι Dep σ hDep h𝒞 H

/-- The forward comparison preserves words in their given order. -/
@[simp] theorem osAlgebraEquiv_word (h𝒞 : 𝒞.IsCentral) (S : List ι) :
    osAlgebraEquiv B ι Dep σ hDep h𝒞 (word B ι Dep S) =
      OrlikSolomon.word (OSAlgebra.generator B 𝒞) (S.map σ) := by
  change osAlgebraEquiv B ι Dep σ hDep h𝒞 (OrlikSolomon.word (generator B ι Dep) S) = _
  simp only [map_word, word_map, osAlgebraEquiv_generator]

/-- The inverse comparison preserves words and their order. -/
theorem osAlgebraEquiv_symm_word (h𝒞 : 𝒞.IsCentral) (S : List 𝒞) :
    (osAlgebraEquiv B ι Dep σ hDep h𝒞).symm
        (OrlikSolomon.word (OSAlgebra.generator B 𝒞) S) = word B ι Dep (S.map σ.symm) := by
  change _ = OrlikSolomon.word (generator B ι Dep) (S.map σ.symm)
  simp only [map_word, word_map, osAlgebraEquiv_symm_generator]

/-- The comparison preserves the signed boundary, including its zero-based sign convention. -/
theorem osAlgebraEquiv_wordBoundary (h𝒞 : 𝒞.IsCentral) (S : List ι) :
    osAlgebraEquiv B ι Dep σ hDep h𝒞 (wordBoundary (generator B ι Dep) S) =
      wordBoundary (OSAlgebra.generator B 𝒞) (S.map σ) := by
  simp only [map_wordBoundary, wordBoundary_map, osAlgebraEquiv_generator]

private theorem bigrading_eq_wordSpan (𝒞 : Arrangement k V) (i : ℤ × ℤ) :
    OSAlgebra.bigrading 𝒞 ℬ i = Submodule.span R
      {x | ∃ (S : List 𝒞) (b : B), (S.length : ℤ) = i.1 ∧ b ∈ ℬ (i.2 - i.1) ∧
        x = algebraMap B (OSAlgebra B 𝒞) b * OrlikSolomon.word (OSAlgebra.generator B 𝒞) S} := by
  rcases i with ⟨p, w⟩
  by_cases hp : 0 ≤ p
  · lift p to ℕ using hp
    rw [OSAlgebra.bigrading_eq_span]
    congr 1
    ext x
    constructor
    · rintro ⟨b, hb, S, hS, rfl⟩
      exact ⟨S, b, by change (S.length : ℤ) = (p : ℤ); exact_mod_cast hS,
        hb, Algebra.smul_def b _⟩
    · rintro ⟨S, b, hS, hb, rfl⟩
      exact ⟨b, hb, S, by change (S.length : ℤ) = (p : ℤ) at hS; exact_mod_cast hS,
        (Algebra.smul_def b _).symm⟩
  · rw [OSAlgebra.bigrading_eq_bot_of_fst_neg 𝒞 ℬ (lt_of_not_ge hp)]
    symm
    rw [Submodule.span_eq_bot]
    rintro x ⟨S, b, hS, _, _⟩
    omega

/-- The explicit affine word spans are exactly the library's bigrading pieces, in every
integer cohomological degree. This identification needs no assumption on the coefficient
weight family beyond being a family of submodules. -/
theorem map_orlikSolomonGrading (h𝒞 : 𝒞.IsCentral) (i : ℤ × ℤ) :
    (orlikSolomonGrading B ι Dep ℬ i).map
        ((osAlgebraEquiv B ι Dep σ hDep h𝒞).toLinearMap.restrictScalars R) =
      OSAlgebra.bigrading 𝒞 ℬ i := by
  rw [orlikSolomonGrading, Submodule.map_span, bigrading_eq_wordSpan B ℬ 𝒞 i]
  congr 1
  ext x
  constructor
  · rintro ⟨a, ⟨S, b, hS, hb, rfl⟩, rfl⟩
    refine ⟨S.map σ, b, ?_, hb, ?_⟩
    · simpa only [List.length_map] using hS
    · change osAlgebraEquiv B ι Dep σ hDep h𝒞
        (algebraMap B _ b * word B ι Dep S) = _
      rw [map_mul, AlgEquiv.commutes, osAlgebraEquiv_word]
  · rintro ⟨S, b, hS, hb, rfl⟩
    refine ⟨algebraMap B _ b * word B ι Dep (S.map σ.symm),
      ⟨S.map σ.symm, b, ?_, hb, rfl⟩, ?_⟩
    · simpa only [List.length_map] using hS
    · change osAlgebraEquiv B ι Dep σ hDep h𝒞
        (algebraMap B _ b * word B ι Dep (S.map σ.symm)) = _
      rw [map_mul, AlgEquiv.commutes, osAlgebraEquiv_word]
      simp only [List.map_map, Function.comp_def, Equiv.apply_symm_apply, List.map_id']

/-- Membership in the explicit affine grading is preserved and reflected by comparison. -/
@[simp] theorem osAlgebraEquiv_mem_bigrading_iff (h𝒞 : 𝒞.IsCentral) (i : ℤ × ℤ)
    (x : OrlikSolomonAlgebra B ι Dep) :
    osAlgebraEquiv B ι Dep σ hDep h𝒞 x ∈ OSAlgebra.bigrading 𝒞 ℬ i ↔
      x ∈ orlikSolomonGrading B ι Dep ℬ i := by
  rw [← map_orlikSolomonGrading B ι Dep ℬ σ hDep h𝒞 i, Submodule.mem_map]
  exact ⟨fun ⟨y, hy, he⟩ ↦ (osAlgebraEquiv B ι Dep σ hDep h𝒞).injective he ▸ hy,
    fun hx ↦ ⟨x, hx, rfl⟩⟩

variable [Nonempty ι]

/-- The equivalence carries all differences onto the boundary kernel of the central algebra.
Nonemptiness is used only to invoke the library's difference-generation theorem. -/
theorem map_projectiveOrlikSolomonAlgebra (h𝒞 : 𝒞.IsCentral) :
    (projectiveOrlikSolomonAlgebra B ι Dep).map
        (osAlgebraEquiv B ι Dep σ hDep h𝒞).toAlgHom = OSAlgebra.projectiveAlgebra B h𝒞 := by
  classical
  apply le_antisymm
  · rw [projectiveOrlikSolomonAlgebra, ← Algebra.adjoin_image]
    apply Algebra.adjoin_le
    rintro _ ⟨_, ⟨⟨i, j⟩, rfl⟩, rfl⟩
    change osAlgebraEquiv B ι Dep σ hDep h𝒞
      (generator B ι Dep i - generator B ι Dep j) ∈ _
    rw [map_sub, osAlgebraEquiv_generator, osAlgebraEquiv_generator]
    exact OSAlgebra.generator_sub_generator_mem_projectiveAlgebra B h𝒞 (σ i) (σ j)
  · obtain ⟨i₀⟩ := ‹Nonempty ι›
    rw [OSAlgebra.projectiveAlgebra_eq_adjoin B h𝒞 (σ i₀)]
    apply Algebra.adjoin_le
    rintro _ ⟨H, rfl⟩
    refine ⟨generator B ι Dep (σ.symm H) - generator B ι Dep i₀,
      Algebra.subset_adjoin ⟨(σ.symm H, i₀), rfl⟩, ?_⟩
    change osAlgebraEquiv B ι Dep σ hDep h𝒞
      (generator B ι Dep (σ.symm H) - generator B ι Dep i₀) = _
    simp only [map_sub, osAlgebraEquiv_generator, Equiv.apply_symm_apply]

/-- The explicit projective algebra is the library's projective boundary kernel. -/
def projectiveAlgebraEquiv (h𝒞 : 𝒞.IsCentral) :
    projectiveOrlikSolomonAlgebra B ι Dep ≃ₐ[B] OSAlgebra.projectiveAlgebra B h𝒞 :=
  ((projectiveOrlikSolomonAlgebra B ι Dep).equivMapOfInjective
    (osAlgebraEquiv B ι Dep σ hDep h𝒞).toAlgHom
    (osAlgebraEquiv B ι Dep σ hDep h𝒞).injective).trans
    (Subalgebra.equivOfEq _ _ (map_projectiveOrlikSolomonAlgebra B ι Dep σ hDep h𝒞))

/-- The projective comparison is the restriction of the full algebra comparison. -/
@[simp] theorem coe_projectiveAlgebraEquiv (h𝒞 : 𝒞.IsCentral)
    (x : projectiveOrlikSolomonAlgebra B ι Dep) :
    (projectiveAlgebraEquiv B ι Dep σ hDep h𝒞 x : OSAlgebra B 𝒞) =
      osAlgebraEquiv B ι Dep σ hDep h𝒞 x := rfl

/-- The projective generator formula is independent of any chosen reference index. -/
theorem coe_projectiveAlgebraEquiv_projectiveGenerator (h𝒞 : 𝒞.IsCentral) (i j : ι) :
    (projectiveAlgebraEquiv B ι Dep σ hDep h𝒞 (projectiveGenerator B ι Dep i j) :
      OSAlgebra B 𝒞) = OSAlgebra.generator B 𝒞 (σ i) - OSAlgebra.generator B 𝒞 (σ j) := by
  rw [coe_projectiveAlgebraEquiv]
  change osAlgebraEquiv B ι Dep σ hDep h𝒞
    (generator B ι Dep i - generator B ι Dep j) = _
  simp only [map_sub, osAlgebraEquiv_generator]

/-- Projective comparison preserves and reflects all weighted grading pieces. -/
theorem projectiveAlgebraEquiv_mem_projectiveBigrading_iff (h𝒞 : 𝒞.IsCentral)
    (i : ℤ × ℤ) (x : projectiveOrlikSolomonAlgebra B ι Dep) :
    projectiveAlgebraEquiv B ι Dep σ hDep h𝒞 x ∈ OSAlgebra.projectiveBigrading B ℬ h𝒞 i ↔
      x ∈ projectiveOrlikSolomonGrading B ι Dep ℬ i := by
  change (projectiveAlgebraEquiv B ι Dep σ hDep h𝒞 x : OSAlgebra B 𝒞) ∈
    OSAlgebra.bigrading 𝒞 ℬ i ↔ (x : OrlikSolomonAlgebra B ι Dep) ∈
      orlikSolomonGrading B ι Dep ℬ i
  rw [coe_projectiveAlgebraEquiv, osAlgebraEquiv_mem_bigrading_iff]

/-- The explicit projective pieces map onto, rather than merely into, the library pieces. -/
theorem map_projectiveOrlikSolomonGrading (h𝒞 : 𝒞.IsCentral) (i : ℤ × ℤ) :
    (projectiveOrlikSolomonGrading B ι Dep ℬ i).map
        ((projectiveAlgebraEquiv B ι Dep σ hDep h𝒞).toLinearMap.restrictScalars R) =
      OSAlgebra.projectiveBigrading B ℬ h𝒞 i := by
  ext y
  rw [Submodule.mem_map]
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact (projectiveAlgebraEquiv_mem_projectiveBigrading_iff B ι Dep ℬ σ hDep h𝒞 i x).2 hx
  · intro hy
    refine ⟨(projectiveAlgebraEquiv B ι Dep σ hDep h𝒞).symm y, ?_,
      (projectiveAlgebraEquiv B ι Dep σ hDep h𝒞).apply_symm_apply y⟩
    apply (projectiveAlgebraEquiv_mem_projectiveBigrading_iff B ι Dep ℬ σ hDep h𝒞 i _).1
    simpa only [AlgEquiv.apply_symm_apply] using hy

/-- Set-image form of the projective grading comparison, as used in the main theorem. -/
theorem image_projectiveOrlikSolomonGrading (h𝒞 : 𝒞.IsCentral) (i : ℤ × ℤ) :
    projectiveAlgebraEquiv B ι Dep σ hDep h𝒞 ''
        (projectiveOrlikSolomonGrading B ι Dep ℬ i : Set _) =
      (OSAlgebra.projectiveBigrading B ℬ h𝒞 i : Set _) :=
  congrArg (fun N : Submodule R (OSAlgebra.projectiveAlgebra B h𝒞) ↦
    (N : Set (OSAlgebra.projectiveAlgebra B h𝒞)))
    (map_projectiveOrlikSolomonGrading B ι Dep ℬ σ hDep h𝒞 i)

end Comparison

end OrlikSolomon.Interface
