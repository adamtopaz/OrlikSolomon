module

public import OrlikSolomon.Geometry.Deletion
public import OrlikSolomon.Geometry.Schemes.Complement.Basic
public import OrlikSolomon.Geometry.Schemes.PrincipalPair

/-!
# The geometric deletion pair

This file realizes `thm:geo-deletion` of the geometric refactor blueprint. For a hyperplane `H` of
an arrangement `𝒜`, with deletion `𝒜' = 𝒜 ∖ {H}` and restriction `𝒜''` on `H.direction`, and any
equation `f_H` of `H`, the actual complements form a geometric divisor pair
`(U_𝒜', U_𝒜'', U_𝒜, f̃_H|_{U_𝒜'})` in every admissible domain. Its closed part is the
scheme-theoretic fiber product `U_𝒜' ×_{𝔸_V} 𝐇`, and under the comparisons `s` it is `Spec` of the
existing deletion pair, so its pair of global sections is the existing one.

## Main definitions

* `DivisorPair.ofIso`: transport of a pair along isomorphisms of its three schemes, with a unit
  multiple of the transported equation.
* `Geometric.complementRestriction 𝒜 hH`: the closed immersion `U_𝒜'' → U_𝒜'`.
* `DivisorPair.deletionPair D 𝒜 hH hf`: the deletion pair of `H ∈ 𝒜` and an equation `f` of `H`.
* `DivisorPair.deletionPairIsoSpec`: its isomorphism with `Spec` of the existing deletion pair,
  whose components are the comparisons `s`.
* `DivisorPair.deletionPairIso`: the pairs of two equations of `H` are isomorphic by identities.
* `DivisorPair.globalSectionsDeletionPairIso`: the pair of global sections is the existing deletion
  pair.

## Main results

* `isPullback_complementRestriction`: `U_𝒜'' = U_𝒜' ×_{𝔸_V} 𝐇`, scheme-theoretically.
* `isRegularSection_deletion`, `ker_complementRestriction`,
  `opensRange_complementInclusion_deletion`: `f̃_H` is regular on `U_𝒜'`, `U_𝒜''` is its zero
  scheme and `U_𝒜` its basic open.
* `complementRestriction_appTop`: the restriction of an old function `g̃` to `U_𝒜''` is the function
  of `g ∘ chart H`, and its three cases: an empty trace gives a constant
  (`exists_complementRestriction_appTop_eq_const`), a retained trace gives a constant times any
  equation of it (`exists_complementRestriction_appTop_eq_const_mul`), and two old hyperplanes with
  the same trace give the same function up to a constant
  (`exists_complementRestriction_appTop_eq_const_mul_of_inf_eq`).

## Implementation notes

The certificates are transported from `Spec` of the existing deletion pair along the comparisons
`s`, by `DivisorPair.ofIso`, so the existing ring-level proofs are not repeated. A change of
equation is `deletionPairIso`, whose components are identities, and naturality of a theory's residue
and Gysin maps along it makes them independent of the equation. Nothing refers to a `k`-point.
-/

@[expose] public section

noncomputable section

open CategoryTheory Limits Opposite AlgebraicGeometry

universe u

namespace OrlikSolomon.Geometric

/-! ### Transport of certificates along isomorphisms -/

section Transport

variable {X Z U X' Z' U' : Scheme.{u}} (eX : X ≅ X')

/-- A closed immersion with kernel `f' 𝒪`, transported along isomorphisms, has kernel generated by
any unit multiple of the transported function. -/
theorem isClosedImmersion_and_ker_eq_of_iso (eZ : Z ≅ Z') {i' : Z' ⟶ X'} [IsClosedImmersion i']
    {f' : Γ(X', ⊤)} (hi' : i'.ker = principalIdealSheaf f') {i : Z ⟶ X}
    (hi : i ≫ eX.hom = eZ.hom ≫ i') {f : Γ(X, ⊤)} (hf : Associated (eX.hom.appTop f') f) :
    IsClosedImmersion i ∧ i.ker = principalIdealSheaf f := by
  have hi2 : i = eZ.hom ≫ i' ≫ eX.inv := by
    rw [← reassoc_of% hi, Iso.hom_inv_id, Category.comp_id]
  have : Mono i := by
    rw [hi2]
    infer_instance
  have h0 : i.appTop f = 0 := by
    have h : i.appTop (eX.hom.appTop f') = 0 := by
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, hi, Scheme.Hom.comp_appTop,
        CommRingCat.comp_apply, appTop_eq_zero_of_ker_eq f' hi', map_zero]
    exact zero_dvd_iff.1 (h ▸ map_dvd i.appTop.hom hf.dvd)
  have h1 : (zeroSchemeι f ≫ eX.hom).appTop f' = 0 := by
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    exact zero_dvd_iff.1 (zeroSchemeι_appTop f ▸ map_dvd (zeroSchemeι f).appTop.hom hf.symm.dvd)
  obtain ⟨b, hb⟩ := (exists_comp_eq_iff_of_ker_eq hi' _).2 h1
  exact isClosedImmersion_and_ker_eq_of_mono h0 (a := b ≫ eZ.inv) (by
    rw [hi2, Category.assoc, Iso.inv_hom_id_assoc, reassoc_of% hb, Iso.hom_inv_id,
      Category.comp_id])

/-- An open immersion transported along isomorphisms is an open immersion. -/
theorem isOpenImmersion_of_iso (eU : U ≅ U') {j' : U' ⟶ X'} [IsOpenImmersion j'] {j : U ⟶ X}
    (hj : j ≫ eX.hom = eU.hom ≫ j') : IsOpenImmersion j := by
  rw [show j = eU.hom ≫ j' ≫ eX.inv by rw [← reassoc_of% hj, Iso.hom_inv_id, Category.comp_id]]
  infer_instance

/-- An open immersion onto the basic open of `f'`, transported along isomorphisms, is an open
immersion onto the basic open of any unit multiple of the transported function. -/
theorem opensRange_eq_of_iso (eU : U ≅ U') {j' : U' ⟶ X'} [IsOpenImmersion j']
    {f' : Γ(X', ⊤)} (hj' : j'.opensRange = X'.basicOpen f') {j : U ⟶ X} [IsOpenImmersion j]
    (hj : j ≫ eX.hom = eU.hom ≫ j') {f : Γ(X, ⊤)} (hf : Associated (eX.hom.appTop f') f) :
    j.opensRange = X.basicOpen f := by
  have hj2 : j = eU.hom ≫ j' ≫ eX.inv := by
    rw [← reassoc_of% hj, Iso.hom_inv_id, Category.comp_id]
  have hu : IsUnit (j.appTop f) := by
    have h : IsUnit (j.appTop (eX.hom.appTop f')) := by
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, hj, Scheme.Hom.comp_appTop,
        CommRingCat.comp_apply]
      exact (isUnit_appTop_of_opensRange_eq f' hj').map _
    exact (hf.map j.appTop.hom).isUnit_iff.1 h
  have hι : IsUnit (((X.basicOpen f).ι ≫ eX.hom).appTop f') := by
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    exact (hf.map (X.basicOpen f).ι.appTop.hom).isUnit_iff.2
      (isUnit_appTop_of_opensRange_eq f (Scheme.Opens.opensRange_ι _))
  have hr := (range_subset_range_iff_of_opensRange_eq hj' _).2 hι
  refine opensRange_eq_of_mono hu (a := IsOpenImmersion.lift j' _ hr ≫ eU.inv) ?_
  rw [hj2, Category.assoc, Iso.inv_hom_id_assoc, IsOpenImmersion.lift_fac_assoc, Category.assoc,
    Iso.hom_inv_id, Category.comp_id]

/-- A commutative square of closed immersions `i : Z → X` and `ι : T → Y` over `g : X → Y`, with
`ι` cut out by `f` and `i` cut out by `g^* f`, is Cartesian: `Z = X ×_Y T` scheme-theoretically. -/
theorem isPullback_of_ker_eq {Y T : Scheme.{u}} {i : Z ⟶ X} {h : Z ⟶ T} {g : X ⟶ Y} {ι : T ⟶ Y}
    [IsClosedImmersion i] [IsClosedImmersion ι] {f : Γ(Y, ⊤)} (hι : ι.ker = principalIdealSheaf f)
    (hi : i.ker = principalIdealSheaf (g.appTop f)) (w : i ≫ g = h ≫ ι) : IsPullback i h g ι := by
  have hk : (pullback.fst g ι).ker = i.ker := by rw [ker_pullback_fst_of_ker_eq hι g, hi]
  let e := IsClosedImmersion.lift (pullback.fst g ι) i hk.le
  have : IsIso e := IsClosedImmersion.isIso_lift _ _ hk
  have he : e ≫ pullback.fst _ _ = i := IsClosedImmersion.lift_fac _ _ _
  have hs : e ≫ pullback.snd _ _ = h := by
    rw [← cancel_mono ι, Category.assoc, ← pullback.condition, ← Category.assoc, he, w]
  exact IsPullback.of_iso_pullback ⟨w⟩ (asIso e) he hs

end Transport

namespace DivisorPair

variable {k : Type u} [CommRing k] {D : SmoothDomain k}

/-- An isomorphism in a domain, as an isomorphism of schemes. -/
def isoLeft {X Y : D.Obj} (e : X ≅ Y) : X.obj.left ≅ Y.obj.left :=
  (ObjectProperty.ι D.property ⋙ Over.forget _).mapIso e

@[simp] lemma isoLeft_hom {X Y : D.Obj} (e : X ≅ Y) : (isoLeft e).hom = e.hom.hom.left := rfl
@[simp] lemma isoLeft_inv {X Y : D.Obj} (e : X ≅ Y) : (isoLeft e).inv = e.inv.hom.left := rfl

section OfIso

variable (P : DivisorPair D) {X Z U : D.Obj} (eX : X ≅ P.ambient) (eZ : Z ≅ P.closed)
  (eU : U ≅ P.compl) (i : Z ⟶ X) (j : U ⟶ X) (hi : i ≫ eX.hom = eZ.hom ≫ P.i)
  (hj : j ≫ eX.hom = eU.hom ≫ P.j) (f : Γ(X.obj.left, ⊤))
  (hf : Associated (eX.hom.hom.left.appTop P.eqn) f)

include hi hf in
lemma isClosedImmersion_and_ker_eq_ofIso :
    IsClosedImmersion i.hom.left ∧ i.hom.left.ker = principalIdealSheaf f :=
  isClosedImmersion_and_ker_eq_of_iso (isoLeft eX) (isoLeft eZ) P.ker_i
    (congrArg (fun g ↦ g.hom.left) hi) hf

include hj in
lemma isOpenImmersion_ofIso : IsOpenImmersion j.hom.left :=
  isOpenImmersion_of_iso (isoLeft eX) (isoLeft eU) (congrArg (fun g ↦ g.hom.left) hj)

include hj hf in
lemma opensRange_eq_ofIso :
    letI := P.isOpenImmersion_ofIso eX eU j hj
    j.hom.left.opensRange = X.obj.left.basicOpen f :=
  letI := P.isOpenImmersion_ofIso eX eU j hj
  opensRange_eq_of_iso (isoLeft eX) (isoLeft eU) P.opensRange_j
    (congrArg (fun g ↦ g.hom.left) hj) hf

include hf in
lemma isRegularSection_ofIso : IsRegularSection f := by
  refine IsRegularSection.of_associated hf.symm (.of_isIso eX.inv.hom.left ?_)
  rw [← SmoothDomain.appTop_comp_apply, Iso.inv_hom_id, SmoothDomain.appTop_id_apply]
  exact P.isRegularSection_eqn

/-- A pair transported along isomorphisms `X ≅ X_P`, `Z ≅ D_P`, `U ≅ U_P` of its three schemes, with
maps `i` and `j` corresponding to those of `P` and a unit multiple `f` of the transported equation.
It is isomorphic to `P` (`ofIsoIso`). This is how a pair of named objects, such as actual
arrangement complements, inherits the certificates of `Spec` of an algebraic pair. -/
@[implicit_reducible]
def ofIso : DivisorPair D where
  ambient := X
  closed := Z
  compl := U
  i := i
  j := j
  eqn := f
  isRegularSection_eqn := P.isRegularSection_ofIso eX f hf
  isClosedImmersion_i := (P.isClosedImmersion_and_ker_eq_ofIso eX eZ i hi f hf).1
  ker_i := (P.isClosedImmersion_and_ker_eq_ofIso eX eZ i hi f hf).2
  isOpenImmersion_j := P.isOpenImmersion_ofIso eX eU j hj
  opensRange_j := P.opensRange_eq_ofIso eX eU j hj f hf

lemma ofIso_ambient : (P.ofIso eX eZ eU i j hi hj f hf).ambient = X := rfl
lemma ofIso_closed : (P.ofIso eX eZ eU i j hi hj f hf).closed = Z := rfl
lemma ofIso_compl : (P.ofIso eX eZ eU i j hi hj f hf).compl = U := rfl
@[simp] lemma ofIso_i : (P.ofIso eX eZ eU i j hi hj f hf).i = i := rfl
@[simp] lemma ofIso_j : (P.ofIso eX eZ eU i j hi hj f hf).j = j := rfl
@[simp] lemma ofIso_eqn : (P.ofIso eX eZ eU i j hi hj f hf).eqn = f := rfl

/-- The transported pair is isomorphic to `P`, with components `eX`, `eZ` and `eU`. -/
def ofIsoIso : P.ofIso eX eZ eU i j hi hj f hf ≅ P := isoMk eX eZ eU hi hj hf

@[simp] lemma ofIsoIso_hom_ambient : (P.ofIsoIso eX eZ eU i j hi hj f hf).hom.ambient = eX.hom :=
  rfl
@[simp] lemma ofIsoIso_hom_closed : (P.ofIsoIso eX eZ eU i j hi hj f hf).hom.closed = eZ.hom :=
  rfl
@[simp] lemma ofIsoIso_hom_compl : (P.ofIsoIso eX eZ eU i j hi hj f hf).hom.compl = eU.hom :=
  rfl
@[simp] lemma ofIsoIso_inv_ambient : (P.ofIsoIso eX eZ eU i j hi hj f hf).inv.ambient = eX.inv :=
  rfl
@[simp] lemma ofIsoIso_inv_closed : (P.ofIsoIso eX eZ eU i j hi hj f hf).inv.closed = eZ.inv :=
  rfl
@[simp] lemma ofIsoIso_inv_compl : (P.ofIsoIso eX eZ eU i j hi hj f hf).inv.compl = eU.inv :=
  rfl

end OfIso

end DivisorPair

/-! ### The restriction to a hyperplane -/

section Restriction

open Arrangement

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V]
variable (𝒜 : Arrangement k V) {H K : AffineSubspace k V} {g : V →ᵃ[k] k}

/-- The closed immersion `U_𝒜'' → U_𝒜'` of the complement of the restriction to `H` into the
complement of the deletion of `H`: the map of complements of `chart H`. Under the comparisons it is
`Spec` of the existing `ComplementRing.restriction`. It does not depend on an equation of `H`.

Blueprint: `thm:geo-deletion`. -/
def complementRestriction (hH : IsHyperplane H) :
    complement (𝒜.restriction H) ⟶ complement (𝒜.deletion H) :=
  complementMap (chart H) _ _ fun _ hK ↦ covers_comap_chart hH hK

lemma complementRestriction_eq (hH : IsHyperplane H) :
    complementRestriction 𝒜 hH = complementMap (chart H) _ _ fun _ hK ↦ covers_comap_chart hH hK :=
  rfl

variable {𝒜}

instance (hH : IsHyperplane H) : IsClosedImmersion (complementRestriction 𝒜 hH).left := by
  have : IsClosedImmersion (specMap (CommAlgCat.ofHom (ComplementRing.restriction 𝒜 hH))).left :=
    IsClosedImmersion.spec_of_surjective _ (ComplementRing.surjective_restriction hH)
  change IsClosedImmersion ((complementIsoSpec _).hom.left ≫
    (specMap (CommAlgCat.ofHom (ComplementRing.restriction 𝒜 hH))).left ≫
      (complementIsoSpec _).inv.left)
  infer_instance

/-- The restriction to `U_𝒜''` of the restriction of an old function `g̃` to `U_𝒜'` is the
restriction of the function of `g ∘ chart H`.

Blueprint: `thm:geo-deletion`. -/
lemma complementRestriction_appTop (hH : IsHyperplane H) (g : V →ᵃ[k] k) :
    (complementRestriction 𝒜 hH).left.appTop
        ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord g)) =
      (complementι (𝒜.restriction H)).left.appTop (affineSpaceCoord (g.comp (chart H))) :=
  complementMap_appTop _ _ g

/-- The empty case: an equation of an old hyperplane `K` that does not meet `H` restricts to a
nonzero constant on `U_𝒜''`.

Blueprint: `thm:geo-deletion`. -/
lemma exists_complementRestriction_appTop_eq_const (hH : IsHyperplane H) (hg : IsEquation g K)
    (hbot : H ⊓ K = ⊥) :
    ∃ c : kˣ, (complementRestriction 𝒜 hH).left.appTop
        ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord g)) =
      (complementι (𝒜.restriction H)).left.appTop
        (affineSpaceCoord (AffineMap.const k H.direction (c : k))) := by
  obtain ⟨c, hc⟩ := hg.exists_comp_chart_eq_const hH.ne_bot hbot
  exact ⟨c, by rw [complementRestriction_appTop, hc]⟩

/-- The retained case: an equation of an old hyperplane `K` with trace `L` on `H` restricts on
`U_𝒜''` to a nonzero constant times the restriction of any equation `g'` of `L`.

Blueprint: `thm:geo-deletion`. -/
lemma exists_complementRestriction_appTop_eq_const_mul (hH : IsHyperplane H) (hg : IsEquation g K)
    {L : AffineSubspace k H.direction} (hL : IsHyperplane L) (hKL : K.comap (chart H) = L)
    {g' : H.direction →ᵃ[k] k} (hg' : IsEquation g' L) :
    ∃ c : kˣ, (complementRestriction 𝒜 hH).left.appTop
        ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord g)) =
      (complementι (𝒜.restriction H)).left.appTop
          (affineSpaceCoord (AffineMap.const k H.direction (c : k))) *
        (complementι (𝒜.restriction H)).left.appTop (affineSpaceCoord g') := by
  have hz : zeroLocus (g.comp (chart H)) = L := by
    rw [zeroLocus_comp, hg.zeroLocus_eq, hKL]
  have hgc : IsEquation (g.comp (chart H)) L := ⟨isHyperplane_zeroLocus_iff.1 (hz ▸ hL), hz⟩
  obtain ⟨c, hc, -⟩ := hg'.existsUnique_smul hgc
  exact ⟨c, by rw [complementRestriction_appTop, hc, affineSpaceCoord_smul, map_mul]⟩

/-- The duplicate case: equations of two old hyperplanes with the same trace on `H` restrict to the
same function on `U_𝒜''` up to a nonzero constant. This includes an empty trace.

Blueprint: `thm:geo-deletion`. -/
lemma exists_complementRestriction_appTop_eq_const_mul_of_inf_eq (hH : IsHyperplane H)
    {K₁ K₂ : AffineSubspace k V} (hK₁ : K₁ ∈ 𝒜.deletion H) {g₁ g₂ : V →ᵃ[k] k}
    (hg₁ : IsEquation g₁ K₁) (hg₂ : IsEquation g₂ K₂) (h : H ⊓ K₁ = H ⊓ K₂) :
    ∃ c : kˣ, (complementRestriction 𝒜 hH).left.appTop
        ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord g₁)) =
      (complementι (𝒜.restriction H)).left.appTop
          (affineSpaceCoord (AffineMap.const k H.direction (c : k))) *
        (complementRestriction 𝒜 hH).left.appTop
          ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord g₂)) := by
  suffices ∃ c : kˣ, g₁.comp (chart H) = (c : k) • g₂.comp (chart H) by
    obtain ⟨c, hc⟩ := this
    exact ⟨c, by rw [complementRestriction_appTop, complementRestriction_appTop, hc,
      affineSpaceCoord_smul, map_mul]⟩
  by_cases hbot : H ⊓ K₁ = ⊥
  · obtain ⟨c₁, hc₁⟩ := hg₁.exists_comp_chart_eq_const hH.ne_bot hbot
    obtain ⟨c₂, hc₂⟩ := hg₂.exists_comp_chart_eq_const hH.ne_bot (h ▸ hbot)
    refine ⟨c₁ * c₂⁻¹, ?_⟩
    rw [hc₁, hc₂]
    ext v
    simp
  · have hK := (comap_chart_eq_comap_chart_iff hH.ne_bot).2 h
    have hL := (𝒜.restriction H).isHyperplane (comap_chart_mem_restriction hH hK₁ hbot)
    have hz₁ : zeroLocus (g₁.comp (chart H)) = K₁.comap (chart H) := by
      rw [zeroLocus_comp, hg₁.zeroLocus_eq]
    have hz₂ : zeroLocus (g₂.comp (chart H)) = K₁.comap (chart H) := by
      rw [zeroLocus_comp, hg₂.zeroLocus_eq, hK]
    have e₁ : IsEquation (g₁.comp (chart H)) (K₁.comap (chart H)) :=
      ⟨isHyperplane_zeroLocus_iff.1 (hz₁ ▸ hL), hz₁⟩
    have e₂ : IsEquation (g₂.comp (chart H)) (K₁.comap (chart H)) :=
      ⟨isHyperplane_zeroLocus_iff.1 (hz₂ ▸ hL), hz₂⟩
    obtain ⟨c, hc, -⟩ := e₂.existsUnique_smul e₁
    exact ⟨c, hc⟩

end Restriction

/-! ### The deletion pair -/

namespace DivisorPair

open Arrangement

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
variable (D : SmoothDomain k) (𝒜 : Arrangement k V) {H : AffineSubspace k V} {f g : V →ᵃ[k] k}

/-- The closed immersion `U_𝒜'' → U_𝒜'`, in a domain. -/
def _root_.OrlikSolomon.Geometric.SmoothDomain.complementRestriction (hH : IsHyperplane H) :
    D.complement (𝒜.restriction H) ⟶ D.complement (𝒜.deletion H) :=
  ObjectProperty.homMk (Geometric.complementRestriction 𝒜 hH)

@[simp] lemma _root_.OrlikSolomon.Geometric.SmoothDomain.complementRestriction_hom
    (hH : IsHyperplane H) :
    (D.complementRestriction 𝒜 hH).hom = Geometric.complementRestriction 𝒜 hH := rfl

variable {𝒜}

lemma deletionPair_hi (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    D.complementRestriction 𝒜 (𝒜.isHyperplane hH) ≫ (D.complementIsoSpec (𝒜.deletion H)).hom =
      (D.complementIsoSpec (𝒜.restriction H)).hom ≫
        (spec D (OrlikSolomon.DivisorPair.deletionPair 𝒜 hH hf)).i :=
  D.complementMap_comp_complementIsoSpec_hom _ _

lemma deletionPair_hj (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    D.complementInclusion (𝒜.deletion_le H) ≫ (D.complementIsoSpec (𝒜.deletion H)).hom =
      (D.complementIsoSpec 𝒜).hom ≫ (spec D (OrlikSolomon.DivisorPair.deletionPair 𝒜 hH hf)).j :=
  D.complementInclusion_comp_complementIsoSpec_hom _

lemma deletionPair_hf (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    Associated ((D.complementIsoSpec (𝒜.deletion H)).hom.hom.left.appTop
        (spec D (OrlikSolomon.DivisorPair.deletionPair 𝒜 hH hf)).eqn)
      ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord f)) :=
  .of_eq (complementIsoSpec_hom_appTop_coord f)

variable (𝒜) in
/-- The geometric deletion pair `(U_𝒜', U_𝒜'', U_𝒜, f̃_H|_{U_𝒜'})` of a hyperplane `H ∈ 𝒜` and any
equation `f_H` of `H`, in an admissible domain `D`. Its schemes are the actual complements, its
closed map is `complementRestriction` and its open map `complementInclusion`. It is isomorphic to
`Spec` of the existing deletion pair by the comparisons `s` (`deletionPairIsoSpec`), and only its
equation depends on `f_H` (`deletionPairIso`).

Blueprint: `thm:geo-deletion`. -/
@[implicit_reducible]
def deletionPair (hH : H ∈ 𝒜) (hf : IsEquation f H) : DivisorPair D :=
  (spec D (OrlikSolomon.DivisorPair.deletionPair 𝒜 hH hf)).ofIso
    (D.complementIsoSpec (𝒜.deletion H)) (D.complementIsoSpec (𝒜.restriction H))
    (D.complementIsoSpec 𝒜) (D.complementRestriction 𝒜 (𝒜.isHyperplane hH))
    (D.complementInclusion (𝒜.deletion_le H)) (deletionPair_hi D hH hf) (deletionPair_hj D hH hf)
    ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord f)) (deletionPair_hf D hH hf)

variable (hH : H ∈ 𝒜) (hf : IsEquation f H)

lemma deletionPair_ambient : (deletionPair D 𝒜 hH hf).ambient = D.complement (𝒜.deletion H) :=
  rfl
lemma deletionPair_closed : (deletionPair D 𝒜 hH hf).closed = D.complement (𝒜.restriction H) :=
  rfl
lemma deletionPair_compl : (deletionPair D 𝒜 hH hf).compl = D.complement 𝒜 := rfl

@[simp] lemma deletionPair_i :
    (deletionPair D 𝒜 hH hf).i = D.complementRestriction 𝒜 (𝒜.isHyperplane hH) := rfl

@[simp] lemma deletionPair_j :
    (deletionPair D 𝒜 hH hf).j = D.complementInclusion (𝒜.deletion_le H) := rfl

@[simp] lemma deletionPair_eqn :
    (deletionPair D 𝒜 hH hf).eqn = (complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord f) :=
  rfl

/-- The equation unit of the deletion pair is the restriction of `f̃_H` to `U_𝒜`, the unit
`complementUnit 𝒜 f`.

Blueprint: `thm:geo-deletion`. -/
lemma coe_deletionPair_eqnUnit :
    ((deletionPair D 𝒜 hH hf).eqnUnit : Γ((deletionPair D 𝒜 hH hf).compl.obj.left, ⊤)) =
      (complementUnit 𝒜 f (hf.covers hH) : Γ((complement 𝒜).left, ⊤)) :=
  complementInclusion_appTop (𝒜.deletion_le H) (affineSpaceCoord f)

/-- The deletion pair is `Spec` of the existing deletion pair, by the comparisons `s_𝒜'`, `s_𝒜''`
and `s_𝒜`. So its pair of global sections is the existing deletion pair
(`globalSectionsDeletionPairIso`), and a theory's residue and Gysin maps on it are those of the
existing pair, by naturality along this isomorphism.

Blueprint: `thm:geo-deletion`. -/
def deletionPairIsoSpec :
    deletionPair D 𝒜 hH hf ≅ spec D (OrlikSolomon.DivisorPair.deletionPair 𝒜 hH hf) :=
  ofIsoIso _ _ _ _ _ _ _ _ _ _

@[simp] lemma deletionPairIsoSpec_hom_ambient :
    (deletionPairIsoSpec D hH hf).hom.ambient = (D.complementIsoSpec (𝒜.deletion H)).hom := rfl
@[simp] lemma deletionPairIsoSpec_hom_closed :
    (deletionPairIsoSpec D hH hf).hom.closed = (D.complementIsoSpec (𝒜.restriction H)).hom := rfl
@[simp] lemma deletionPairIsoSpec_hom_compl :
    (deletionPairIsoSpec D hH hf).hom.compl = (D.complementIsoSpec 𝒜).hom := rfl

/-- The deletion pairs of two equations of `H` are isomorphic by the identities of their schemes:
the multiplier is the nonzero constant relating the equations (`coe_complementUnit_smul`). So a
theory's residue and Gysin maps on the deletion pair do not depend on the equation.

Blueprint: `thm:geo-deletion`. -/
def deletionPairIso (hg : IsEquation g H) : deletionPair D 𝒜 hH hf ≅ deletionPair D 𝒜 hH hg :=
  isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp) (by simp) <| by
    rw [Iso.refl_hom, SmoothDomain.appTop_id_apply]
    exact ((hf.associated_coord hg).map ((complementι (𝒜.deletion H)).left.appTop.hom.comp
      (Scheme.ΓSpecIso (.of (CoordinateRing k V))).inv.hom)).symm

@[simp] lemma deletionPairIso_hom_ambient (hg : IsEquation g H) :
    (deletionPairIso D hH hf hg).hom.ambient = 𝟙 _ := rfl
@[simp] lemma deletionPairIso_hom_closed (hg : IsEquation g H) :
    (deletionPairIso D hH hf hg).hom.closed = 𝟙 _ := rfl
@[simp] lemma deletionPairIso_hom_compl (hg : IsEquation g H) :
    (deletionPairIso D hH hf hg).hom.compl = 𝟙 _ := rfl

variable (𝒜) in
/-- The pair of global sections of the deletion pair in the affine domain is the existing deletion
pair, through the comparisons `s` and the unit of affine duality.

Blueprint: `thm:geo-deletion`. -/
def globalSectionsDeletionPairIso :
    globalSections (deletionPair (SmoothDomain.aff k) 𝒜 hH hf) ≅
      OrlikSolomon.DivisorPair.deletionPair 𝒜 hH hf :=
  ((globalSectionsFunctor k).mapIso (deletionPairIsoSpec (SmoothDomain.aff k) hH hf).op).symm ≪≫
    (unitIso _).symm

end DivisorPair

/-! ### The certificates and the fiber product -/

section Certificates

open Arrangement

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
variable {𝒜 : Arrangement k V} {H : AffineSubspace k V} {f : V →ᵃ[k] k}

/-- On `X = U_𝒜'`, the restriction of `f̃_H` is regular.

Blueprint: `thm:geo-deletion`. -/
lemma isRegularSection_deletion (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    IsRegularSection ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord f)) :=
  (DivisorPair.deletionPair (SmoothDomain.aff k) 𝒜 hH hf).isRegularSection_eqn

/-- `U_𝒜''` is the zero scheme `Z_X(f_H)` of `f̃_H` on `X = U_𝒜'`, through `complementRestriction`.

Blueprint: `thm:geo-deletion`. -/
lemma ker_complementRestriction (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    (complementRestriction 𝒜 (𝒜.isHyperplane hH)).left.ker =
      principalIdealSheaf ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord f)) :=
  (DivisorPair.deletionPair (SmoothDomain.aff k) 𝒜 hH hf).ker_i

/-- `U_𝒜` is the basic open `X_{f_H}` of `f̃_H` on `X = U_𝒜'`, through `complementInclusion`.

Blueprint: `thm:geo-deletion`. -/
lemma opensRange_complementInclusion_deletion (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    (complementInclusion (𝒜.deletion_le H)).left.opensRange =
      (complement (𝒜.deletion H)).left.basicOpen
        ((complementι (𝒜.deletion H)).left.appTop (affineSpaceCoord f)) :=
  (DivisorPair.deletionPair (SmoothDomain.aff k) 𝒜 hH hf).opensRange_j

/-- **The scheme-theoretic fiber product.** The closed part `U_𝒜''` of the deletion pair is
`U_𝒜' ×_{𝔸_V} 𝐇`: the square of `complementRestriction`, the open immersions into the affine
spaces and `𝔸_{H.direction} ≅ 𝐇` is Cartesian. This is an equality of closed subschemes, not only
of supports.

Blueprint: `thm:geo-deletion`. -/
theorem isPullback_complementRestriction (hH : H ∈ 𝒜) :
    IsPullback (complementRestriction 𝒜 (𝒜.isHyperplane hH)).left
      ((complementι (𝒜.restriction H)).left ≫ (hyperplaneSchemeIso (𝒜.isHyperplane hH)).hom.left)
      (complementι (𝒜.deletion H)).left (hyperplaneι H).left := by
  obtain ⟨f, hf⟩ := (𝒜.isHyperplane hH).exists_isEquation
  refine isPullback_of_ker_eq (ker_hyperplaneι hf) (ker_complementRestriction hH hf) ?_
  rw [← Over.comp_left, complementRestriction, complementMap_comp_complementι,
    ← hyperplaneSchemeIso_hom_comp_hyperplaneι (𝒜.isHyperplane hH)]
  rfl

end Certificates

end OrlikSolomon.Geometric
