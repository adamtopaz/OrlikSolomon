module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import OrlikSolomon.Geometry.Schemes.AffineDuality

/-!
# Zero schemes, basic opens and regular sections

This file proves `lem:geo-affine-pairs` of the geometric refactor blueprint. For a global function
`f` on a scheme `X`, the zero scheme `Z_X(f)` is the closed subscheme of the ideal sheaf
generated by `f`, the image of multiplication by `f`, and `X_f` is Mathlib's basic open
`X.basicOpen f`. On an affine `X` with `A = Γ(X, 𝒪_X)` they are `Spec (A ⧸ (f))` and `Spec A_f`,
compatibly with the immersions into `X`, and `f` is regular on `𝒪_X` exactly when it is a
non-zero-divisor of `A`.

## Main definitions

* `Geometric.principalIdealSheaf f`: the ideal sheaf `f 𝒪_X`, Mathlib's
  `ofIdealTop (Ideal.span {f})`.
* `Geometric.zeroScheme f`, `Geometric.zeroSchemeι f`: the closed subscheme `Z_X(f)` and its closed
  immersion into `X`.
* `Geometric.zeroSchemeLift`: the universal property, a map `g : T ⟶ X` with `g^* f = 0` factors
  through `Z_X(f)`.
* `Geometric.IsRegularSection f`: multiplication by `f` on `𝒪_X` is injective, on every open.
* `Geometric.zeroSchemeIsoSpec f`, `Geometric.basicOpenIsoSpec f`: for affine `X`, the
  identifications `Z_X(f) ≅ Spec (A ⧸ (f))` and `X_f ≅ Spec A_f` over `X`.

## Main results

* `ker_zeroSchemeι`: the kernel of `Z_X(f) → X` is `f 𝒪_X`, for every `X`.
* `ker_eq_principalIdealSheaf_iff`: on an affine `X`, a quasi-compact morphism has kernel `f 𝒪_X`
  exactly when its map on global sections has kernel `(f)`.
* `isRegularSection_iff`: on an affine `X`, `f` is regular on `𝒪_X` iff `f ∈ nonZeroDivisors A`.
* `smooth_zeroScheme_iff`: for affine `X` over `S`, `Z_X(f)` is smooth over `S` iff `A ⧸ (f)` is a
  smooth `k`-algebra. That `X_f` is smooth when `X` is follows from Mathlib's instances for open
  immersions.

## Implementation notes

`Z_X(f)` is built from an ideal sheaf rather than as the fiber product `X ×_{𝔸¹} 0`, because
Mathlib's theory of closed subschemes is phrased through kernels of ideal sheaves
(`Scheme.Hom.ker`, `IsClosedImmersion.lift`, `IsClosedImmersion.isIso_lift`). So "the closed map
`i : D ⟶ X` identifies `D` with `Z_X(f)`" is the proposition
`IsClosedImmersion i ∧ i.ker = principalIdealSheaf f`, with no data, and two such `D` are isomorphic
over `X` by `IsClosedImmersion.isIso_lift`. Similarly "the open map `j` identifies `U` with
`X_f`" is `IsOpenImmersion j ∧ j.opensRange = X.basicOpen f`.

Units and the zero ring are allowed: a unit cuts out the empty scheme, and nothing here assumes `f`
regular.
-/

@[expose] public section

noncomputable section

open CategoryTheory Limits Opposite AlgebraicGeometry TopologicalSpace

universe u

namespace OrlikSolomon.Geometric

section ZeroScheme

variable {X T : Scheme.{u}} (f : Γ(X, ⊤))

/-! ### The zero scheme -/

/-- The ideal sheaf `f 𝒪_X` generated by a global function, the image of multiplication by `f`. On
an affine open `U` it is the ideal generated by `f|_U`.

Blueprint: `lem:geo-affine-pairs`. -/
def principalIdealSheaf : X.IdealSheafData := .ofIdealTop (Ideal.span {f})

lemma principalIdealSheaf_ideal (U : X.affineOpens) :
    (principalIdealSheaf f).ideal U = Ideal.span {X.presheaf.map (homOfLE le_top).op f} := by
  rw [principalIdealSheaf, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span,
    Set.image_singleton]

/-- The zero scheme `Z_X(f)`, the closed subscheme of `X` cut out by `f`.

Blueprint: `lem:geo-affine-pairs`. -/
def zeroScheme : Scheme.{u} := (principalIdealSheaf f).subscheme

/-- The closed immersion `Z_X(f) → X`.

Blueprint: `lem:geo-affine-pairs`. -/
def zeroSchemeι : zeroScheme f ⟶ X := (principalIdealSheaf f).subschemeι

instance : IsClosedImmersion (zeroSchemeι f) :=
  inferInstanceAs (IsClosedImmersion (principalIdealSheaf f).subschemeι)

/-- The kernel of `Z_X(f) → X` is `f 𝒪_X`. -/
@[simp] lemma ker_zeroSchemeι : (zeroSchemeι f).ker = principalIdealSheaf f :=
  Scheme.IdealSheafData.ker_subschemeι _

variable {f}

/-- If `g^* f = 0` then `f 𝒪_X` is contained in the kernel of `g`. -/
lemma principalIdealSheaf_le_ker {g : T ⟶ X} (hg : g.appTop f = 0) :
    principalIdealSheaf f ≤ g.ker := by
  rw [Scheme.Hom.ker, Scheme.IdealSheafData.le_ofIdeals_iff]
  intro U
  rw [principalIdealSheaf_ideal, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
    RingHom.mem_ker, ← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply]
  exact (congrArg _ hg).trans (map_zero _)

variable (f) in
/-- The function `f` vanishes on its zero scheme. -/
@[simp] lemma zeroSchemeι_appTop : (zeroSchemeι f).appTop f = 0 := by
  apply TopCat.Presheaf.section_ext (zeroScheme f).sheaf ⊤ _ 0
  intro z _
  obtain ⟨_, ⟨U, hU, rfl⟩, hzU, -⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ ((zeroSchemeι f).base z)) isOpen_univ
  have h0 : (zeroSchemeι f).app U (X.presheaf.map (homOfLE le_top).op f) = 0 := by
    have h := (zeroSchemeι f).ideal_ker_le ⟨U, hU⟩
    rw [ker_zeroSchemeι, principalIdealSheaf_ideal] at h
    exact h (Ideal.subset_span rfl)
  have hz : z ∈ zeroSchemeι f ⁻¹ᵁ U := hzU
  change (zeroScheme f).presheaf.germ ⊤ z trivial _ = (zeroScheme f).presheaf.germ ⊤ z trivial 0
  have h1 : (zeroScheme f).presheaf.map (homOfLE le_top : zeroSchemeι f ⁻¹ᵁ U ⟶ ⊤).op
      ((zeroSchemeι f).appTop f) = (zeroSchemeι f).app U (X.presheaf.map (homOfLE le_top).op f) :=
    (ConcreteCategory.congr_hom ((zeroSchemeι f).naturality (homOfLE le_top : U ⟶ ⊤).op) f).symm
  rw [map_zero, ← (zeroScheme f).presheaf.germ_res_apply (homOfLE le_top) z hz, h1, h0, map_zero]

/-- The universal property of the zero scheme: a morphism `g : T ⟶ X` with `g^* f = 0` factors
through `Z_X(f)`, uniquely since closed immersions are monomorphisms. -/
def zeroSchemeLift (g : T ⟶ X) (hg : g.appTop f = 0) : T ⟶ zeroScheme f :=
  IsClosedImmersion.lift (zeroSchemeι f) g
    ((ker_zeroSchemeι f).trans_le (principalIdealSheaf_le_ker hg))

@[reassoc (attr := simp)]
lemma zeroSchemeLift_ι (g : T ⟶ X) (hg : g.appTop f = 0) :
    zeroSchemeLift g hg ≫ zeroSchemeι f = g :=
  IsClosedImmersion.lift_fac _ _ _

/-- A morphism to `X` factors through `Z_X(f)` exactly when it pulls `f` back to zero. -/
lemma exists_eq_comp_zeroSchemeι_iff (g : T ⟶ X) :
    (∃ h : T ⟶ zeroScheme f, h ≫ zeroSchemeι f = g) ↔ g.appTop f = 0 := by
  refine ⟨?_, fun hg ↦ ⟨zeroSchemeLift g hg, zeroSchemeLift_ι g hg⟩⟩
  rintro ⟨h, rfl⟩
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, zeroSchemeι_appTop, map_zero]

variable (f) in
/-- A unit generates the whole structure sheaf. -/
lemma principalIdealSheaf_eq_top_of_isUnit (hf : IsUnit f) : principalIdealSheaf f = ⊤ := by
  ext U : 2
  rw [principalIdealSheaf, Scheme.IdealSheafData.ofIdealTop_ideal,
    Ideal.span_singleton_eq_top.2 hf, Ideal.map_top]
  rfl

variable (f) in
/-- A unit cuts out the empty scheme. -/
lemma isEmpty_zeroScheme_of_isUnit (hf : IsUnit f) : IsEmpty (zeroScheme f) := by
  change IsEmpty (principalIdealSheaf f).subscheme
  rw [principalIdealSheaf_eq_top_of_isUnit f hf]
  infer_instance

/-! ### Comparison on affine schemes -/

section Affine

variable (f) in
/-- On an affine `X`, the ideal sheaf `f 𝒪_X` has global sections `(f)`. -/
lemma principalIdealSheaf_ideal_top [IsAffine X] :
    (principalIdealSheaf f).ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span {f} := by
  rw [principalIdealSheaf_ideal]
  congr
  exact (congrArg (fun φ ↦ φ f) (X.presheaf.map_id (op ⊤))).trans rfl

/-- On an affine `X`, a quasi-compact morphism (for example a closed immersion) has kernel `f 𝒪_X`
exactly when its map on global sections has kernel `(f)`. This translates the closed-subscheme
certificate of a geometric pair into the kernel certificate of an algebraic pair. -/
lemma ker_eq_principalIdealSheaf_iff [IsAffine X] (i : T ⟶ X) [QuasiCompact i] :
    i.ker = principalIdealSheaf f ↔ RingHom.ker i.appTop.hom = Ideal.span {f} := by
  have h := Scheme.Hom.ker_apply i ⟨⊤, isAffineOpen_top X⟩
  constructor
  · intro e
    rw [← principalIdealSheaf_ideal_top f, ← e]
    exact h.symm
  · intro e
    apply Scheme.IdealSheafData.ext_of_isAffine
    rw [h, principalIdealSheaf_ideal_top]
    exact e

variable (f) [IsAffine X]

/-- On an affine `X`, `Γ(X, 𝒪_X) → Γ(Z_X(f), 𝒪)` is surjective. -/
lemma zeroSchemeι_appTop_surjective : Function.Surjective (zeroSchemeι f).appTop :=
  (principalIdealSheaf f).subschemeι_app_surjective ⟨⊤, isAffineOpen_top X⟩

/-- On an affine `X`, the kernel of `Γ(X, 𝒪_X) → Γ(Z_X(f), 𝒪)` is `(f)`. -/
lemma ker_zeroSchemeι_appTop : RingHom.ker (zeroSchemeι f).appTop.hom = Ideal.span {f} :=
  (ker_eq_principalIdealSheaf_iff (zeroSchemeι f)).1 (ker_zeroSchemeι f)

instance : IsAffine (zeroScheme f) := isAffine_of_isAffineHom (zeroSchemeι f)

/-- On an affine `X`, the ring isomorphism `A ⧸ (f) ≅ Γ(Z_X(f), 𝒪)` induced by the closed
immersion. -/
def zeroSchemeRingIso : CommRingCat.of (Γ(X, ⊤) ⧸ Ideal.span {f}) ≅ Γ(zeroScheme f, ⊤) :=
  ((Ideal.quotEquivOfEq (ker_zeroSchemeι_appTop f).symm).trans
    (RingHom.quotientKerEquivOfSurjective (zeroSchemeι_appTop_surjective f))).toCommRingCatIso

lemma zeroSchemeRingIso_hom :
    CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f})) ≫ (zeroSchemeRingIso f).hom =
      (zeroSchemeι f).appTop := by
  ext x
  rfl

/-- On an affine `X` with `A = Γ(X, 𝒪_X)`, the zero scheme is `Spec (A ⧸ (f))`, compatibly with
the closed immersions into `X` (`zeroSchemeIsoSpec_hom_comp`).

Blueprint: `lem:geo-affine-pairs`. -/
def zeroSchemeIsoSpec : zeroScheme f ≅ Spec (.of (Γ(X, ⊤) ⧸ Ideal.span {f})) :=
  (zeroScheme f).isoSpec ≪≫ Scheme.Spec.mapIso (zeroSchemeRingIso f).op

@[reassoc (attr := simp)]
lemma zeroSchemeIsoSpec_hom_comp :
    (zeroSchemeIsoSpec f).hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
      X.isoSpec.inv = zeroSchemeι f := by
  rw [zeroSchemeIsoSpec, Iso.trans_hom, Functor.mapIso_hom, Iso.op_hom, Scheme.Spec_map,
    Quiver.Hom.unop_op, Category.assoc, ← Spec.map_comp_assoc, zeroSchemeRingIso_hom,
    Scheme.isoSpec_hom_naturality_assoc, Iso.hom_inv_id, Category.comp_id]

/-- On an affine `X` with `A = Γ(X, 𝒪_X)`, the basic open `X_f` is `Spec A_f`, compatibly with the
open immersions into `X` (`basicOpenIsoSpec_hom_comp`).

Blueprint: `lem:geo-affine-pairs`. -/
def basicOpenIsoSpec : (X.basicOpen f).toScheme ≅ Spec (.of (Localization.Away f)) :=
  IsOpenImmersion.isoOfRangeEq (X.basicOpen f).ι
    (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away f))) ≫ X.isoSpec.inv) <| by
    have h : Set.range (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away f)))) =
        (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum Γ(X, ⊤))) :=
      PrimeSpectrum.localization_away_comap_range _ _
    have hl : Function.LeftInverse X.isoSpec.hom.base X.isoSpec.inv.base := fun y ↦ by
      rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
      rfl
    have hr : Function.RightInverse X.isoSpec.hom.base X.isoSpec.inv.base := fun y ↦ by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl
    rw [Scheme.Opens.range_ι, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, h,
      Set.image_eq_preimage_of_inverse hl hr, ← Scheme.map_PrimeSpectrum_basicOpen_of_affine]
    rfl

@[reassoc (attr := simp)]
lemma basicOpenIsoSpec_hom_comp :
    (basicOpenIsoSpec f).hom ≫
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away f))) ≫
      X.isoSpec.inv = (X.basicOpen f).ι :=
  IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _

end Affine

end ZeroScheme

/-! ### Regularity -/

section Regular

variable {X : Scheme.{u}} (f : Γ(X, ⊤))

/-- A global function `f` is regular on `𝒪_X`: multiplication by `f` is injective on the sections
over every open, that is, it is a monomorphism of sheaves.

Blueprint: `lem:geo-affine-pairs`, used for `def:geo-divisor-pair`. -/
def IsRegularSection : Prop :=
  ∀ U : X.Opens, X.presheaf.map (homOfLE le_top).op f ∈ nonZeroDivisors Γ(X, U)

/-- On an affine `X`, `f` is regular on `𝒪_X` exactly when it is a non-zero-divisor of
`Γ(X, 𝒪_X)`: a non-zero-divisor stays one on every basic open, which is a localization, and sections
are determined by their germs.

Blueprint: `lem:geo-affine-pairs`. -/
lemma isRegularSection_iff [IsAffine X] : IsRegularSection f ↔ f ∈ nonZeroDivisors Γ(X, ⊤) := by
  refine ⟨fun h ↦ ?_, fun hf U ↦ ?_⟩
  · have := h ⊤
    rwa [show X.presheaf.map (homOfLE le_top : (⊤ : X.Opens) ⟶ ⊤).op = 𝟙 _ from
      (congrArg _ (Subsingleton.elim _ _)).trans (X.presheaf.map_id _)] at this
  rw [mem_nonZeroDivisors_iff_right]
  intro s hs
  apply TopCat.Presheaf.section_ext X.sheaf U s 0
  intro x hx
  obtain ⟨_, ⟨a, rfl⟩, hxa, hle⟩ := Opens.isBasis_iff_nbhd.1 (isBasis_basicOpen X) hx
  have h1 : X.presheaf.map (homOfLE hle).op s *
      X.presheaf.map (homOfLE le_top : X.basicOpen a ⟶ ⊤).op f = 0 := by
    have h := congrArg (X.presheaf.map (homOfLE hle).op) hs
    rwa [map_mul, map_zero, ← CommRingCat.comp_apply, ← Functor.map_comp] at h
  have hf' : X.presheaf.map (homOfLE le_top : X.basicOpen a ⟶ ⊤).op f ∈
      nonZeroDivisors Γ(X, X.basicOpen a) :=
    IsLocalization.nonZeroDivisors_le_comap (Submonoid.powers a) Γ(X, X.basicOpen a) hf
  have h2 := mem_nonZeroDivisors_iff_right.1 hf' _ h1
  change X.presheaf.germ U x hx s = X.presheaf.germ U x hx 0
  rw [map_zero, ← X.presheaf.germ_res_apply (homOfLE hle) x hxa, h2, map_zero]

end Regular

/-! ### Smoothness -/

section Smooth

/-- The basic open `X_f` of a smooth `S`-scheme is smooth over `S`, since open immersions are.

Blueprint: `lem:geo-affine-pairs`. -/
lemma smooth_basicOpen {k : Type u} [CommRing k] (X : Over (Spec (.of k))) [Smooth X.hom]
    (f : Γ(X.left, ⊤)) : Smooth ((X.left.basicOpen f).ι ≫ X.hom) :=
  inferInstance

variable {k : Type u} [CommRing k] (X : Over (Spec (.of k))) [IsAffine X.left] (f : Γ(X.left, ⊤))

/-- For an affine `S`-scheme `X` with `A = Γ(X, 𝒪_X)`, the zero scheme `Z_X(f)` is smooth over `S`
exactly when `A ⧸ (f)` is a smooth `k`-algebra. (The basic open `X_f` is smooth when `X` is, by
Mathlib's instances for open immersions.)

Blueprint: `lem:geo-affine-pairs`. -/
lemma smooth_zeroScheme_iff :
    Smooth (zeroSchemeι f ≫ X.hom) ↔
      Algebra.Smooth k (globalSections X ⧸ Ideal.span {(f : globalSections X)}) := by
  have e : zeroSchemeι f ≫ X.hom = (zeroSchemeIsoSpec f).hom ≫
      (spec (CommAlgCat.of k (globalSections X ⧸ Ideal.span {(f : globalSections X)}))).hom := by
    rw [← zeroSchemeIsoSpec_hom_comp f, Category.assoc, Category.assoc,
      specGlobalSectionsIso_w X, spec_hom, spec_hom, ← Spec.map_comp]
    rfl
  rw [e]
  refine Iff.trans ?_ (smooth_spec_hom_iff (CommAlgCat.of k _))
  constructor <;> intro
  · simpa using (inferInstance : Smooth ((zeroSchemeIsoSpec f).inv ≫
      (zeroSchemeIsoSpec f).hom ≫ (spec (CommAlgCat.of k
        (globalSections X ⧸ Ideal.span {(f : globalSections X)}))).hom))
  · infer_instance

end Smooth

end OrlikSolomon.Geometric
