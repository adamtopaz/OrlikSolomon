/-!
# The deletion pair

For a hyperplane `H` of an arrangement `𝒜`, with deletion `𝒜'` and restriction `𝒜''`, this file
constructs the certified divisor pair `(O(U_𝒜'), O(U_𝒜''), O(U_𝒜), f_H)`, for any equation `f_H` of
`H`. It is the ring part of `lem:restriction-geometry`: the schemes of the pair are `X = U_𝒜'`,
`D = H ∩ X ≃ U_𝒜''` and `U = X ∖ D = U_𝒜`, and `f_H` cuts `D` out of `X`.

Nothing here refers to `k`-points of a complement, so it applies over finite fields, and to
complements with no rational points. It also applies in dimension one, where `H` is a point,
`H.direction` is zero and `𝒜''` is empty.

## Main definitions

* `IsEquation.quotientEquiv`: `O(V) ⧸ (f) ≃ₐ O(H.direction)`, for an equation `f` of `H`.
* `ComplementRing.restriction`, `SmoothAlg.complementRestriction`: the restriction
  `i^* : O(U_𝒜') → O(U_𝒜'')`, which depends on no equation.
* `ComplementRing.quotientEquiv`: `O(U_𝒜') ⧸ (f) ≃ₐ O(U_𝒜'')`, for an equation `f` of `H`.
* `DivisorPair.deletionPair`: the deletion pair of `H` and an equation of `H`.
* `DivisorPair.deletionPairHom`: the transverse morphism between the deletion pairs of two equations
  of `H`, which is the identity on all three rings.

## Main results

* `IsEquation.ker_pull_chart`: `f` generates the ideal of `H` in `O(V)`.
* `ComplementRing.isLocalization_restriction`: `O(U_𝒜'')` is the localization of `O(H.direction)` at
  the restrictions of the equations of `𝒜'`.
* `ComplementRing.surjective_restriction`, `ComplementRing.ker_restriction`: `i^*` is surjective,
  and its kernel is generated by `f`.
* `ComplementRing.isLocalizationAway_inclusion`: `O(U_𝒜) = O(U_𝒜')[1/f]`.
* The restriction of units, for every equation of an old hyperplane `K`:
  - `SmoothAlg.mapUnits_complementRestriction_complementUnit`: in general, the unit of `f` goes to
    the unit of `f ∘ chart H`;
  - `SmoothAlg.exists_mapUnits_complementRestriction_eq_constUnit`: an empty trace gives a constant;
  - `SmoothAlg.exists_mapUnits_complementRestriction_eq_constUnit_mul`: a retained trace gives a
    constant times the unit of any equation of it;
  - `SmoothAlg.exists_mapUnits_complementRestriction_eq_constUnit_mul_of_inf_eq`: two old
    hyperplanes with the same trace on `H`, which is the duplicate case, have the same unit up to a
    constant.
* `DivisorPair.deletionPair_eqnUnit`: the equation unit of the pair is the unit of `f` on `U_𝒜`.

## Working with deletion pairs

The pair is a `def`, like `DivisorPair.standardPair`, so `(deletionPair 𝒜 hH hf).closed` is
`complement (𝒜.restriction H)` only at default transparency. Its parts have typed names, which do
not mention the pair and should be used in its place: `complement (𝒜.deletion H)`,
`complement (𝒜.restriction H)`, `complement 𝒜`, `complementRestriction 𝒜 hH`,
`complementInclusion (𝒜.deletion_le H)`, `toComplement (𝒜.deletion H) (affineCoord f)` and
`complementUnit 𝒜 f (hf.covers hH)`. For the same reason, the lemmas `deletionPair_closed` and so on
are not `simp` lemmas, as the implementation notes in `Geometry/SmoothAlg` explain. The residue and
Gysin maps have typed names in `Cohomology/DeletionPair`.

The maps `i^*` and `j^*` do not depend on the equation, and `deletionPairHom` shows that neither do
the residue and Gysin maps of a theory. So a result should hold for every equation of `H`, and one
should not fix `equation H` in a statement.

No result should depend on the base point in `chart H`. The arrangement `𝒜''` lives on
`H.direction` through `chart H`, so that map appears in statements, in the form `K.comap (chart H)`
or `f.comp (chart H)`, but nothing says which point `chart H 0` is. Conditions on old hyperplanes
are phrased through `H ⊓ K`, and `comap_chart_eq_comap_chart_iff` translates them.

## Blueprint

The ring part of `lem:restriction-geometry`, and the deletion pairs of `lem:geometry-adapter`.
-/

@[expose] public section

noncomputable section

open CategoryTheory

universe u

namespace OrlikSolomon

open CoordinateRing

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V]
variable {H K : AffineSubspace k V} {f g : V →ᵃ[k] k}

/-! ### The ideal of a hyperplane in `O(V)` -/

section Quotient

/-- An equation of a hyperplane generates its ideal. This is `ker_pull_chart`, together with the
fact that an affine function vanishing on `H` is a multiple of `f`. -/
theorem IsEquation.ker_pull_chart (hf : IsEquation f H) :
    RingHom.ker (pull (chart H)) = Ideal.span {coord f} := by
  rw [OrlikSolomon.ker_pull_chart hf.isHyperplane.ne_bot]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨g, hg, rfl⟩
    obtain ⟨c, rfl⟩ := hf.exists_eq_smul hg
    rw [coord_smul_eq_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.subset_span ⟨f, fun x hx ↦ hf.apply_eq_zero_iff.2 hx, rfl⟩

/-- The coordinate ring of a hyperplane is the quotient of `O(V)` by any equation of it. There is no
choice of basis here. The map to the quotient corresponds to restriction: see `quotientEquiv_mk`.

Blueprint: `lem:restriction-geometry`. -/
def IsEquation.quotientEquiv (hf : IsEquation f H) :
    (CoordinateRing k V ⧸ Ideal.span {coord f}) ≃ₐ[k] CoordinateRing k H.direction :=
  (Ideal.quotientEquivAlgOfEq k hf.ker_pull_chart.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (pull_chart_surjective H))

@[simp]
theorem IsEquation.quotientEquiv_mk (hf : IsEquation f H) (x : CoordinateRing k V) :
    hf.quotientEquiv (Ideal.Quotient.mk _ x) = pull (chart H) x :=
  rfl

@[simp]
theorem IsEquation.quotientEquiv_symm_pull_chart (hf : IsEquation f H) (x : CoordinateRing k V) :
    hf.quotientEquiv.symm (pull (chart H) x) = Ideal.Quotient.mk _ x := by
  rw [AlgEquiv.symm_apply_eq, hf.quotientEquiv_mk]

end Quotient

namespace Arrangement

variable (𝒜 : Arrangement k V)

/-! ### Old hyperplanes on the restriction -/

variable {𝒜} in
/-- The preimage of an old hyperplane is empty or a hyperplane of the restriction. An empty
intersection with `H` gives the first case, and any other gives the second. -/
theorem covers_comap_chart (hH : IsHyperplane H) (hK : K ∈ 𝒜.deletion H) :
    (𝒜.restriction H).Covers (K.comap (chart H)) := by
  by_cases hbot : H ⊓ K = ⊥
  · exact Or.inl ((comap_chart_eq_bot_iff hH.ne_bot).2 hbot)
  · exact Or.inr (comap_chart_mem_restriction hH hK hbot)

variable {𝒜} in
/-- An affine function that is a unit on `U_𝒜'` restricts to one that is a unit on `U_𝒜''`. -/
theorem Covers.comp_chart (hH : IsHyperplane H) (hg : (𝒜.deletion H).Covers (zeroLocus g)) :
    (𝒜.restriction H).Covers (zeroLocus (g.comp (chart H))) := by
  rw [zeroLocus_comp]
  exact hg.comap fun _ hK ↦ covers_comap_chart hH hK

/-! ### The rings -/

namespace ComplementRing

/-- The restriction `i^* : O(U_𝒜') → O(U_𝒜'')`, the pullback along the closed immersion
`U_𝒜'' ≃ H ∩ U_𝒜' → U_𝒜'`. It is defined for any hyperplane `H`, which need not belong to `𝒜`, and
it does not depend on an equation of `H`.

Blueprint: `lem:restriction-geometry`. -/
def restriction (hH : IsHyperplane H) :
    (𝒜.deletion H).ComplementRing →ₐ[k] (𝒜.restriction H).ComplementRing :=
  map (chart H) _ _ fun _ hK ↦ covers_comap_chart hH hK

variable {𝒜}

@[simp]
theorem restriction_algebraMap (hH : IsHyperplane H) (x : CoordinateRing k V) :
    restriction 𝒜 hH (algebraMap _ _ x) = algebraMap _ _ (pull (chart H) x) :=
  map_algebraMap _ _ x

/-- Compatibility of quotient and localization, first half: `O(U_𝒜'')` is the localization of
`O(H.direction)` at the restrictions of the elements of `O(V)` inverted in `O(U_𝒜')`.

Blueprint: `lem:geometry-adapter`. -/
theorem isLocalization_restriction (hH : IsHyperplane H) :
    IsLocalization ((𝒜.deletion H).equationSubmonoid.map (pull (chart H)).toRingHom)
      (𝒜.restriction H).ComplementRing := by
  refine isLocalization_of_exists_dvd _ ?_ fun L hL ↦ ?_
  · rintro _ ⟨s, hs, rfl⟩
    have hu : IsUnit (algebraMap _ (𝒜.deletion H).ComplementRing s) :=
      IsLocalization.map_units _ (⟨s, hs⟩ : (𝒜.deletion H).equationSubmonoid)
    simpa using hu.map (restriction 𝒜 hH)
  · obtain ⟨K, hK, rfl⟩ := exists_representative hL
    have heq := isEquation_equation ((𝒜.deletion H).isHyperplane hK)
    have hz : zeroLocus ((equation K).comp (chart H)) = K.comap (chart H) := by
      rw [zeroLocus_comp, heq.zeroLocus_eq]
    refine ⟨(equation K).comp (chart H), hz ▸ isEquation_zeroLocus ?_, _,
      ⟨_, coord_mem_equationSubmonoid hK heq, rfl⟩, by simp⟩
    exact isHyperplane_zeroLocus_iff.1 (hz ▸ (𝒜.restriction H).isHyperplane hL)

/-- Compatibility of quotient and localization, second half: `i^*` is the localization of the
restriction `O(V) → O(H.direction)`.

Blueprint: `lem:geometry-adapter`. -/
theorem restriction_eq_map (hH : IsHyperplane H) :
    haveI := isLocalization_restriction (𝒜 := 𝒜) hH
    (restriction 𝒜 hH).toRingHom =
      IsLocalization.map (𝒜.restriction H).ComplementRing (pull (chart H)).toRingHom
        (Submonoid.le_comap_map (𝒜.deletion H).equationSubmonoid) := by
  have := isLocalization_restriction (𝒜 := 𝒜) hH
  refine IsLocalization.ringHom_ext (𝒜.deletion H).equationSubmonoid (RingHom.ext fun x ↦ ?_)
  simp

/-- The restriction `i^*` is surjective, so `U_𝒜''` is a closed subscheme of `U_𝒜'`. -/
theorem surjective_restriction (hH : IsHyperplane H) :
    Function.Surjective (restriction 𝒜 hH) := by
  have := isLocalization_restriction (𝒜 := 𝒜) hH
  have := IsLocalization.map_surjective_of_surjective
    (S := (𝒜.deletion H).ComplementRing) (Q := (𝒜.restriction H).ComplementRing)
    (M := (𝒜.deletion H).equationSubmonoid) (g := (pull (chart H)).toRingHom)
    (pull_chart_surjective H)
  rw [← restriction_eq_map hH] at this
  exact this

/-- The kernel of `i^*` is generated by any equation of `H`, so `U_𝒜''` is the zero locus of the
equation in `U_𝒜'`.

Blueprint: `lem:restriction-geometry`. -/
theorem ker_restriction (hH : IsHyperplane H) (hf : IsEquation f H) :
    RingHom.ker (restriction 𝒜 hH) =
      Ideal.span {algebraMap _ (𝒜.deletion H).ComplementRing (coord f)} := by
  have := isLocalization_restriction (𝒜 := 𝒜) hH
  have h := IsLocalization.ker_map (S := (𝒜.deletion H).ComplementRing)
    (Q := (𝒜.restriction H).ComplementRing) (M := (𝒜.deletion H).equationSubmonoid)
    (T := (𝒜.deletion H).equationSubmonoid.map (pull (chart H)).toRingHom)
    (g := (pull (chart H)).toRingHom) rfl
  have hker : RingHom.ker (pull (chart H)).toRingHom = Ideal.span {coord f} := hf.ker_pull_chart
  rw [hker, Ideal.map_span, Set.image_singleton, ← restriction_eq_map hH] at h
  exact h

variable (𝒜) in
/-- The ring of `D = H ∩ U_𝒜'` is the quotient of `O(U_𝒜')` by any equation of `H`, and it is the
ring of `U_𝒜''`.

Blueprint: `lem:restriction-geometry`. -/
def quotientEquiv (hf : IsEquation f H) :
    ((𝒜.deletion H).ComplementRing ⧸
        Ideal.span {algebraMap _ (𝒜.deletion H).ComplementRing (coord f)}) ≃ₐ[k]
      (𝒜.restriction H).ComplementRing :=
  (Ideal.quotientEquivAlgOfEq k (ker_restriction hf.isHyperplane hf).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (surjective_restriction hf.isHyperplane))

@[simp]
theorem quotientEquiv_mk (hf : IsEquation f H) (x : (𝒜.deletion H).ComplementRing) :
    quotientEquiv 𝒜 hf (Ideal.Quotient.mk _ x) = restriction 𝒜 hf.isHyperplane x :=
  rfl

/-- `O(U_𝒜)` is `O(U_𝒜')[1/f]`, for any equation `f` of `H ∈ 𝒜`, so `U_𝒜` is the complement of the
zero locus of `f` in `U_𝒜'`.

Blueprint: `lem:restriction-geometry`. -/
theorem isLocalizationAway_inclusion (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    letI : Algebra (𝒜.deletion H).ComplementRing 𝒜.ComplementRing :=
      (inclusion (𝒜.deletion_le H)).toRingHom.toAlgebra
    IsLocalization.Away (algebraMap _ (𝒜.deletion H).ComplementRing (coord f))
      𝒜.ComplementRing := by
  let : Algebra (𝒜.deletion H).ComplementRing 𝒜.ComplementRing :=
    (inclusion (𝒜.deletion_le H)).toRingHom.toAlgebra
  have : IsScalarTower (CoordinateRing k V) (𝒜.deletion H).ComplementRing 𝒜.ComplementRing :=
    .of_algebraMap_eq fun x ↦ (inclusion_algebraMap (𝒜.deletion_le H) x).symm
  have h1 := IsLocalization.isLocalization_of_submonoid_le (𝒜.deletion H).ComplementRing
    𝒜.ComplementRing (𝒜.deletion H).equationSubmonoid 𝒜.equationSubmonoid
    (equationSubmonoid_mono (𝒜.deletion_le H))
  set x : (𝒜.deletion H).ComplementRing := algebraMap _ _ (coord f)
  have hxu : IsUnit (algebraMap _ 𝒜.ComplementRing x) := by
    have := isUnit_coord_of_isEquation (𝒜 := 𝒜) hH hf
    rwa [IsScalarTower.algebraMap_apply (CoordinateRing k V) (𝒜.deletion H).ComplementRing
      𝒜.ComplementRing] at this
  refine isLocalization_of_isUnit_of_exists_dvd
    (𝒜.equationSubmonoid.map (algebraMap _ (𝒜.deletion H).ComplementRing))
    (Submonoid.powers x) ?_ ?_
  · rintro _ ⟨n, rfl⟩
    simpa using hxu.pow n
  · rintro _ ⟨s, hs, rfl⟩
    refine forall_mem_equationSubmonoid
      (p := fun y ↦ ∃ m ∈ Submonoid.powers x, algebraMap _ (𝒜.deletion H).ComplementRing y ∣ m)
      ⟨1, one_mem _, by simp⟩ ?_ ?_ ?_ hs
    · rintro _ _ ⟨a, ha, hya⟩ ⟨b, hb, hyb⟩
      exact ⟨a * b, mul_mem ha hb, by simpa using mul_dvd_mul hya hyb⟩
    · rintro _ _ h ⟨m, hm, hd⟩
      exact ⟨m, hm, (map_dvd _ h.symm.dvd).trans hd⟩
    · intro K hK
      by_cases hKH : K = H
      · subst hKH
        exact ⟨f, hf, x, Submonoid.mem_powers _, dvd_rfl⟩
      · have hK' : K ∈ 𝒜.deletion H := mem_deletion.2 ⟨hKH, hK⟩
        have heq := isEquation_equation (𝒜.isHyperplane hK)
        exact ⟨_, heq, 1, one_mem _, (isUnit_coord_of_isEquation hK' heq).dvd⟩

end ComplementRing

end Arrangement

/-! ### The maps of `SmoothAlg k` -/

namespace SmoothAlg

open Arrangement

section Maps

variable [FiniteDimensional k V] (𝒜 : Arrangement k V)

/-- The restriction `i^* : O(U_𝒜') ⟶ O(U_𝒜'')`, the pullback along the closed immersion
`U_𝒜'' ≃ H ∩ U_𝒜' → U_𝒜'`. It is defined for any hyperplane `H`, which need not belong to `𝒜`, and
it does not depend on an equation of `H`.

Blueprint: `lem:restriction-geometry`. -/
def complementRestriction (hH : IsHyperplane H) :
    complement (𝒜.deletion H) ⟶ complement (𝒜.restriction H) :=
  complementMap (chart H) _ _ fun _ hK ↦ covers_comap_chart hH hK

variable {𝒜}

@[simp] lemma complementRestriction_toComplement (hH : IsHyperplane H) (x : affineSpace k V) :
    complementRestriction 𝒜 hH (toComplement (𝒜.deletion H) x) =
      toComplement (𝒜.restriction H) (affinePull (chart H) x) :=
  complementMap_toComplement _ _ x

@[reassoc (attr := simp)]
lemma toComplement_comp_complementRestriction (hH : IsHyperplane H) :
    toComplement (𝒜.deletion H) ≫ complementRestriction 𝒜 hH =
      affinePull (chart H) ≫ toComplement (𝒜.restriction H) :=
  toComplement_comp_complementMap _ _

lemma surjective_complementRestriction (hH : IsHyperplane H) :
    Function.Surjective (complementRestriction 𝒜 hH) :=
  ComplementRing.surjective_restriction hH

/-- Any equation of `H` vanishes on the divisor. -/
lemma complementRestriction_toComplement_affineCoord (hH : IsHyperplane H) (hf : IsEquation f H) :
    complementRestriction 𝒜 hH (toComplement (𝒜.deletion H) (affineCoord f)) = 0 := by
  simp [hf.comp_chart_self]

/-! ### Restricting units -/

/-- The inclusion of a sub-arrangement carries the chosen equation of a hyperplane to itself. So
`j^*` of the unit of a hyperplane of `𝒜'` is the unit of the same hyperplane of `𝒜`, for chosen
equations as for any others, by `mapUnits_complementInclusion_complementUnit`. -/
@[simp] lemma mapUnits_complementInclusion_equationUnit {ℬ : Arrangement k V} (h : 𝒜 ≤ ℬ) (K : 𝒜) :
    mapUnits (complementInclusion h) (equationUnit 𝒜 K) = equationUnit ℬ (inclusion h K) :=
  mapUnits_complementInclusion_complementUnit h _

/-- The restriction of the unit of `g` is the unit of `g ∘ chart H`, for any affine function `g`
that is a unit on `U_𝒜'`. The lemmas below describe it without the base point.

Blueprint: `lem:restriction-geometry`. -/
@[simp] lemma mapUnits_complementRestriction_complementUnit (hH : IsHyperplane H)
    (hg : (𝒜.deletion H).Covers (zeroLocus g)) :
    mapUnits (complementRestriction 𝒜 hH) (complementUnit (𝒜.deletion H) g hg) =
      complementUnit (𝒜.restriction H) (g.comp (chart H)) (hg.comp_chart hH) :=
  mapUnits_complementMap_complementUnit _ _ hg

/-- The empty case: if an old hyperplane `K` does not meet `H`, then any equation of `K` restricts
to a nonzero constant.

Blueprint: `lem:restriction-geometry`. -/
lemma exists_mapUnits_complementRestriction_eq_constUnit (hH : IsHyperplane H)
    (hK : K ∈ 𝒜.deletion H) (hf : IsEquation f K) (hbot : H ⊓ K = ⊥) :
    ∃ c : kˣ, mapUnits (complementRestriction 𝒜 hH)
        (complementUnit (𝒜.deletion H) f (hf.covers hK)) =
      constUnit (complement (𝒜.restriction H)) c := by
  obtain ⟨c, hc⟩ := hf.exists_comp_chart_eq_const hH.ne_bot hbot
  refine ⟨c, ?_⟩
  rw [mapUnits_complementRestriction_complementUnit]
  simp only [hc, complementUnit_const]

/-- The retained case: if an old hyperplane `K` has trace `L` on `H`, then any equation of `K`
restricts to a nonzero constant times any given equation of `L`.

Blueprint: `lem:restriction-geometry`. -/
lemma exists_mapUnits_complementRestriction_eq_constUnit_mul (hH : IsHyperplane H)
    (hK : K ∈ 𝒜.deletion H) (hf : IsEquation f K) {L : AffineSubspace k H.direction}
    (hL : L ∈ 𝒜.restriction H) (hKL : K.comap (chart H) = L) {g : H.direction →ᵃ[k] k}
    (hg : IsEquation g L) :
    ∃ c : kˣ, mapUnits (complementRestriction 𝒜 hH)
        (complementUnit (𝒜.deletion H) f (hf.covers hK)) =
      constUnit (complement (𝒜.restriction H)) c *
        complementUnit (𝒜.restriction H) g (hg.covers hL) := by
  have hz : zeroLocus (f.comp (chart H)) = L := by
    rw [zeroLocus_comp, hf.zeroLocus_eq, hKL]
  have hf' : IsEquation (f.comp (chart H)) L :=
    ⟨isHyperplane_zeroLocus_iff.1 (hz ▸ (𝒜.restriction H).isHyperplane hL), hz⟩
  rw [mapUnits_complementRestriction_complementUnit]
  exact exists_complementUnit_eq_constUnit_mul hL hg hf'

/-- The form of `exists_mapUnits_complementRestriction_eq_constUnit_mul` for the chosen old
representative of a retained hyperplane, which is how `lem:restriction-surj` uses it.

Blueprint: `lem:restriction-geometry`. -/
lemma exists_mapUnits_complementRestriction_representative (hH : IsHyperplane H)
    (L : 𝒜.restriction H) (hf : IsEquation f (representative L : AffineSubspace k V))
    {g : H.direction →ᵃ[k] k} (hg : IsEquation g (L : AffineSubspace k H.direction)) :
    ∃ c : kˣ, mapUnits (complementRestriction 𝒜 hH)
        (complementUnit (𝒜.deletion H) f (hf.covers (representative L).2)) =
      constUnit (complement (𝒜.restriction H)) c *
        complementUnit (𝒜.restriction H) g (hg.covers L.2) :=
  exists_mapUnits_complementRestriction_eq_constUnit_mul hH (representative L).2 hf L.2
    (comap_representative L) hg

/-- The form of `exists_mapUnits_complementRestriction_eq_constUnit_mul` for the chosen equations of
a retained hyperplane and of its chosen old representative. -/
lemma exists_mapUnits_complementRestriction_equationUnit_representative (hH : IsHyperplane H)
    (L : 𝒜.restriction H) :
    ∃ c : kˣ, mapUnits (complementRestriction 𝒜 hH)
        (equationUnit (𝒜.deletion H) (representative L)) =
      constUnit (complement (𝒜.restriction H)) c * equationUnit (𝒜.restriction H) L :=
  exists_mapUnits_complementRestriction_representative hH L
    (isEquation_equation ((𝒜.deletion H).isHyperplane (representative L).2))
    (isEquation_equation ((𝒜.restriction H).isHyperplane L.2))

/-- The duplicate case: two old hyperplanes with the same intersection with `H` restrict to the same
unit up to a nonzero constant, for any of their equations. This includes the case of an empty
intersection.

Blueprint: `lem:restriction-geometry`. -/
lemma exists_mapUnits_complementRestriction_eq_constUnit_mul_of_inf_eq (hH : IsHyperplane H)
    {K₁ K₂ : AffineSubspace k V} (hK₁ : K₁ ∈ 𝒜.deletion H) (hK₂ : K₂ ∈ 𝒜.deletion H)
    {f₁ f₂ : V →ᵃ[k] k} (hf₁ : IsEquation f₁ K₁) (hf₂ : IsEquation f₂ K₂) (h : H ⊓ K₁ = H ⊓ K₂) :
    ∃ c : kˣ,
      mapUnits (complementRestriction 𝒜 hH) (complementUnit (𝒜.deletion H) f₁ (hf₁.covers hK₁)) =
        constUnit (complement (𝒜.restriction H)) c *
          mapUnits (complementRestriction 𝒜 hH)
            (complementUnit (𝒜.deletion H) f₂ (hf₂.covers hK₂)) := by
  by_cases hbot : H ⊓ K₁ = ⊥
  · obtain ⟨c₁, hc₁⟩ := exists_mapUnits_complementRestriction_eq_constUnit hH hK₁ hf₁ hbot
    obtain ⟨c₂, hc₂⟩ := exists_mapUnits_complementRestriction_eq_constUnit hH hK₂ hf₂ (h ▸ hbot)
    exact ⟨c₁ * c₂⁻¹, by simp [hc₁, hc₂]⟩
  · have hK := (comap_chart_eq_comap_chart_iff hH.ne_bot).2 h
    have hL := comap_chart_mem_restriction hH hK₁ hbot
    have hg : IsEquation (f₂.comp (chart H)) (K₁.comap (chart H)) := by
      have hz : zeroLocus (f₂.comp (chart H)) = K₁.comap (chart H) := by
        rw [zeroLocus_comp, hf₂.zeroLocus_eq, hK]
      exact ⟨isHyperplane_zeroLocus_iff.1 (hz ▸ (𝒜.restriction H).isHyperplane hL), hz⟩
    obtain ⟨c, hc⟩ :=
      exists_mapUnits_complementRestriction_eq_constUnit_mul hH hK₁ hf₁ hL rfl hg
    exact ⟨c, by rw [hc, mapUnits_complementRestriction_complementUnit]⟩

/-- An old hyperplane restricts to a nonzero constant, or to a nonzero constant times the unit of
the chosen equation of its retained hyperplane. This is `IsEquation.comp_chart_eq_const_or_smul` on
units.

Blueprint: `lem:restriction-geometry`. -/
lemma mapUnits_complementRestriction_eq_constUnit_or (hH : IsHyperplane H)
    (hK : K ∈ 𝒜.deletion H) (hf : IsEquation f K) :
    (∃ c : kˣ, mapUnits (complementRestriction 𝒜 hH)
        (complementUnit (𝒜.deletion H) f (hf.covers hK)) =
          constUnit (complement (𝒜.restriction H)) c) ∨
      ∃ hL : K.comap (chart H) ∈ 𝒜.restriction H, ∃ c : kˣ,
        mapUnits (complementRestriction 𝒜 hH) (complementUnit (𝒜.deletion H) f (hf.covers hK)) =
          constUnit (complement (𝒜.restriction H)) c * equationUnit (𝒜.restriction H) ⟨_, hL⟩ := by
  by_cases hbot : H ⊓ K = ⊥
  · exact Or.inl (exists_mapUnits_complementRestriction_eq_constUnit hH hK hf hbot)
  · have hL := comap_chart_mem_restriction hH hK hbot
    exact Or.inr ⟨hL, exists_mapUnits_complementRestriction_eq_constUnit_mul hH hK hf hL rfl
      (isEquation_equation ((𝒜.restriction H).isHyperplane hL))⟩

end Maps

end SmoothAlg

/-! ### The deletion pair -/

namespace DivisorPair

open Arrangement SmoothAlg

variable [FiniteDimensional k V] (𝒜 : Arrangement k V)

/-- The deletion pair `(O(U_𝒜'), O(U_𝒜''), O(U_𝒜), f_H)` of a hyperplane `H` of `𝒜`, for any
equation `f_H` of `H`. Its schemes are `X = U_𝒜'`, `D = H ∩ X ≃ U_𝒜''` and `U = X ∖ D = U_𝒜`, and it
is the pullback of the standard pair `{0} ⊂ 𝔸¹` along `f_H`, by `DivisorPair.fromStandard`.

Only `eqn` depends on the equation: see `deletionPairHom`.

Blueprint: `lem:restriction-geometry`, `lem:geometry-adapter`. -/
def deletionPair (hH : H ∈ 𝒜) (hf : IsEquation f H) : DivisorPair k where
  ambient := complement (𝒜.deletion H)
  closed := complement (𝒜.restriction H)
  compl := complement 𝒜
  i := complementRestriction 𝒜 (𝒜.isHyperplane hH)
  j := complementInclusion (𝒜.deletion_le H)
  eqn := toComplement (𝒜.deletion H) (affineCoord f)
  surjective_i := surjective_complementRestriction (𝒜.isHyperplane hH)
  ker_i := ComplementRing.ker_restriction (𝒜.isHyperplane hH) hf
  isLocalization_j := ComplementRing.isLocalizationAway_inclusion hH hf
  eqn_mem_nonZeroDivisors := mem_nonZeroDivisors_of_ne_zero fun h0 ↦ hf.coord_ne_zero <|
    toComplement_injective (h0.trans (map_zero _).symm)

variable (hH : H ∈ 𝒜) (hf : IsEquation f H)

lemma deletionPair_ambient : (deletionPair 𝒜 hH hf).ambient = complement (𝒜.deletion H) := rfl
lemma deletionPair_closed : (deletionPair 𝒜 hH hf).closed = complement (𝒜.restriction H) := rfl
lemma deletionPair_compl : (deletionPair 𝒜 hH hf).compl = complement 𝒜 := rfl

lemma deletionPair_i :
    (deletionPair 𝒜 hH hf).i = complementRestriction 𝒜 (𝒜.isHyperplane hH) := rfl

lemma deletionPair_j : (deletionPair 𝒜 hH hf).j = complementInclusion (𝒜.deletion_le H) := rfl

lemma deletionPair_eqn :
    (deletionPair 𝒜 hH hf).eqn = toComplement (𝒜.deletion H) (affineCoord f) := rfl

/-- The equation unit of the pair is the unit of `f` on `U_𝒜`.

Blueprint: `lem:log-residue`. -/
lemma deletionPair_eqnUnit :
    (deletionPair 𝒜 hH hf).eqnUnit = complementUnit 𝒜 f (hf.covers hH) :=
  Units.ext (complementInclusion_toComplement (𝒜.deletion_le H) (affineCoord f))

/-- The deletion pair is pulled back from `{0} ⊂ 𝔸¹` along `f_H`: on open parts, the map
`fromStandard` is the one attached to the unit of `f` on `U_𝒜`.

Blueprint: `lem:restriction-geometry`. -/
lemma fromStandard_deletionPair_compl :
    (fromStandard (deletionPair 𝒜 hH hf)).compl = gmHom (complementUnit 𝒜 f (hf.covers hH)) :=
  (fromStandard_compl _).trans (congrArg gmHom (deletionPair_eqnUnit 𝒜 hH hf))

/-- The transverse morphism between the deletion pairs of two equations of `H`. It is the identity
on all three rings, since two equations differ by a unit, so the residue and Gysin maps of a theory
do not depend on the equation.

Blueprint: `lem:restriction-geometry`. -/
def deletionPairHom (hf : IsEquation f H) (hg : IsEquation g H) :
    deletionPair 𝒜 hH hf ⟶ deletionPair 𝒜 hH hg where
  ambient := 𝟙 (complement (𝒜.deletion H))
  closed := 𝟙 (complement (𝒜.restriction H))
  compl := 𝟙 (complement 𝒜)
  i_comp := (Category.comp_id _).trans (Category.id_comp _).symm
  j_comp := (Category.comp_id _).trans (Category.id_comp _).symm
  associated_eqn := (hf.associated_coord hg).map (algHom (toComplement (𝒜.deletion H)))

@[simp] lemma deletionPairHom_ambient (hg : IsEquation g H) :
    (deletionPairHom 𝒜 hH hf hg).ambient = 𝟙 (complement (𝒜.deletion H)) := rfl

@[simp] lemma deletionPairHom_closed (hg : IsEquation g H) :
    (deletionPairHom 𝒜 hH hf hg).closed = 𝟙 (complement (𝒜.restriction H)) := rfl

@[simp] lemma deletionPairHom_compl (hg : IsEquation g H) :
    (deletionPairHom 𝒜 hH hf hg).compl = 𝟙 (complement 𝒜) := rfl

end DivisorPair

end OrlikSolomon
