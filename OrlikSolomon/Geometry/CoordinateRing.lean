/-!
# The coordinate ring of a vector space

This file defines the coordinate ring `O(V)` of the affine space of a vector space `V`, as the
symmetric algebra of the dual of `V`, with the elements attached to affine functions and the maps
attached to affine maps. Everything is coordinate free and refers to universal properties, except
for smoothness and for the comparison with iterated polynomial rings. Complements of arrangements
are in `OrlikSolomon/Geometry/Complement.lean`.

Functions on `V` are not functions on the set `V`, since `k` may be finite: this ring is never
compared with functions on `k`-points. Affine functions, however, are determined by their values on
`k`-points (`CoordinateRing.coord_injective`), and this is how far linear algebra over `k` reaches.

## Main definitions

* `OrlikSolomon.CoordinateRing k V`: the ring `O(V)`.
* `CoordinateRing.coord`: the element of `O(V)` attached to an affine function, as a linear map.
* `CoordinateRing.pull`: the map `O(V) →ₐ[k] O(W)` attached to an affine map `W → V`.
* `CoordinateRing.liftAffine`: maps out of `O(V)` are linear maps on affine functions preserving
  `1`.
* `CoordinateRing.fraction`: the map `v ↦ G v / u` given by an affine map `G` and a unit `u`, which
  is how maps that are not affine are defined.
* `OrlikSolomon.liftChart`: maps out of `O(X.direction)` are maps out of `O(V)` killing the affine
  functions that vanish on `X`.
* `SmoothAlg.affineSpace k V`: the object `O(V)` of `SmoothAlg k`, with `SmoothAlg.affineCoord` and
  `SmoothAlg.affinePull`.
* `SmoothAlg.iteratedPolynomial k n`: the ring `k[t₁][t₂]⋯[tₙ]`.

## Main results

* `CoordinateRing.pull_coord`, `CoordinateRing.pull_id`, `CoordinateRing.pull_comp`: `pull` is
  functorial, and it sends the element of `f` to the element of `f ∘ φ`.
* `CoordinateRing.smooth_coordinateRing`: `O(V)` is smooth.
* `OrlikSolomon.ker_pull_chart`: the kernel of restriction to a nonempty affine subspace `X` is
  generated by the affine functions vanishing on `X`.
* `IsEquation.exists_coord_eq_mul`: two equations of a hyperplane differ by a unit of `k`.
* `SmoothAlg.affineSpaceIso`: `O(V)` is an iterated polynomial ring, of length `finrank k V`.

## Blueprint

Part of `lem:geometry-adapter`: affine coordinate changes, and the maps to affine images.
-/

@[expose] public section

noncomputable section

open CategoryTheory Module

universe u

namespace OrlikSolomon

section CoordinateRing

variable (k : Type*) [CommRing k] (V : Type*) [AddCommGroup V] [Module k V]

/-- The coordinate ring `O(V)` of the affine space of a `k`-module `V`: the symmetric algebra of its
dual. For a finite-dimensional vector space it is a polynomial ring, in any coordinates. -/
abbrev CoordinateRing : Type _ := SymmetricAlgebra k (Dual k V)

namespace CoordinateRing

variable {k V}
variable {W U : Type*} [AddCommGroup W] [Module k W] [AddCommGroup U] [Module k U]
variable {B : Type*} [CommRing B] [Algebra k B]

/-- The element of `O(V)` attached to an affine function `f`, namely `ι f.linear + f 0`. It is
`k`-linear in `f`, so `map_add`, `map_sub`, `map_smul` and `map_sum` apply to it. -/
def coord : (V →ᵃ[k] k) →ₗ[k] CoordinateRing k V where
  toFun f := SymmetricAlgebra.ι k _ f.linear + algebraMap k _ (f 0)
  map_add' f g := by simp [add_add_add_comm]
  map_smul' c f := by simp [Algebra.smul_def, mul_add]

theorem coord_apply (f : V →ᵃ[k] k) :
    coord f = SymmetricAlgebra.ι k _ f.linear + algebraMap k _ (f 0) :=
  rfl

theorem coord_toAffineMap (ℓ : Dual k V) : coord ℓ.toAffineMap = SymmetricAlgebra.ι k _ ℓ := by
  simp [coord_apply]

@[simp]
theorem coord_const (c : k) : coord (AffineMap.const k V c) = algebraMap k _ c := by
  simp [coord_apply]

/-- Scaling an affine function by `c` multiplies its element by the constant `c`. -/
theorem coord_smul_eq_mul (c : k) (f : V →ᵃ[k] k) :
    coord (c • f) = algebraMap k _ c * coord f := by
  rw [map_smul, Algebra.smul_def]

/-- An affine function is the sum of its linear part and its value at zero. -/
theorem eq_toAffineMap_add_const (f : V →ᵃ[k] k) :
    f = f.linear.toAffineMap + AffineMap.const k V (f 0) := by
  ext v
  simpa using congrFun f.decomp v

/-- Precomposition with an affine map, as a linear map on affine functions. -/
def precomp (φ : W →ᵃ[k] V) : (V →ᵃ[k] k) →ₗ[k] (W →ᵃ[k] k) where
  toFun f := f.comp φ
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp]
theorem precomp_apply (φ : W →ᵃ[k] V) (f : V →ᵃ[k] k) : precomp φ f = f.comp φ :=
  rfl

theorem precomp_const (φ : W →ᵃ[k] V) (c : k) :
    precomp φ (AffineMap.const k V c) = AffineMap.const k W c :=
  rfl

/-- A linear form as an affine function, linearly in the form. -/
def dualToAffine : Dual k V →ₗ[k] (V →ᵃ[k] k) where
  toFun ℓ := ℓ.toAffineMap
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp]
theorem dualToAffine_apply (ℓ : Dual k V) : dualToAffine ℓ = ℓ.toAffineMap :=
  rfl

/-- A linear map on affine functions preserving `1` preserves all constants. -/
theorem map_const_of_map_one (F : (V →ᵃ[k] k) →ₗ[k] B) (hF : F (AffineMap.const k V 1) = 1)
    (c : k) : F (AffineMap.const k V c) = algebraMap k B c := by
  have : AffineMap.const k V c = c • AffineMap.const k V (1 : k) := by
    ext
    simp
  rw [this, map_smul, hF, Algebra.algebraMap_eq_smul_one]

/-- The universal property of `O(V)`: `k`-algebra maps out of it are the same thing as `k`-linear
maps on affine functions preserving the constant function `1`. -/
def liftAffine :
    {F : (V →ᵃ[k] k) →ₗ[k] B // F (AffineMap.const k V 1) = 1} ≃ (CoordinateRing k V →ₐ[k] B) where
  toFun F := SymmetricAlgebra.lift (F.1 ∘ₗ dualToAffine)
  invFun g := ⟨g.toLinearMap ∘ₗ coord, by simp⟩
  left_inv F := Subtype.ext <| LinearMap.ext fun f ↦ by
    conv_rhs => rw [eq_toAffineMap_add_const f]
    simp [coord_apply, map_const_of_map_one F.1 F.2]
  right_inv g := SymmetricAlgebra.algHom_ext <| LinearMap.ext fun ℓ ↦ by simp [coord_toAffineMap]

@[simp]
theorem liftAffine_coord (F : {F : (V →ᵃ[k] k) →ₗ[k] B // F (AffineMap.const k V 1) = 1})
    (f : V →ᵃ[k] k) : liftAffine F (coord f) = F.1 f := by
  conv_rhs => rw [← liftAffine.symm_apply_apply F]
  rfl

/-- `k`-algebra maps out of `O(V)` agree if they agree on all affine functions. -/
theorem algHom_ext {φ ψ : CoordinateRing k V →ₐ[k] B}
    (h : ∀ f : V →ᵃ[k] k, φ (coord f) = ψ (coord f)) : φ = ψ :=
  SymmetricAlgebra.algHom_ext <| LinearMap.ext fun ℓ ↦ by
    simpa [coord_toAffineMap] using h ℓ.toAffineMap

/-- Pullback of functions along an affine map `φ : W → V`. It sends the element of `f` to that of
`f ∘ φ`, by `pull_coord`. -/
def pull (φ : W →ᵃ[k] V) : CoordinateRing k V →ₐ[k] CoordinateRing k W :=
  liftAffine ⟨coord ∘ₗ precomp φ, by
    rw [LinearMap.comp_apply, precomp_const, coord_const, map_one]⟩

@[simp]
theorem pull_coord (φ : W →ᵃ[k] V) (f : V →ᵃ[k] k) : pull φ (coord f) = coord (f.comp φ) :=
  liftAffine_coord _ f

@[simp]
theorem pull_id : pull (AffineMap.id k V) = AlgHom.id k (CoordinateRing k V) :=
  algHom_ext fun f ↦ by simp

theorem pull_comp (φ : W →ᵃ[k] V) (ψ : U →ᵃ[k] W) :
    pull (φ.comp ψ) = (pull ψ).comp (pull φ) :=
  algHom_ext fun f ↦ by simp [AffineMap.comp_assoc]

@[simp]
theorem pull_pull (φ : W →ᵃ[k] V) (ψ : U →ᵃ[k] W) (x : CoordinateRing k V) :
    pull ψ (pull φ x) = pull (φ.comp ψ) x := by
  rw [pull_comp, AlgHom.comp_apply]

/-- Evaluation of functions at a `k`-point of `V`. Elements of `O(V)` are not determined by their
values at points, as `k` may be finite, but affine functions are: see `coord_injective`. -/
def eval (v : V) : CoordinateRing k V →ₐ[k] k :=
  liftAffine
    ⟨{ toFun := fun f ↦ f v
       map_add' := fun _ _ ↦ rfl
       map_smul' := fun _ _ ↦ rfl }, rfl⟩

@[simp]
theorem eval_coord (v : V) (f : V →ᵃ[k] k) : eval v (coord f) = f v :=
  liftAffine_coord _ f

@[simp]
theorem eval_pull (φ : W →ᵃ[k] V) (w : W) (x : CoordinateRing k V) :
    eval w (pull φ x) = eval (φ w) x :=
  congr($(show (eval w).comp (pull φ) = eval (φ w) from algHom_ext fun f ↦ by simp) x)

/-- An affine function is determined by its element of `O(V)`. -/
theorem coord_injective : Function.Injective (coord : (V →ᵃ[k] k) → CoordinateRing k V) :=
  fun f g h ↦ AffineMap.ext fun v ↦ by simpa using congr(eval v $h)

@[simp]
theorem coord_inj {f g : V →ᵃ[k] k} : coord f = coord g ↔ f = g :=
  coord_injective.eq_iff

@[simp]
theorem coord_eq_zero {f : V →ᵃ[k] k} : coord f = 0 ↔ f = 0 := by
  rw [← map_zero coord, coord_inj]

/-- The coordinate ring of a finite free module is smooth, as it is a polynomial ring in any basis
of the dual. -/
instance smooth_coordinateRing [Module.Free k V] [Module.Finite k V] :
    Algebra.Smooth k (CoordinateRing k V) :=
  have : Algebra.Smooth k (MvPolynomial (Module.Free.ChooseBasisIndex k (Dual k V)) k) := {}
  .of_equiv (SymmetricAlgebra.equivMvPolynomial (Module.Free.chooseBasis k (Dual k V))).symm

/-- The map `v ↦ G v / u` to `W`, where `φ : O(V) → B` describes a map to `V`, the map `G : V → W`
is affine, and `u` is a unit of `B`. On a linear form `ℓ` of `W` it is the fraction `(ℓ ∘ G) / u`,
and it keeps the constant term of an affine function: see `fraction_coord` and
`fraction_coord_mul`. This is how to define regular maps that are not affine, such as
`v ↦ (f₁ v / f₀ v, …, fₛ v / f₀ v)`, and no `k`-points are involved. -/
def fraction (φ : CoordinateRing k V →ₐ[k] B) (G : V →ᵃ[k] W) (u : Bˣ) :
    CoordinateRing k W →ₐ[k] B :=
  SymmetricAlgebra.lift
    (LinearMap.mulRight k ((u⁻¹ : Bˣ) : B) ∘ₗ φ.toLinearMap ∘ₗ coord ∘ₗ precomp G ∘ₗ dualToAffine)

@[simp]
theorem fraction_coord (φ : CoordinateRing k V →ₐ[k] B) (G : V →ᵃ[k] W) (u : Bˣ) (g : W →ᵃ[k] k) :
    fraction φ G u (coord g) =
      φ (coord (g.linear.toAffineMap.comp G)) * ((u⁻¹ : Bˣ) : B) + algebraMap k B (g 0) := by
  simp [fraction, coord_apply]

/-- If the denominator `u` is the image of an affine function `u₀`, then the value of `g` on `G / u`
is the value on `G` of the homogenization `g.linear + g 0 • u₀` of `g`, divided by `u`. In
particular the map kills the element of `g` if this homogenization vanishes on the image of `G`. -/
theorem fraction_coord_mul (φ : CoordinateRing k V →ₐ[k] B) (G : V →ᵃ[k] W) {u₀ : V →ᵃ[k] k}
    (u : Bˣ) (hu : (u : B) = φ (coord u₀)) (g : W →ᵃ[k] k) :
    fraction φ G u (coord g) * u = φ (coord (g.linear.toAffineMap.comp G + g 0 • u₀)) := by
  rw [fraction_coord, add_mul, mul_assoc, Units.inv_mul, mul_one, map_add, map_add, map_smul,
    map_smul, ← hu, Algebra.smul_def]

end CoordinateRing

end CoordinateRing

open CoordinateRing

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V]
variable {W : Type u} [AddCommGroup W] [Module k W] {U : Type u} [AddCommGroup U] [Module k U]

/-! ### Restricting functions to an affine subspace -/

section Chart

variable {X : AffineSubspace k V} {B : Type*} [CommRing B] [Algebra k B]

/-- Restriction of functions to an affine subspace is surjective, since `chart X` has a retraction.
-/
theorem pull_chart_surjective (X : AffineSubspace k V) :
    Function.Surjective (pull (chart X)) := fun y ↦ by
  obtain ⟨r, hr⟩ := exists_retraction X
  exact ⟨pull r y, by simp [hr]⟩

/-- The universal property of the coordinate ring of a nonempty affine subspace `X`: `k`-algebra
maps out of `O(X)` are the same thing as `k`-algebra maps out of `O(V)` killing every affine
function that vanishes on `X`. So a map to `X` can be defined by a map to `V` satisfying the linear
equations of `X`, without testing anything on points.

The inverse direction is composition with `pull (chart X)`: see `liftChart_pull_chart`. -/
def liftChart (hX : X ≠ ⊥) :
    {g : CoordinateRing k V →ₐ[k] B // ∀ f : V →ᵃ[k] k, (∀ x ∈ X, f x = 0) → g (coord f) = 0} ≃
      (CoordinateRing k X.direction →ₐ[k] B) where
  toFun g := g.1.comp (pull (Classical.choose (exists_retraction X)))
  invFun φ := ⟨φ.comp (pull (chart X)), fun f hf ↦ by
    have : f.comp (chart X) = 0 := AffineMap.ext fun v ↦ hf _ (chart_mem hX v)
    simp [this]⟩
  left_inv g := Subtype.ext <| algHom_ext fun f ↦ by
    have hr := Classical.choose_spec (exists_retraction X)
    set r := Classical.choose (exists_retraction X)
    have h0 := g.2 (f - (f.comp (chart X)).comp r) fun x hx ↦ by
      simp [chart_apply_of_comp_eq_id hr hx]
    rw [map_sub, map_sub, sub_eq_zero] at h0
    simpa using h0.symm
  right_inv φ := algHom_ext fun f ↦ by
    have hr := Classical.choose_spec (exists_retraction X)
    simp [AffineMap.comp_assoc, hr]

@[simp]
theorem liftChart_pull_chart (hX : X ≠ ⊥)
    (g : {g : CoordinateRing k V →ₐ[k] B // ∀ f : V →ᵃ[k] k, (∀ x ∈ X, f x = 0) → g (coord f) = 0})
    (x : CoordinateRing k V) : liftChart hX g (pull (chart X) x) = g.1 x := by
  conv_rhs => rw [← (liftChart hX).symm_apply_apply g]
  rfl

/-- The ideal of a nonempty affine subspace `X` is generated by the affine functions vanishing on
it. For `X` a hyperplane, `IsEquation.exists_eq_smul` reduces this to a single equation, which gives
`O(V) ⧸ (f) ≃ₐ[k] O(X.direction)` with no choice of basis. -/
theorem ker_pull_chart (hX : X ≠ ⊥) :
    RingHom.ker (pull (chart X)) = Ideal.span (coord '' {f : V →ᵃ[k] k | ∀ x ∈ X, f x = 0}) := by
  apply le_antisymm
  · intro x hx
    let π := Ideal.Quotient.mkₐ k (Ideal.span (coord '' {f : V →ᵃ[k] k | ∀ x ∈ X, f x = 0}))
    have hπ : ∀ f : V →ᵃ[k] k, (∀ x ∈ X, f x = 0) → π (coord f) = 0 := fun f hf ↦
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨f, hf, rfl⟩)
    have := liftChart_pull_chart hX ⟨π, hπ⟩ x
    rw [show pull (chart X) x = 0 from hx, map_zero] at this
    exact Ideal.Quotient.eq_zero_iff_mem.1 this.symm
  · rw [Ideal.span_le]
    rintro _ ⟨f, hf, rfl⟩
    have : f.comp (chart X) = 0 := AffineMap.ext fun v ↦ hf _ (chart_mem hX v)
    simp [RingHom.mem_ker, this]

end Chart

/-! ### Equations in the coordinate ring -/

section Equations

variable {f g : V →ᵃ[k] k} {H : AffineSubspace k V}

/-- An equation of a hyperplane is a nonzero element of `O(V)`. -/
theorem IsEquation.coord_ne_zero (hf : IsEquation f H) : coord f ≠ 0 := by
  rw [Ne, coord_eq_zero]
  rintro rfl
  exact hf.linear_ne_zero (by simp)

/-- Two equations for the same hyperplane differ in `O(V)` by a nonzero constant. -/
theorem IsEquation.exists_coord_eq_mul (hf : IsEquation f H) (hg : IsEquation g H) :
    ∃ c : kˣ, coord g = algebraMap k _ (c : k) * coord f := by
  obtain ⟨c, rfl, -⟩ := hf.existsUnique_smul hg
  exact ⟨c, coord_smul_eq_mul _ _⟩

/-- Two equations for the same hyperplane are associated in `O(V)`. -/
theorem IsEquation.associated_coord (hf : IsEquation f H) (hg : IsEquation g H) :
    Associated (coord f) (coord g) := by
  obtain ⟨c, hc⟩ := hf.exists_coord_eq_mul hg
  rw [hc]
  exact (associated_unit_mul_left _ _ (c.isUnit.map (algebraMap k (CoordinateRing k V)))).symm

/-- An affine function with empty zero locus is a nonzero constant, hence a unit of `O(V)`. -/
theorem isUnit_coord_of_zeroLocus_eq_bot (hf : zeroLocus f = ⊥) : IsUnit (coord f) := by
  obtain ⟨c, rfl⟩ := zeroLocus_eq_bot_iff.1 hf
  rw [coord_const]
  exact c.isUnit.map (algebraMap k _)

end Equations

/-! ### The object of `SmoothAlg k` -/

namespace SmoothAlg

variable [FiniteDimensional k V] [FiniteDimensional k W] [FiniteDimensional k U] {B : SmoothAlg k}

variable (k V) in
/-- The coordinate ring `O(V)` as an object of `SmoothAlg k`, for finite-dimensional `V`. -/
def affineSpace : SmoothAlg k := of k (CoordinateRing k V)

/-- The element of `O(V)` attached to an affine function. -/
def affineCoord (f : V →ᵃ[k] k) : affineSpace k V := coord f

lemma affineCoord_eq (f : V →ᵃ[k] k) : affineCoord f = (coord f : CoordinateRing k V) := rfl

/-- The pullback `O(V) ⟶ O(W)` along an affine map `W → V`. -/
def affinePull (φ : W →ᵃ[k] V) : affineSpace k V ⟶ affineSpace k W := ofHom (pull φ)

lemma affinePull_apply (φ : W →ᵃ[k] V) (x : CoordinateRing k V) :
    affinePull φ x = (pull φ x : CoordinateRing k W) := rfl

@[simp] lemma affinePull_affineCoord (φ : W →ᵃ[k] V) (f : V →ᵃ[k] k) :
    affinePull φ (affineCoord f) = affineCoord (f.comp φ) :=
  pull_coord φ f

/-- Maps out of `O(V)` agree if they agree on all affine functions. -/
lemma affineSpace_hom_ext {f g : affineSpace k V ⟶ B}
    (h : ∀ a : V →ᵃ[k] k, f (affineCoord a) = g (affineCoord a)) : f = g :=
  ConcreteCategory.ext (CoordinateRing.algHom_ext h)

@[simp] lemma affinePull_id : affinePull (AffineMap.id k V) = 𝟙 (affineSpace k V) := by
  apply affineSpace_hom_ext
  simp

@[reassoc]
lemma affinePull_comp (φ : W →ᵃ[k] V) (ψ : U →ᵃ[k] W) :
    affinePull (φ.comp ψ) = affinePull φ ≫ affinePull ψ := by
  apply affineSpace_hom_ext
  simp [AffineMap.comp_assoc]

/-! ### Iterated polynomial rings -/

variable (k) in
/-- The coordinate ring of `𝔸ⁿ`, as the `n`-fold iterated polynomial ring over `k`. Affine-line
invariance applies to it one variable at a time. -/
def iteratedPolynomial : ℕ → SmoothAlg k
  | 0 => point k
  | n + 1 => polynomial (iteratedPolynomial n)

@[simp] lemma iteratedPolynomial_zero : iteratedPolynomial k 0 = point k := rfl

@[simp] lemma iteratedPolynomial_succ (n : ℕ) :
    iteratedPolynomial k (n + 1) = polynomial (iteratedPolynomial k n) := rfl

variable (k) in
/-- The iterated polynomial ring is the polynomial ring in `n` variables. -/
def mvPolynomialEquivIteratedPolynomial :
    (n : ℕ) → MvPolynomial (Fin n) k ≃ₐ[k] iteratedPolynomial k n
  | 0 => MvPolynomial.isEmptyAlgEquiv k (Fin 0)
  | n + 1 => (MvPolynomial.finSuccEquiv k n).trans
      (Polynomial.mapAlgEquiv (mvPolynomialEquivIteratedPolynomial n))

variable (k V) in
/-- The coordinate ring of a vector space of dimension `n` is the `n`-fold iterated polynomial ring.
This isomorphism depends on a choice of basis of the dual, so it is only for statements that do not
see the choice, such as those about the map from `point k`, which is unique. -/
def affineSpaceIso : affineSpace k V ≅ iteratedPolynomial k (finrank k V) :=
  isoOfAlgEquiv <| (SymmetricAlgebra.equivMvPolynomial
    (Module.finBasisOfFinrankEq k (Dual k V) Subspace.dual_finrank_eq)).trans
      (mvPolynomialEquivIteratedPolynomial k (finrank k V))

/-- A property of smooth algebras that holds for the point, passes from `A` to `A[t]`, and is
invariant under isomorphism, holds for `O(V)` for every finite-dimensional `V`. -/
theorem affineSpace_induction {motive : SmoothAlg k → Prop} (point : motive (point k))
    (polynomial : ∀ A, motive A → motive (polynomial A))
    (iso : ∀ {A B : SmoothAlg k}, (A ≅ B) → motive A → motive B)
    (V : Type u) [AddCommGroup V] [Module k V] [FiniteDimensional k V] :
    motive (affineSpace k V) := by
  have hiter : ∀ n, motive (iteratedPolynomial k n) := by
    intro n
    induction n with
    | zero => exact point
    | succ n ih => exact polynomial _ ih
  exact iso (affineSpaceIso k V).symm (hiter _)

end SmoothAlg

end OrlikSolomon
