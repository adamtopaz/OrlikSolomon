module

public import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
public import OrlikSolomon.Algebra.SymmetricGrading
public import OrlikSolomon.Geometry.Complement
public import OrlikSolomon.Geometry.ProjectiveArrangement

/-!
# The coordinate ring of a projective complement

This file defines the coordinate ring `O(U_P)` of the complement of a projective arrangement `P`, as
the degree-zero part of the ring `O(V_P)` of the complement of the central cone. It involves no
hyperplane at infinity and no choice of equations. The isomorphisms with the decone complement and
with the product `U_P × 𝔾ₘ` are in `OrlikSolomon/Geometry/Projective.lean`, and the comparison with
the complement in Mathlib's `Proj` is in `OrlikSolomon/Geometry/ProjectiveScheme.lean`.

## Main definitions

* `ProjectiveArrangement.ComplementRing P`: the ring `O(U_P)`.
* `ComplementRing.toCone`: the inclusion `O(U_P) → O(V_P)`, the pullback along `V_P → U_P`.
* `ComplementRing.mk`: the fraction `a / b`, for `a` and `b` of the same degree.
* `ComplementRing.ratio`: the fraction `ξ / ℓ` of a linear form and an equation.
* `ComplementRing.ratioUnit`: the unit `ℓ / ℓ'` of `O(U_P)` given by two equations.
* `ComplementRing.dehomogenize`: for an equation `ℓ₀`, the map `O(W) → O(U_P)` sending a linear form
  `ξ` to `ξ / ℓ₀`.

## Main results

* `ComplementRing.mem_range_toCone_iff`: `O(U_P)` is the set of fractions of the same degree.
* `ComplementRing.algebraMap_pow_mul_toCone_dehomogenize`: an element `a` of degree `n`
  dehomogenizes to `a / ℓ₀ ^ n`.
* `ComplementRing.adjoin_ratio_eq_top`, `ComplementRing.range_toCone_eq_adjoin`: `O(U_P)` is
  generated by the ratios `ξ / ℓ` of a linear form and an equation.
* `ComplementRing.adjoin_ratioUnit_eq_top_of_span_eq_top`: if `P` is essential, then the ratios of
  equations alone are enough.
* `ComplementRing.ratio_notMem_adjoin_ratioUnit`: for one hyperplane, they are not.

## Implementation notes

The ring is Mathlib's `HomogeneousLocalization` of `O(W) = Sym(W*)` at the submonoid generated by
all equations of all hyperplanes. Two alternatives are worse.

* `HomogeneousLocalization.Away 𝒜 f` for a product `f` of equations, which is what `Proj` uses,
  depends on a choice of `f`, as a type. `ComplementRing.awayEquiv` compares it with this ring, and
  `Proj.basicOpenIsoSpec` then applies.
* The subalgebra of `O(V_P)` generated by the ratios `ℓ_i / ℓ_j` of equations is simply wrong when
  the equations do not span the dual of `W`: for one hyperplane in a space of dimension at least
  two, it is `k`, while the complement is an affine space of positive dimension. With all linear
  forms as numerators it is right, by `ComplementRing.range_toCone_eq_adjoin`, and that is a theorem
  here rather than a definition.

The type is a `def`, as `Arrangement.ComplementRing` is. Nothing should depend on the fractions. Its
API is `toCone`, which is injective, `exists_mk_eq` and `toCone_mk_mul`.

Its `k`-algebra structure is declared here, as Mathlib's `HomogeneousLocalization` only has one over
the degree-zero part `𝒜 0`. It is not an instance on the type `HomogeneousLocalization` itself.

## Blueprint

`def:projective`, and the object used by `lem:decone` and `lem:geometry-adapter`.
-/

@[expose] public section

noncomputable section

open Module

universe u

namespace OrlikSolomon

open CoordinateRing

variable {k : Type u} [Field k] {W : Type u} [AddCommGroup W] [Module k W]

namespace ProjectiveArrangement

variable {P : ProjectiveArrangement k W} {ℓ ℓ' ℓ₀ ξ η : Dual k W}

/-- A linear form with kernel in `P` has zero locus covered by the cone. -/
theorem cone_covers (hℓ : LinearMap.ker ℓ ∈ P) : P.cone.Covers (zeroLocus ℓ.toAffineMap) :=
  .of_mem (zeroLocus_toAffineMap_mem_cone hℓ)

/-- The element of `O(W)` attached to a linear form is homogeneous of degree one. -/
theorem coord_toAffineMap_mem (ξ : Dual k W) :
    coord ξ.toAffineMap ∈ symmetricGrading k (Dual k W) 1 := by
  rw [coord_toAffineMap]
  exact ι_mem_symmetricGrading ξ

theorem coord_mem_equationSubmonoid_cone (hℓ : LinearMap.ker ℓ ∈ P) :
    coord ℓ.toAffineMap ∈ P.cone.equationSubmonoid :=
  Submonoid.subset_closure ⟨_, zeroLocus_toAffineMap_mem_cone hℓ, rfl⟩

/-- To check a property closed under products on `equationSubmonoid` of the cone, it is enough to
check the linear forms with kernel in `P`. -/
theorem forall_mem_equationSubmonoid_cone {p : CoordinateRing k W → Prop} (h1 : p 1)
    (hmul : ∀ x y, p x → p y → p (x * y))
    (h : ∀ ℓ : Dual k W, LinearMap.ker ℓ ∈ P → p (coord ℓ.toAffineMap))
    {x : CoordinateRing k W} (hx : x ∈ P.cone.equationSubmonoid) : p x := by
  induction hx using Submonoid.closure_induction with
  | mem _ hy =>
    obtain ⟨f, hf, rfl⟩ := hy
    obtain ⟨hf', hker⟩ := mem_cone_zeroLocus.1 hf
    have := h _ hker
    rwa [← hf'] at this
  | one => exact h1
  | mul _ _ _ _ hx hy => exact hmul _ _ hx hy

/-- Every element of `equationSubmonoid` of the cone is homogeneous, so the denominators of the
fractions below are products of linear forms. -/
theorem exists_mem_symmetricGrading_of_mem_equationSubmonoid_cone {x : CoordinateRing k W}
    (hx : x ∈ P.cone.equationSubmonoid) : ∃ n, x ∈ symmetricGrading k (Dual k W) n :=
  forall_mem_equationSubmonoid_cone (p := fun x ↦ ∃ n, x ∈ symmetricGrading k (Dual k W) n)
    ⟨0, SetLike.GradedOne.one_mem⟩
    (fun _ _ ⟨m, hm⟩ ⟨n, hn⟩ ↦ ⟨m + n, SetLike.GradedMul.mul_mem hm hn⟩)
    (fun ξ _ ↦ ⟨1, coord_toAffineMap_mem ξ⟩) hx

variable (P) in
/-- The coordinate ring `O(U_P)` of the complement of a projective arrangement in the
projectivization of `W`: the fractions `a / b` of elements of the same degree of
`O(W) = Sym(W*)`, whose denominators `b` are products of equations of hyperplanes of `P`. In other
words, it is the degree-zero part of `O(V_P) = O(W)[1/∏ℓ]`, the ring of the complement of the cone.

This is Mathlib's `HomogeneousLocalization`, so `Spec` of this ring is the open subscheme of
`Proj Sym(W*)` that is the complement of the hyperplanes of `P`: see
`OrlikSolomon/Geometry/ProjectiveScheme.lean`. The definition involves no hyperplane at infinity and
no choice of equations.

It is only meaningful when `P` is nonempty. For empty `P`, this ring is the degree-zero part of
`O(W)`, which is `k`: the global functions on projective space. That space is not affine, so it is
not the coordinate ring of the complement, and this case must not be used.

Blueprint: `def:projective`, `lem:decone`. -/
def ComplementRing : Type u :=
  HomogeneousLocalization (symmetricGrading k (Dual k W)) P.cone.equationSubmonoid

namespace ComplementRing

instance : CommRing P.ComplementRing :=
  inferInstanceAs (CommRing (HomogeneousLocalization _ _))

instance : Algebra k P.ComplementRing :=
  (((HomogeneousLocalization.fromZeroRingHom (symmetricGrading k (Dual k W))
    P.cone.equationSubmonoid).comp (algebraMap k _)) : k →+* _).toAlgebra

variable (P) in
/-- The inclusion `O(U_P) → O(V_P)` of the degree-zero part: the pullback along the projection from
the complement of the cone to the projective complement. -/
def toCone : P.ComplementRing →ₐ[k] P.cone.ComplementRing where
  __ := algebraMap (HomogeneousLocalization (symmetricGrading k (Dual k W))
    P.cone.equationSubmonoid) (Localization P.cone.equationSubmonoid)
  commutes' c :=
    (Localization.mk_one_eq_algebraMap (algebraMap k (CoordinateRing k W) c)).trans
      (IsScalarTower.algebraMap_apply k (CoordinateRing k W) P.cone.ComplementRing c).symm

theorem toCone_injective : Function.Injective (toCone P) :=
  HomogeneousLocalization.val_injective _

/-- Two elements of `O(U_P)` agree if they agree in `O(V_P)`. -/
@[ext]
theorem ext {x y : P.ComplementRing} (h : toCone P x = toCone P y) : x = y :=
  toCone_injective h

/-- The coordinate ring of a projective complement is a domain, and in particular it is never zero,
even if the complement has no `k`-points. -/
instance : IsDomain P.ComplementRing :=
  toCone_injective.isDomain (toCone P).toRingHom

section Mk

variable {n : ℕ} {a b : CoordinateRing k W}

/-- The fraction `a / b` of two elements of the same degree of `O(W)`, where `b` is a product of
equations of hyperplanes of `P`. Every element has this form, by `exists_mk_eq`. -/
def mk (ha : a ∈ symmetricGrading k (Dual k W) n) (hb : b ∈ symmetricGrading k (Dual k W) n)
    (hbS : b ∈ P.cone.equationSubmonoid) : P.ComplementRing :=
  HomogeneousLocalization.mk ⟨n, ⟨a, ha⟩, ⟨b, hb⟩, hbS⟩

theorem exists_mk_eq (x : P.ComplementRing) :
    ∃ (n : ℕ) (a b : CoordinateRing k W) (ha : a ∈ symmetricGrading k (Dual k W) n)
      (hb : b ∈ symmetricGrading k (Dual k W) n) (hbS : b ∈ P.cone.equationSubmonoid),
        mk ha hb hbS = x := by
  obtain ⟨⟨n, ⟨a, ha⟩, ⟨b, hb⟩, hbS⟩, rfl⟩ := HomogeneousLocalization.mk_surjective x
  exact ⟨n, a, b, ha, hb, hbS, rfl⟩

/-- The value of a fraction in `O(V_P)`. -/
theorem toCone_mk_mul (ha : a ∈ symmetricGrading k (Dual k W) n)
    (hb : b ∈ symmetricGrading k (Dual k W) n) (hbS : b ∈ P.cone.equationSubmonoid) :
    toCone P (mk ha hb hbS) * algebraMap _ _ b = algebraMap _ _ a := by
  have : toCone P (mk ha hb hbS) =
      IsLocalization.mk' P.cone.ComplementRing a (⟨b, hbS⟩ : P.cone.equationSubmonoid) :=
    Localization.mk_eq_mk'_apply a ⟨b, hbS⟩
  rw [this]
  exact IsLocalization.mk'_spec _ a ⟨b, hbS⟩

/-- `O(U_P)` is the degree-zero part of `O(V_P)`: the elements that are fractions of two elements of
the same degree of `O(W)`. -/
theorem mem_range_toCone_iff {y : P.cone.ComplementRing} :
    y ∈ (toCone P).range ↔ ∃ (n : ℕ) (a b : CoordinateRing k W),
      a ∈ symmetricGrading k (Dual k W) n ∧ b ∈ symmetricGrading k (Dual k W) n ∧
        b ∈ P.cone.equationSubmonoid ∧ y * algebraMap _ _ b = algebraMap _ _ a := by
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨n, a, b, ha, hb, hbS, rfl⟩ := exists_mk_eq x
    exact ⟨n, a, b, ha, hb, hbS, toCone_mk_mul ha hb hbS⟩
  · rintro ⟨n, a, b, ha, hb, hbS, hy⟩
    have hu : IsUnit (algebraMap _ P.cone.ComplementRing b) :=
      IsLocalization.map_units _ (⟨b, hbS⟩ : P.cone.equationSubmonoid)
    refine ⟨mk ha hb hbS, hu.mul_right_cancel ?_⟩
    rw [hy]
    exact toCone_mk_mul ha hb hbS

end Mk

/-! ### Ratios -/

section Ratio

/-- The unit of `O(V_P)` given by a linear form with kernel in `P`. -/
def coneUnit (hℓ : LinearMap.ker ℓ ∈ P) : P.cone.ComplementRingˣ :=
  (Arrangement.ComplementRing.isUnit_coord (cone_covers hℓ)).unit

@[simp]
theorem coe_coneUnit (hℓ : LinearMap.ker ℓ ∈ P) :
    (coneUnit hℓ : P.cone.ComplementRing) = algebraMap _ _ (coord ℓ.toAffineMap) :=
  rfl

/-- The ratio `ξ / ℓ` of a linear form `ξ` and an equation `ℓ` of a hyperplane of `P`, a function on
the projective complement. -/
def ratio (ξ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P) : P.ComplementRing :=
  mk (coord_toAffineMap_mem ξ) (coord_toAffineMap_mem ℓ) (coord_mem_equationSubmonoid_cone hℓ)

/-- The value of a ratio in `O(V_P)`. -/
@[simp]
theorem toCone_ratio (ξ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P) :
    toCone P (ratio ξ hℓ) = algebraMap _ _ (coord ξ.toAffineMap) * ((coneUnit hℓ)⁻¹ : _ˣ) := by
  rw [Units.eq_mul_inv_iff_mul_eq]
  exact toCone_mk_mul _ _ _

/-- A ratio is determined by its value in `O(V_P)`, multiplied by its denominator. -/
theorem toCone_ratio_mul (ξ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P) :
    toCone P (ratio ξ hℓ) * algebraMap _ _ (coord ℓ.toAffineMap) =
      algebraMap _ _ (coord ξ.toAffineMap) :=
  toCone_mk_mul _ _ _

@[simp]
theorem ratio_self (hℓ : LinearMap.ker ℓ ∈ P) : ratio ℓ hℓ = 1 :=
  toCone_injective <| by simp

theorem ratio_add (ξ η : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P) :
    ratio (ξ + η) hℓ = ratio ξ hℓ + ratio η hℓ :=
  toCone_injective <| by simp [coord_toAffineMap, add_mul]

theorem ratio_smul (c : k) (ξ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P) :
    ratio (c • ξ) hℓ = c • ratio ξ hℓ :=
  toCone_injective <| by
    simp [coord_toAffineMap, Algebra.smul_def, mul_assoc,
      ← IsScalarTower.algebraMap_apply k (CoordinateRing k W) P.cone.ComplementRing]

@[simp]
theorem ratio_zero (hℓ : LinearMap.ker ℓ ∈ P) : ratio 0 hℓ = 0 :=
  toCone_injective <| by simp [coord_toAffineMap]

theorem ratio_mul_ratio (ξ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P)
    (hℓ' : LinearMap.ker ℓ' ∈ P) : ratio ξ hℓ' * ratio ℓ' hℓ = ratio ξ hℓ :=
  toCone_injective <| by
    rw [map_mul, toCone_ratio, toCone_ratio, toCone_ratio, mul_assoc,
      ← mul_assoc ((coneUnit hℓ')⁻¹ : _ˣ).val, ← coe_coneUnit hℓ', Units.inv_mul, one_mul]

/-- The ratio `ξ / ℓ`, linearly in `ξ`. -/
def ratioLinear (hℓ : LinearMap.ker ℓ ∈ P) : Dual k W →ₗ[k] P.ComplementRing where
  toFun ξ := ratio ξ hℓ
  map_add' ξ η := ratio_add ξ η hℓ
  map_smul' c ξ := ratio_smul c ξ hℓ

@[simp]
theorem ratioLinear_apply (ξ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P) :
    ratioLinear hℓ ξ = ratio ξ hℓ :=
  rfl

/-- The ratio `ℓ / ℓ'` of two equations of hyperplanes of `P`, as a unit of `O(U_P)`. Its logarithm
is what `e_i - e_j` maps to in the projective structure theorem. It does not depend on a hyperplane
at infinity.

Blueprint: `thm:projective`. -/
def ratioUnit (hℓ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P) : P.ComplementRingˣ where
  val := ratio ℓ hℓ'
  inv := ratio ℓ' hℓ
  val_inv := by rw [ratio_mul_ratio, ratio_self]
  inv_val := by rw [ratio_mul_ratio, ratio_self]

@[simp]
theorem coe_ratioUnit (hℓ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P) :
    (ratioUnit hℓ hℓ' : P.ComplementRing) = ratio ℓ hℓ' :=
  rfl

@[simp]
theorem ratioUnit_self (hℓ : LinearMap.ker ℓ ∈ P) : ratioUnit hℓ hℓ = 1 :=
  Units.ext (ratio_self hℓ)

@[simp]
theorem ratioUnit_inv (hℓ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P) :
    (ratioUnit hℓ hℓ')⁻¹ = ratioUnit hℓ' hℓ :=
  rfl

theorem ratioUnit_mul_ratioUnit {ℓ'' : Dual k W} (hℓ : LinearMap.ker ℓ ∈ P)
    (hℓ' : LinearMap.ker ℓ' ∈ P) (hℓ'' : LinearMap.ker ℓ'' ∈ P) :
    ratioUnit hℓ hℓ' * ratioUnit hℓ' hℓ'' = ratioUnit hℓ hℓ'' :=
  Units.ext (ratio_mul_ratio ℓ hℓ'' hℓ')

/-- Scaling the numerator of a ratio by a nonzero constant multiplies it by that constant. Together
with `ratioUnit_inv`, it says that changing either equation changes the ratio by a constant. -/
theorem coe_ratioUnit_smul {c : kˣ} (hℓ : LinearMap.ker ((c : k) • ℓ) ∈ P)
    (hℓ₁ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P) :
    (ratioUnit hℓ hℓ' : P.ComplementRing) = algebraMap k _ (c : k) * ratioUnit hℓ₁ hℓ' := by
  rw [coe_ratioUnit, ratio_smul, coe_ratioUnit, Algebra.smul_def]

end Ratio

/-! ### Dehomogenizing

For an equation `ℓ₀` of `H₀`, the map `O(W) → O(U_P)` sending a linear form `ξ` to `ξ / ℓ₀` is the
pullback along the map `U_P → W` sending the class of `v` to `v / ℓ₀(v)`. An element `a` of degree
`n` goes to `a / ℓ₀ ^ n`, by `algebraMap_pow_mul_toCone_dehomogenize`, and this is what relates
`O(U_P)` to both the slice and the cone. -/

section Dehomogenize

variable {n : ℕ} {a b : CoordinateRing k W}

/-- The map `O(W) → O(U_P)` sending a linear form `ξ` to `ξ / ℓ₀`. Geometrically, this is the
pullback along `U_P → W`, `v ↦ v / ℓ₀(v)`. -/
def dehomogenize (hℓ₀ : LinearMap.ker ℓ₀ ∈ P) : CoordinateRing k W →ₐ[k] P.ComplementRing :=
  SymmetricAlgebra.lift (ratioLinear hℓ₀)

@[simp]
theorem dehomogenize_coord_toAffineMap (hℓ₀ : LinearMap.ker ℓ₀ ∈ P) (ξ : Dual k W) :
    dehomogenize hℓ₀ (coord ξ.toAffineMap) = ratio ξ hℓ₀ := by
  rw [coord_toAffineMap, dehomogenize, SymmetricAlgebra.lift_ι_apply, ratioLinear_apply]

/-- On an affine function, dehomogenizing gives the ratio of the linear part, plus the constant. -/
theorem dehomogenize_coord (hℓ₀ : LinearMap.ker ℓ₀ ∈ P) (f : W →ᵃ[k] k) :
    dehomogenize hℓ₀ (coord f) = ratio f.linear hℓ₀ + algebraMap k _ (f 0) := by
  rw [coord_apply, map_add, AlgHom.commutes, ← coord_toAffineMap,
    dehomogenize_coord_toAffineMap]

/-- An element `a` of degree `n` dehomogenizes to `a / ℓ₀ ^ n`. -/
theorem algebraMap_pow_mul_toCone_dehomogenize (hℓ₀ : LinearMap.ker ℓ₀ ∈ P)
    (ha : a ∈ symmetricGrading k (Dual k W) n) :
    algebraMap _ P.cone.ComplementRing (coord ℓ₀.toAffineMap) ^ n *
        toCone P (dehomogenize hℓ₀ a) = algebraMap _ _ a := by
  refine (apply_eq_pow_mul_of_mem_symmetricGrading
    (φ := Arrangement.ComplementRing.toComplementRing P.cone)
    (ψ := (toCone P).comp (dehomogenize hℓ₀)) (fun ξ ↦ ?_) ha).symm
  rw [← coord_toAffineMap, AlgHom.comp_apply, dehomogenize_coord_toAffineMap, toCone_ratio,
    Arrangement.ComplementRing.toComplementRing_apply, ← coe_coneUnit hℓ₀, mul_left_comm,
    Units.mul_inv, mul_one]

/-- If `x` is the fraction `a / b`, then `x` is the quotient of the dehomogenizations of `a` and
`b`. -/
theorem mul_dehomogenize_eq (hℓ₀ : LinearMap.ker ℓ₀ ∈ P) {x : P.ComplementRing}
    (ha : a ∈ symmetricGrading k (Dual k W) n) (hb : b ∈ symmetricGrading k (Dual k W) n)
    (hx : toCone P x * algebraMap _ _ b = algebraMap _ _ a) :
    x * dehomogenize hℓ₀ b = dehomogenize hℓ₀ a := by
  refine toCone_injective (((coneUnit hℓ₀).isUnit.pow n).mul_right_injective ?_)
  simp only [coe_coneUnit, map_mul, algebraMap_pow_mul_toCone_dehomogenize hℓ₀ ha]
  rw [mul_left_comm, algebraMap_pow_mul_toCone_dehomogenize hℓ₀ hb, hx]

/-- The dehomogenization of a product of equations of hyperplanes of `P` is a unit. -/
theorem isUnit_dehomogenize (hℓ₀ : LinearMap.ker ℓ₀ ∈ P) (hb : b ∈ P.cone.equationSubmonoid) :
    IsUnit (dehomogenize hℓ₀ b) :=
  forall_mem_equationSubmonoid_cone (p := fun b ↦ IsUnit (dehomogenize hℓ₀ b)) (by simp)
    (fun _ _ hx hy ↦ by simpa using hx.mul hy)
    (fun _ hℓ ↦ by simpa using (ratioUnit hℓ hℓ₀).isUnit) hb

end Dehomogenize

/-! ### Generators

The ring `O(U_P)` is generated by ratios of linear forms. The denominators must be equations of
hyperplanes of `P`, but the numerators must be allowed to be all linear forms: ratios of equations
alone are not enough, by `ratio_notMem_adjoin_ratioUnit`. -/

section Generators

/-- `O(U_P)` is generated by the ratios `ξ / ℓ₀` with any linear form `ξ`, for one fixed equation
`ℓ₀`, together with the inverses `ℓ₀ / ℓ` of the ratios of equations. -/
theorem adjoin_ratio_eq_top_of_ker_mem (hℓ₀ : LinearMap.ker ℓ₀ ∈ P) :
    Algebra.adjoin k ({x | ∃ ξ : Dual k W, x = ratio ξ hℓ₀} ∪
      {x | ∃ (ℓ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P), x = ratio ℓ₀ hℓ}) = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  set B := Algebra.adjoin k ({x | ∃ ξ : Dual k W, x = ratio ξ hℓ₀} ∪
      {x | ∃ (ℓ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P), x = ratio ℓ₀ hℓ}) with hB
  have hd (y : CoordinateRing k W) : dehomogenize hℓ₀ y ∈ B := by
    induction y using SymmetricAlgebra.induction with
    | algebraMap r => simp [B.algebraMap_mem]
    | ι ξ =>
      rw [← coord_toAffineMap, dehomogenize_coord_toAffineMap]
      exact Algebra.subset_adjoin (Or.inl ⟨ξ, rfl⟩)
    | mul a b ha hb => simpa using B.mul_mem ha hb
    | add a b ha hb => simpa using B.add_mem ha hb
  obtain ⟨n, a, b, ha, hb, hbS, rfl⟩ := exists_mk_eq x
  obtain ⟨y, hy, hyb⟩ : ∃ y ∈ B, y * dehomogenize hℓ₀ b = 1 :=
    forall_mem_equationSubmonoid_cone (p := fun b ↦ ∃ y ∈ B, y * dehomogenize hℓ₀ b = 1)
      ⟨1, B.one_mem, by simp⟩
      (fun _ _ ⟨y, hy, hyb⟩ ⟨z, hz, hzb⟩ ↦ ⟨y * z, B.mul_mem hy hz, by
        rw [map_mul, mul_mul_mul_comm, hyb, hzb, one_mul]⟩)
      (fun _ hℓ ↦ ⟨ratio ℓ₀ hℓ, Algebra.subset_adjoin (Or.inr ⟨_, hℓ, rfl⟩), by
        rw [dehomogenize_coord_toAffineMap, ratio_mul_ratio, ratio_self]⟩) hbS
  have hx := mul_dehomogenize_eq hℓ₀ ha hb (toCone_mk_mul ha hb hbS)
  rw [show mk ha hb hbS = y * dehomogenize hℓ₀ a by rw [← hx, mul_left_comm, hyb, mul_one]]
  exact B.mul_mem hy (hd a)

/-- `O(U_P)` is generated by all ratios `ξ / ℓ` of a linear form `ξ` and an equation `ℓ` of a
hyperplane of `P`. -/
theorem adjoin_ratio_eq_top (P : ProjectiveArrangement k W) [Nonempty P] :
    Algebra.adjoin k {x : P.ComplementRing |
      ∃ (ξ ℓ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P), x = ratio ξ hℓ} = ⊤ := by
  obtain ⟨ℓ₀, hℓ₀⟩ := P.exists_ker_mem
  rw [eq_top_iff, ← adjoin_ratio_eq_top_of_ker_mem hℓ₀]
  refine Algebra.adjoin_mono (Set.union_subset ?_ ?_)
  · rintro _ ⟨ξ, rfl⟩
    exact ⟨ξ, ℓ₀, hℓ₀, rfl⟩
  · rintro _ ⟨ℓ, hℓ, rfl⟩
    exact ⟨ℓ₀, ℓ, hℓ, rfl⟩

/-- The degree-zero part of `O(V_P)` is the subalgebra generated by the ratios `ξ / ℓ` of a linear
form `ξ` and an equation `ℓ` of a hyperplane of `P`. So `O(U_P)` could be defined as this
subalgebra, with no reference to a grading. -/
theorem range_toCone_eq_adjoin (P : ProjectiveArrangement k W) [Nonempty P] :
    (toCone P).range = Algebra.adjoin k {y : P.cone.ComplementRing |
      ∃ (ξ ℓ : Dual k W) (_ : LinearMap.ker ℓ ∈ P),
        y * algebraMap _ _ (coord ℓ.toAffineMap) = algebraMap _ _ (coord ξ.toAffineMap)} := by
  rw [← Algebra.map_top, ← adjoin_ratio_eq_top P, AlgHom.map_adjoin]
  congr 1
  ext y
  constructor
  · rintro ⟨_, ⟨ξ, ℓ, hℓ, rfl⟩, rfl⟩
    exact ⟨ξ, ℓ, hℓ, toCone_ratio_mul ξ hℓ⟩
  · rintro ⟨ξ, ℓ, hℓ, hy⟩
    refine ⟨_, ⟨ξ, ℓ, hℓ, rfl⟩, (coneUnit hℓ).isUnit.mul_right_cancel ?_⟩
    rw [coe_coneUnit, hy, toCone_ratio_mul]

/-- If the equations of the hyperplanes of `P` span the dual of `W`, that is, if `P` is essential,
then `O(U_P)` is generated by the ratios `ℓ / ℓ'` of equations. By
`ratio_notMem_adjoin_ratioUnit`, this hypothesis cannot be dropped. -/
theorem adjoin_ratioUnit_eq_top_of_span_eq_top (P : ProjectiveArrangement k W) [Nonempty P]
    (h : Submodule.span k {ℓ : Dual k W | LinearMap.ker ℓ ∈ P} = ⊤) :
    Algebra.adjoin k {x : P.ComplementRing | ∃ (ℓ ℓ' : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P)
      (hℓ' : LinearMap.ker ℓ' ∈ P), x = ratioUnit hℓ hℓ'} = ⊤ := by
  obtain ⟨ℓ₀, hℓ₀⟩ := P.exists_ker_mem
  rw [eq_top_iff, ← adjoin_ratio_eq_top_of_ker_mem hℓ₀]
  refine Algebra.adjoin_le (Set.union_subset ?_ ?_)
  · rintro _ ⟨ξ, rfl⟩
    have hξ : ξ ∈ Submodule.span k {ℓ : Dual k W | LinearMap.ker ℓ ∈ P} := h ▸ Submodule.mem_top
    induction hξ using Submodule.span_induction with
    | mem ℓ hℓ => exact Algebra.subset_adjoin ⟨ℓ, ℓ₀, hℓ, hℓ₀, rfl⟩
    | zero => simp
    | add ξ η _ _ hξ hη => simpa [ratio_add] using Subalgebra.add_mem _ hξ hη
    | smul c ξ _ hξ => simpa [ratio_smul] using Subalgebra.smul_mem _ hξ c
  · rintro _ ⟨ℓ, hℓ, rfl⟩
    exact Algebra.subset_adjoin ⟨ℓ₀, ℓ, hℓ₀, hℓ, rfl⟩

/-- Ratios of equations alone do not generate `O(U_P)` in general, so `O(U_P)` must not be defined
as the subalgebra they generate. For one hyperplane `H₀`, the complement is an affine space, whereas
the only ratios of equations are constants. The function `ξ / ℓ₀` is not in that subalgebra, for any
linear form `ξ` not proportional to `ℓ₀`. -/
theorem ratio_notMem_adjoin_ratioUnit (hℓ₀ : LinearMap.ker ℓ₀ ∈ P)
    (hP : ∀ H ∈ P, H = LinearMap.ker ℓ₀) (hξ : ξ ∉ Submodule.span k {ℓ₀}) :
    ratio ξ hℓ₀ ∉ Algebra.adjoin k {x : P.ComplementRing |
      ∃ (ℓ ℓ' : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P),
        x = ratioUnit hℓ hℓ'} := by
  have hle : Algebra.adjoin k {x : P.ComplementRing |
      ∃ (ℓ ℓ' : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P),
        x = ratioUnit hℓ hℓ'} ≤ ⊥ := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨ℓ, ℓ', hℓ, hℓ', rfl⟩
    obtain ⟨c, rfl⟩ := exists_eq_smul_of_ker_eq ((hP _ hℓ).trans (hP _ hℓ').symm)
      (ne_zero_of_ker_mem hℓ')
    rw [coe_ratioUnit, ratio_smul, ratio_self, Algebra.smul_def, mul_one]
    exact Subalgebra.algebraMap_mem _ _
  intro hmem
  obtain ⟨c, hc⟩ := Algebra.mem_bot.1 (hle hmem)
  refine hξ (Submodule.mem_span_singleton.2 ⟨c, ?_⟩)
  have h := toCone_ratio_mul ξ hℓ₀
  rw [← hc, AlgHom.commutes, IsScalarTower.algebraMap_apply k (CoordinateRing k W), ← map_mul,
    ← coord_smul_eq_mul] at h
  have h' := coord_injective (Arrangement.ComplementRing.algebraMap_injective _ h)
  exact congrArg AffineMap.linear h'

/-- `k`-algebra maps out of `O(U_P)` agree if they agree on all ratios `ξ / ℓ`. -/
theorem algHom_ext [Nonempty P] {B : Type*} [Semiring B] [Algebra k B]
    {f g : P.ComplementRing →ₐ[k] B}
    (h : ∀ (ξ ℓ : Dual k W) (hℓ : LinearMap.ker ℓ ∈ P), f (ratio ξ hℓ) = g (ratio ξ hℓ)) : f = g :=
  AlgHom.ext_of_adjoin_eq_top (adjoin_ratio_eq_top P) <| by
    rintro _ ⟨ξ, ℓ, hℓ, rfl⟩
    exact h ξ ℓ hℓ

