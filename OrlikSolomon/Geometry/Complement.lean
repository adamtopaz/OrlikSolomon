/-!
# The coordinate ring of an arrangement complement

This file defines the coordinate ring `O(U_𝒜)` of the complement of an arrangement `𝒜`, as a
localization of `O(V)` at the equations of its hyperplanes. **It is never a subset of `V`**: a
complement can have no `k`-points while its ring is nonzero, see `Arrangement.twoPoints`.

## Main definitions

* `Arrangement.Covers`: a subspace is empty or a hyperplane of `𝒜`. These are the zero loci of the
  affine functions that are units on `U_𝒜`, and the preimages under the affine maps that induce a
  map of complements.
* `Arrangement.ComplementRing`: the ring `O(U_𝒜)`.
* `ComplementRing.lift`, `ComplementRing.map`, `ComplementRing.inclusion`: its universal property,
  and the maps of complements given by an affine map and by a sub-arrangement.
* `SmoothAlg.complement 𝒜`: the object `O(U_𝒜)` of `SmoothAlg k`, with `SmoothAlg.toComplement`,
  `SmoothAlg.complementLift`, `SmoothAlg.complementMap` and `SmoothAlg.complementInclusion`.
* `SmoothAlg.complementUnit`, `SmoothAlg.equationUnit`: the units of `O(U_𝒜)` given by equations.

## Main results

* `ComplementRing.isUnit_coord`: equations and nonzero constants become units.
* `ComplementRing.isLocalizationAway`: `O(U_𝒜) = O(V)[1/P]`, for `P` a product of any equations, one
  for each hyperplane.
* `ComplementRing.isLocalization_of_exists_dvd`: a criterion to recognize `O(U_𝒜)` as a localization
  at any other submonoid.
* `SmoothAlg.complementUnit_smul`, `SmoothAlg.exists_complementUnit_eq_constUnit_mul_equationUnit`:
  scaling an equation by a nonzero constant changes its unit by that constant.
* `SmoothAlg.complementEmptyIso`, `SmoothAlg.complement_empty_induction`: the ring of the empty
  arrangement is `O(V)`, and it reduces to iterated polynomial rings.
* `Arrangement.nontrivial_complementRing_twoPoints`, `Arrangement.isEmpty_algHom_twoPoints`: the
  regression example of two points of `𝔸¹` over `F₂`.

## Implementation notes

The ring is `Localization` of the submonoid generated by **all** equations of all hyperplanes, not
`Localization.Away` of a chosen product. This keeps the definition free of choices, and for `𝒜 ≤ ℬ`
it gives an inclusion of submonoids, with no comparison of products. Nothing should depend on it:
the type is a `def`, and its API is the universal property `ComplementRing.lift`,
`ComplementRing.algHom_ext`, and two criteria. `ComplementRing.isLocalizationAway` gives the form
`O(V)[1/P]`, which is what proves smoothness, and `ComplementRing.isLocalization_of_exists_dvd`
recognizes the ring as a localization at the image of another submonoid, which is what compares the
complements in a deletion pair.

Build a map whose target is a complement on the ring level, with target `𝒜.ComplementRing`, and apply
`SmoothAlg.ofHom` last. If `ofHom` comes first, then the target is elaborated as the carrier of
`SmoothAlg.complement 𝒜`, and lemmas on the ring level no longer match it syntactically.

## Blueprint

Part of `lem:geometry-adapter`, and the empty case of `thm:generation`.
-/

@[expose] public section

noncomputable section

open CategoryTheory Module

universe u

namespace OrlikSolomon

open CoordinateRing

/-! ### Localization at submonoids with the same saturation -/

section Localization

variable {R S : Type*} [CommSemiring R] [CommSemiring S] [Algebra R S]

/-- If `S` is a localization of `R` at `N`, then it is also a localization at any submonoid `M`
whose elements become units in `S` and such that every element of `N` divides an element of `M`.
Unlike `IsLocalization.of_le_of_exists_dvd`, the two submonoids need not be comparable. -/
theorem isLocalization_of_isUnit_of_exists_dvd (N M : Submonoid R) [IsLocalization N S]
    (h₁ : ∀ m ∈ M, IsUnit (algebraMap R S m)) (h₂ : ∀ n ∈ N, ∃ m ∈ M, n ∣ m) :
    IsLocalization M S where
  map_units m := h₁ m m.2
  surj z := by
    obtain ⟨⟨x, n⟩, e⟩ := IsLocalization.surj N z
    obtain ⟨m, hm, c, rfl⟩ := h₂ n n.2
    refine ⟨⟨x * c, ⟨_, hm⟩⟩, ?_⟩
    simp only [map_mul, ← e, mul_assoc]
  exists_of_eq {x y} h := by
    obtain ⟨n, hn⟩ := (IsLocalization.eq_iff_exists N S).1 h
    obtain ⟨m, hm, c, hc⟩ := h₂ n n.2
    refine ⟨⟨m, hm⟩, ?_⟩
    simp only [hc, mul_right_comm _ c, hn]

end Localization

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V]
variable {W : Type u} [AddCommGroup W] [Module k W] {U : Type u} [AddCommGroup U] [Module k U]

namespace Arrangement

section Covers

variable (𝒜 : Arrangement k V) {ℬ : Arrangement k V} {H L : AffineSubspace k V}

/-- `𝒜` covers `L` if `L` is empty or a hyperplane of `𝒜`. For `L = zeroLocus f`, this says that `f`
is a nonzero constant or an equation of a hyperplane of `𝒜`, so that it is a unit on the complement
of `𝒜`: see `ComplementRing.isUnit_coord`. For `L = K.comap φ`, it says that the affine map `φ`
carries the complement of `𝒜` into the complement of `K`, in a sense that does not refer to points.
-/
def Covers (L : AffineSubspace k V) : Prop :=
  L = ⊥ ∨ L ∈ 𝒜

variable {𝒜}

@[simp]
theorem covers_bot : 𝒜.Covers ⊥ :=
  Or.inl rfl

theorem Covers.of_mem (h : L ∈ 𝒜) : 𝒜.Covers L :=
  Or.inr h

/-- An equation of a hyperplane of `𝒜` has zero locus covered by `𝒜`. -/
theorem _root_.OrlikSolomon.IsEquation.covers {f : V →ᵃ[k] k} (hf : IsEquation f H) (hH : H ∈ 𝒜) :
    𝒜.Covers (zeroLocus f) :=
  .of_mem (hf.zeroLocus_eq ▸ hH)

theorem Covers.mono (h : 𝒜 ≤ ℬ) (hL : 𝒜.Covers L) : ℬ.Covers L :=
  hL.imp_right fun h' ↦ IsConcreteLE.le_iff.1 h h'

/-- If `φ` carries the complement of `ℬ` to that of `𝒜`, then what `𝒜` covers pulls back to
something that `ℬ` covers. -/
theorem Covers.comap {ℬ : Arrangement k W} {φ : W →ᵃ[k] V} (h : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ))
    (hL : 𝒜.Covers L) : ℬ.Covers (L.comap φ) := by
  obtain rfl | hL := hL
  · simp
  · exact h L hL

/-- The condition for a map of complements is stable under composition. -/
theorem Covers.comap_comp {ℬ : Arrangement k W} {𝒞 : Arrangement k U} {φ : W →ᵃ[k] V}
    {ψ : U →ᵃ[k] W} (h₁ : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ)) (h₂ : ∀ K ∈ ℬ, 𝒞.Covers (K.comap ψ))
    (K : AffineSubspace k V) (hK : K ∈ 𝒜) : 𝒞.Covers (K.comap (φ.comp ψ)) := by
  rw [← AffineSubspace.comap_comap]
  exact (h₁ K hK).comap h₂

/-- Nonzero scalar multiples have the same zero locus. -/
theorem Covers.zeroLocus_smul {f : V →ᵃ[k] k} (hf : 𝒜.Covers (zeroLocus f)) (c : kˣ) :
    𝒜.Covers (zeroLocus ((c : k) • f)) := by
  rwa [OrlikSolomon.zeroLocus_smul c.ne_zero]

/-- An affine map not landing in a hyperplane `K` of `𝒜` has preimage of `K` covered by the pullback
of `𝒜`. -/
theorem covers_comap_comap {φ : W →ᵃ[k] V} {K : AffineSubspace k V} (hK : K ∈ 𝒜)
    (h : K.comap φ ≠ ⊤) : (𝒜.comap φ).Covers (K.comap φ) :=
  comap_eq_bot_or_mem_comap φ hK h

end Covers

/-! ### The coordinate ring of an arrangement complement -/

section Rings

variable (𝒜 : Arrangement k V) {ℬ : Arrangement k V} {H : AffineSubspace k V} {f : V →ᵃ[k] k}
variable {B : Type*} [CommRing B] [Algebra k B]

/-- The submonoid of `O(V)` generated by all equations of all hyperplanes of `𝒜`. An affine function
is an equation for a hyperplane of `𝒜` exactly when its zero locus belongs to `𝒜`, by
`isEquation_of_zeroLocus_mem`. -/
def equationSubmonoid : Submonoid (CoordinateRing k V) :=
  Submonoid.closure (coord '' {f : V →ᵃ[k] k | zeroLocus f ∈ 𝒜})

variable {𝒜}

/-- An affine function whose zero locus belongs to `𝒜` is an equation for it. -/
theorem isEquation_of_zeroLocus_mem (h : zeroLocus f ∈ 𝒜) : IsEquation f (zeroLocus f) :=
  isEquation_zeroLocus (isHyperplane_zeroLocus_iff.1 (𝒜.isHyperplane h))

theorem coord_mem_equationSubmonoid (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    coord f ∈ 𝒜.equationSubmonoid :=
  Submonoid.subset_closure ⟨f, by simpa [hf.zeroLocus_eq] using hH, rfl⟩

theorem equationSubmonoid_mono (h : 𝒜 ≤ ℬ) : 𝒜.equationSubmonoid ≤ ℬ.equationSubmonoid :=
  Submonoid.closure_mono <| Set.image_mono fun _ hf ↦ IsConcreteLE.le_iff.1 h hf

@[simp]
theorem equationSubmonoid_empty : (∅ : Arrangement k V).equationSubmonoid = ⊥ := by
  simp [equationSubmonoid]

theorem equationSubmonoid_le_nonZeroDivisors : 𝒜.equationSubmonoid ≤ nonZeroDivisors _ := by
  rw [equationSubmonoid, Submonoid.closure_le]
  rintro _ ⟨f, hf, rfl⟩
  exact mem_nonZeroDivisors_of_ne_zero (isEquation_of_zeroLocus_mem hf).coord_ne_zero

/-- To check a property closed under products and associates on `equationSubmonoid`, one equation
for each hyperplane is enough, since the others are scalar multiples of it. -/
theorem forall_mem_equationSubmonoid {p : CoordinateRing k V → Prop} (h1 : p 1)
    (hmul : ∀ x y, p x → p y → p (x * y))
    (hassoc : ∀ x y, Associated x y → p x → p y)
    (h : ∀ H ∈ 𝒜, ∃ f, IsEquation f H ∧ p (coord f)) {x : CoordinateRing k V}
    (hx : x ∈ 𝒜.equationSubmonoid) : p x := by
  induction hx using Submonoid.closure_induction with
  | mem _ hy =>
    obtain ⟨g, hg, rfl⟩ := hy
    obtain ⟨f, hf, hpf⟩ := h _ hg
    exact hassoc _ _ (hf.associated_coord (isEquation_of_zeroLocus_mem hg)) hpf
  | one => exact h1
  | mul _ _ _ _ hx hy => exact hmul _ _ hx hy

variable (𝒜)

/-- The coordinate ring `O(U_𝒜)` of the complement of an arrangement: the localization of `O(V)` at
all equations of all hyperplanes of `𝒜`.

This is never a subset of `V`: over a finite field the complement can have no `k`-points while this
ring is nonzero, see `Arrangement.twoPoints`. The definition involves no chosen equation. Use
`ComplementRing.isLocalizationAway` to see it as `O(V)[1/P]` for `P` a product of any equations, one
for each hyperplane.

Blueprint: `def:geometry-interface`, `lem:geometry-adapter`. -/
def ComplementRing : Type u :=
  Localization 𝒜.equationSubmonoid

namespace ComplementRing

instance : CommRing 𝒜.ComplementRing :=
  inferInstanceAs (CommRing (Localization 𝒜.equationSubmonoid))

instance : Algebra (CoordinateRing k V) 𝒜.ComplementRing :=
  inferInstanceAs (Algebra _ (Localization 𝒜.equationSubmonoid))

instance : IsLocalization 𝒜.equationSubmonoid 𝒜.ComplementRing :=
  inferInstanceAs (IsLocalization _ (Localization 𝒜.equationSubmonoid))

instance : Algebra k 𝒜.ComplementRing :=
  inferInstanceAs (Algebra k (Localization 𝒜.equationSubmonoid))

instance : IsScalarTower k (CoordinateRing k V) 𝒜.ComplementRing :=
  inferInstanceAs (IsScalarTower k _ (Localization 𝒜.equationSubmonoid))

/-- The coordinate ring of a complement is a domain, and in particular it is never zero, even if
the complement has no `k`-points. -/
instance : IsDomain 𝒜.ComplementRing :=
  IsLocalization.isDomain_of_le_nonZeroDivisors _ (M := 𝒜.equationSubmonoid)
    equationSubmonoid_le_nonZeroDivisors

theorem algebraMap_injective :
    Function.Injective (algebraMap (CoordinateRing k V) 𝒜.ComplementRing) :=
  IsLocalization.injective _ (M := 𝒜.equationSubmonoid) equationSubmonoid_le_nonZeroDivisors

/-- The restriction of functions from `V` to the complement of `𝒜`, as a map of `k`-algebras. -/
def toComplementRing : CoordinateRing k V →ₐ[k] 𝒜.ComplementRing :=
  IsScalarTower.toAlgHom k _ _

@[simp]
theorem toComplementRing_apply (x : CoordinateRing k V) :
    toComplementRing 𝒜 x = algebraMap _ _ x :=
  rfl

variable {𝒜}

/-- An affine function whose zero locus is covered by `𝒜` becomes a unit in `O(U_𝒜)`. This applies
to every equation of a hyperplane of `𝒜`, and to every nonzero constant. -/
theorem isUnit_coord (hf : 𝒜.Covers (zeroLocus f)) :
    IsUnit (algebraMap (CoordinateRing k V) 𝒜.ComplementRing (coord f)) := by
  obtain h | h := hf
  · exact (isUnit_coord_of_zeroLocus_eq_bot h).map _
  · exact IsLocalization.map_units _ (⟨_, Submonoid.subset_closure ⟨f, h, rfl⟩⟩ :
      𝒜.equationSubmonoid)

/-- Every equation of a hyperplane of `𝒜` becomes a unit in `O(U_𝒜)`. -/
theorem isUnit_coord_of_isEquation (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    IsUnit (algebraMap (CoordinateRing k V) 𝒜.ComplementRing (coord f)) :=
  isUnit_coord (hf.covers hH)

/-- The universal property of `O(U_𝒜)`: a map `g` out of `O(V)` extends to `O(U_𝒜)` as soon as, for
each hyperplane of `𝒜`, some equation for it becomes a unit under `g`. -/
def lift (𝒜 : Arrangement k V) (g : CoordinateRing k V →ₐ[k] B)
    (hg : ∀ H ∈ 𝒜, ∃ f, IsEquation f H ∧ IsUnit (g (coord f))) : 𝒜.ComplementRing →ₐ[k] B :=
  IsLocalization.liftAlgHom (M := 𝒜.equationSubmonoid) (f := g) fun y ↦
    forall_mem_equationSubmonoid (p := fun x ↦ IsUnit (g x)) (by simp)
      (fun _ _ hx hy ↦ by simpa using hx.mul hy)
      (fun _ _ h hx ↦ (h.map g).isUnit_iff.1 hx) hg y.2

@[simp]
theorem lift_algebraMap (g : CoordinateRing k V →ₐ[k] B)
    (hg : ∀ H ∈ 𝒜, ∃ f, IsEquation f H ∧ IsUnit (g (coord f))) (x : CoordinateRing k V) :
    lift 𝒜 g hg (algebraMap _ _ x) = g x :=
  IsLocalization.lift_eq _ x

@[simp]
theorem lift_comp_toComplementRing (g : CoordinateRing k V →ₐ[k] B)
    (hg : ∀ H ∈ 𝒜, ∃ f, IsEquation f H ∧ IsUnit (g (coord f))) :
    (lift 𝒜 g hg).comp (toComplementRing 𝒜) = g :=
  AlgHom.ext fun x ↦ lift_algebraMap g hg x

/-- `k`-algebra maps out of `O(U_𝒜)` agree if they agree on `O(V)`. -/
@[ext high]
theorem algHom_ext {φ ψ : 𝒜.ComplementRing →ₐ[k] B}
    (h : φ.comp (toComplementRing 𝒜) = ψ.comp (toComplementRing 𝒜)) : φ = ψ :=
  IsLocalization.algHom_ext 𝒜.equationSubmonoid h

/-- `O(U_𝒜)` is a localization of `O(V)` at any submonoid of elements that become units, as long as
each hyperplane has an equation dividing one of its elements. -/
theorem isLocalization_of_exists_dvd (M : Submonoid (CoordinateRing k V))
    (h₁ : ∀ m ∈ M, IsUnit (algebraMap _ 𝒜.ComplementRing m))
    (h₂ : ∀ H ∈ 𝒜, ∃ f, IsEquation f H ∧ ∃ m ∈ M, coord f ∣ m) :
    IsLocalization M 𝒜.ComplementRing :=
  isLocalization_of_isUnit_of_exists_dvd 𝒜.equationSubmonoid M h₁ fun _ hn ↦
    forall_mem_equationSubmonoid (p := fun x ↦ ∃ m ∈ M, x ∣ m) ⟨1, M.one_mem, dvd_rfl⟩
      (fun _ _ ⟨a, ha, hxa⟩ ⟨b, hb, hyb⟩ ↦ ⟨a * b, M.mul_mem ha hb, mul_dvd_mul hxa hyb⟩)
      (fun _ _ h ⟨m, hm, hxm⟩ ↦ ⟨m, hm, h.symm.dvd.trans hxm⟩) h₂ hn

/-- For any choice of one equation for each hyperplane, `O(U_𝒜)` is `O(V)[1/P]`, where `P` is their
product. This is the blueprint's displayed form of the ring. It makes the ring finitely presented
over `O(V)`.

Blueprint: `def:geometry-interface`. -/
theorem isLocalizationAway (F : 𝒜 → V →ᵃ[k] k) (hF : ∀ H : 𝒜, IsEquation (F H) H) :
    IsLocalization.Away (∏ H : 𝒜, coord (F H)) 𝒜.ComplementRing := by
  refine isLocalization_of_exists_dvd _ (fun m hm ↦ ?_) fun H hH ↦
    ⟨F ⟨H, hH⟩, hF ⟨H, hH⟩, _, Submonoid.mem_powers _,
      Finset.dvd_prod_of_mem (fun H : 𝒜 ↦ coord (F H)) (Finset.mem_univ _)⟩
  obtain ⟨n, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.1 hm
  rw [map_pow, map_prod]
  exact (IsUnit.prod_univ_iff.2 fun H ↦ isUnit_coord_of_isEquation H.2 (hF H)).pow n

/-- For finite-dimensional `V`, the coordinate ring of a complement is smooth over `k`. -/
instance [FiniteDimensional k V] : Algebra.Smooth k 𝒜.ComplementRing :=
  have := isLocalizationAway (𝒜 := 𝒜) (fun H ↦ equation H)
    fun H ↦ isEquation_equation (𝒜.isHyperplane H.2)
  have : Algebra.Smooth (CoordinateRing k V) 𝒜.ComplementRing :=
    .of_isLocalization_Away (∏ H : 𝒜, coord (equation (H : AffineSubspace k V)))
  .comp k (CoordinateRing k V) 𝒜.ComplementRing

/-- The map `O(U_𝒜) → O(U_ℬ)` given by an affine map `φ : W → V`, when the preimage of each
hyperplane of `𝒜` is covered by `ℬ`: this says that `φ` carries the complement of `ℬ` to that of
`𝒜`. It is a map of schemes, which exists whether or not the complements have `k`-points. -/
def map (φ : W →ᵃ[k] V) (𝒜 : Arrangement k V) (ℬ : Arrangement k W)
    (h : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ)) : 𝒜.ComplementRing →ₐ[k] ℬ.ComplementRing :=
  lift 𝒜 ((toComplementRing ℬ).comp (pull φ)) fun K hK ↦ by
    have hf := isEquation_equation (𝒜.isHyperplane hK)
    refine ⟨_, hf, ?_⟩
    simpa using isUnit_coord (𝒜 := ℬ) (f := (equation K).comp φ) (by
      simpa only [zeroLocus_comp, hf.zeroLocus_eq] using h K hK)

@[simp]
theorem map_algebraMap (φ : W →ᵃ[k] V) {𝒜 : Arrangement k V} {ℬ : Arrangement k W}
    (h : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ)) (x : CoordinateRing k V) :
    map φ 𝒜 ℬ h (algebraMap _ _ x) = algebraMap _ _ (pull φ x) :=
  lift_algebraMap _ _ x

/-- The map `O(U_𝒜) → O(U_ℬ)` for a sub-arrangement `𝒜 ≤ ℬ`. Geometrically this is restriction from
`U_𝒜` to the smaller open `U_ℬ`. -/
def inclusion (h : 𝒜 ≤ ℬ) : 𝒜.ComplementRing →ₐ[k] ℬ.ComplementRing :=
  lift 𝒜 (toComplementRing ℬ) fun _ hK ↦
    have hf := isEquation_equation (𝒜.isHyperplane hK)
    ⟨_, hf, isUnit_coord_of_isEquation (IsConcreteLE.le_iff.1 h hK) hf⟩

@[simp]
theorem inclusion_algebraMap (h : 𝒜 ≤ ℬ) (x : CoordinateRing k V) :
    inclusion h (algebraMap _ _ x) = algebraMap _ _ x :=
  lift_algebraMap _ _ x

end ComplementRing

end Rings

end Arrangement

/-! ### The object of `SmoothAlg k` -/

namespace SmoothAlg

open Arrangement Arrangement.ComplementRing

section Complement

variable [FiniteDimensional k V] [FiniteDimensional k W] [FiniteDimensional k U] {B : SmoothAlg k}
variable (𝒜 : Arrangement k V) {ℬ : Arrangement k V} {f : V →ᵃ[k] k} {H : AffineSubspace k V}

/-- The coordinate ring `O(U_𝒜)` as an object of `SmoothAlg k`.

Blueprint: `lem:geometry-adapter`. -/
def complement : SmoothAlg k := of k 𝒜.ComplementRing

instance : IsDomain (complement 𝒜) := inferInstanceAs (IsDomain 𝒜.ComplementRing)

/-- The pullback `O(V) ⟶ O(U_𝒜)` along the open immersion `U_𝒜 → V`. -/
def toComplement : affineSpace k V ⟶ complement 𝒜 := ofHom (toComplementRing 𝒜)

lemma toComplement_apply (x : CoordinateRing k V) :
    toComplement 𝒜 x = (algebraMap _ 𝒜.ComplementRing x : 𝒜.ComplementRing) := rfl

variable {𝒜}

lemma toComplement_injective : Function.Injective (toComplement 𝒜) :=
  ComplementRing.algebraMap_injective 𝒜

/-- Maps out of `O(U_𝒜)` agree if they agree on `O(V)`. -/
lemma complement_hom_ext {f g : complement 𝒜 ⟶ B}
    (h : toComplement 𝒜 ≫ f = toComplement 𝒜 ≫ g) : f = g :=
  ConcreteCategory.ext <| ComplementRing.algHom_ext <| AlgHom.ext fun x ↦
    ConcreteCategory.congr_hom h x

instance : Epi (toComplement 𝒜) :=
  ⟨fun _ _ ↦ complement_hom_ext⟩

/-- The universal property of `O(U_𝒜)`: a map `g` out of `O(V)` extends to `O(U_𝒜)` as soon as, for
each hyperplane of `𝒜`, some equation for it becomes a unit under `g`. Geometrically, `g` is a map
to `V` avoiding the hyperplanes of `𝒜`, in a sense that does not refer to points.

Blueprint: `lem:geometry-adapter`. -/
def complementLift (𝒜 : Arrangement k V) (g : affineSpace k V ⟶ B)
    (hg : ∀ H ∈ 𝒜, ∃ f, IsEquation f H ∧ IsUnit (g (affineCoord f))) : complement 𝒜 ⟶ B :=
  ofHom (ComplementRing.lift 𝒜 (algHom g) hg)

@[simp] lemma complementLift_toComplement (g : affineSpace k V ⟶ B)
    (hg : ∀ H ∈ 𝒜, ∃ f, IsEquation f H ∧ IsUnit (g (affineCoord f))) (x : affineSpace k V) :
    complementLift 𝒜 g hg (toComplement 𝒜 x) = g x :=
  ComplementRing.lift_algebraMap _ hg x

@[reassoc (attr := simp)]
lemma toComplement_comp_complementLift (g : affineSpace k V ⟶ B)
    (hg : ∀ H ∈ 𝒜, ∃ f, IsEquation f H ∧ IsUnit (g (affineCoord f))) :
    toComplement 𝒜 ≫ complementLift 𝒜 g hg = g := by
  ext x
  simp

/-- The map `O(U_𝒜) ⟶ O(U_ℬ)` for a sub-arrangement `𝒜 ≤ ℬ`, the pullback along `U_ℬ → U_𝒜`. -/
def complementInclusion (h : 𝒜 ≤ ℬ) : complement 𝒜 ⟶ complement ℬ :=
  ofHom (ComplementRing.inclusion h)

@[simp] lemma complementInclusion_toComplement (h : 𝒜 ≤ ℬ) (x : affineSpace k V) :
    complementInclusion h (toComplement 𝒜 x) = toComplement ℬ x :=
  ComplementRing.inclusion_algebraMap h x

@[reassoc (attr := simp)]
lemma toComplement_comp_complementInclusion (h : 𝒜 ≤ ℬ) :
    toComplement 𝒜 ≫ complementInclusion h = toComplement ℬ := by
  ext x
  simp

/-- The map `O(U_𝒜) ⟶ O(U_ℬ)` given by an affine map `φ : W → V`, when the preimage under `φ` of
each hyperplane of `𝒜` is covered by `ℬ`. By `Arrangement.covers_comap_comap`, this holds for
`ℬ = 𝒜.comap φ` as soon as `φ` does not land in a hyperplane of `𝒜`.

Blueprint: `lem:geometry-adapter`. -/
def complementMap (φ : W →ᵃ[k] V) (𝒜 : Arrangement k V) (ℬ : Arrangement k W)
    (h : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ)) : complement 𝒜 ⟶ complement ℬ :=
  ofHom (ComplementRing.map φ 𝒜 ℬ h)

section Map

variable {ℬ : Arrangement k W} {𝒞 : Arrangement k U}

@[simp] lemma complementMap_toComplement (φ : W →ᵃ[k] V)
    (h : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ)) (x : affineSpace k V) :
    complementMap φ 𝒜 ℬ h (toComplement 𝒜 x) = toComplement ℬ (affinePull φ x) :=
  ComplementRing.map_algebraMap φ h x

@[reassoc (attr := simp)]
lemma toComplement_comp_complementMap (φ : W →ᵃ[k] V)
    (h : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ)) :
    toComplement 𝒜 ≫ complementMap φ 𝒜 ℬ h = affinePull φ ≫ toComplement ℬ := by
  ext x
  simp

@[simp] lemma complementMap_id (h : ∀ K ∈ 𝒜, 𝒜.Covers (K.comap (AffineMap.id k V))) :
    complementMap (AffineMap.id k V) 𝒜 𝒜 h = 𝟙 (complement 𝒜) := by
  apply complement_hom_ext
  simp

/-- The map of a sub-arrangement is the map given by the identity of `V`. -/
lemma complementMap_id_eq_complementInclusion {𝒟 : Arrangement k V} (hle : 𝒜 ≤ 𝒟)
    (h : ∀ K ∈ 𝒜, 𝒟.Covers (K.comap (AffineMap.id k V))) :
    complementMap (AffineMap.id k V) 𝒜 𝒟 h = complementInclusion hle := by
  apply complement_hom_ext
  simp

/-- Maps of complements compose. -/
@[reassoc (attr := simp)]
lemma complementMap_comp (φ : W →ᵃ[k] V) (ψ : U →ᵃ[k] W)
    (h₁ : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ)) (h₂ : ∀ K ∈ ℬ, 𝒞.Covers (K.comap ψ)) :
    complementMap φ 𝒜 ℬ h₁ ≫ complementMap ψ ℬ 𝒞 h₂ =
      complementMap (φ.comp ψ) 𝒜 𝒞 (Covers.comap_comp h₁ h₂) := by
  apply complement_hom_ext
  simp [affinePull_comp]

end Map

/-! ### Units from equations -/

variable (𝒜) in
/-- The unit of `O(U_𝒜)` given by an affine function whose zero locus is covered by `𝒜`, that is, by
a nonzero constant or by an equation of a hyperplane of `𝒜`. -/
def complementUnit (f : V →ᵃ[k] k) (hf : 𝒜.Covers (zeroLocus f)) : (complement 𝒜)ˣ :=
  (isUnit_coord hf).unit

@[simp] lemma coe_complementUnit (hf : 𝒜.Covers (zeroLocus f)) :
    (complementUnit 𝒜 f hf : complement 𝒜) = toComplement 𝒜 (affineCoord f) := rfl

/-- A nonzero constant function gives the corresponding constant unit. -/
@[simp] lemma complementUnit_const (c : kˣ)
    (h : 𝒜.Covers (zeroLocus (AffineMap.const k V (c : k)))) :
    complementUnit 𝒜 (AffineMap.const k V (c : k)) h = constUnit (complement 𝒜) c :=
  Units.ext <| congr(algebraMap _ 𝒜.ComplementRing $(coord_const (c : k))).trans
    (IsScalarTower.algebraMap_apply k _ _ _).symm

/-- Scaling an equation by a nonzero constant changes its unit by that constant. -/
lemma complementUnit_smul (c : kˣ) (hf : 𝒜.Covers (zeroLocus f)) :
    complementUnit 𝒜 ((c : k) • f) (hf.zeroLocus_smul c) =
      constUnit (complement 𝒜) c * complementUnit 𝒜 f hf :=
  Units.ext <| (congr(algebraMap _ 𝒜.ComplementRing $(coord_smul_eq_mul (c : k) f))).trans <| by
    rw [map_mul, ← IsScalarTower.algebraMap_apply]
    rfl

variable (𝒜) in
/-- The unit of `O(U_𝒜)` given by the chosen equation of a hyperplane of `𝒜`. Lemmas should prefer
`complementUnit`, which allows any equation, and which agrees with this one up to a constant by
`exists_complementUnit_eq_constUnit_mul_equationUnit`. -/
def equationUnit (H : 𝒜) : (complement 𝒜)ˣ :=
  complementUnit 𝒜 (equation (H : AffineSubspace k V))
    ((isEquation_equation (𝒜.isHyperplane H.2)).covers H.2)

/-- The units of two equations of a hyperplane of `𝒜` differ by a nonzero constant. -/
lemma exists_complementUnit_eq_constUnit_mul {g : V →ᵃ[k] k} (hH : H ∈ 𝒜) (hf : IsEquation f H)
    (hg : IsEquation g H) :
    ∃ c : kˣ, complementUnit 𝒜 g (hg.covers hH) =
      constUnit (complement 𝒜) c * complementUnit 𝒜 f (hf.covers hH) := by
  obtain ⟨c, rfl, -⟩ := hf.existsUnique_smul hg
  exact ⟨c, complementUnit_smul c (hf.covers hH)⟩

/-- Any equation of a hyperplane of `𝒜` has the same unit as the chosen equation, up to a nonzero
constant. -/
lemma exists_complementUnit_eq_constUnit_mul_equationUnit (hH : H ∈ 𝒜) (hf : IsEquation f H) :
    ∃ c : kˣ, complementUnit 𝒜 f (hf.covers hH) =
      constUnit (complement 𝒜) c * equationUnit 𝒜 ⟨H, hH⟩ :=
  exists_complementUnit_eq_constUnit_mul hH (isEquation_equation (𝒜.isHyperplane hH)) hf

/-- The pullback of the unit of `f` along a map of complements is the unit of `f ∘ φ`. -/
@[simp] lemma mapUnits_complementMap_complementUnit {ℬ : Arrangement k W} (φ : W →ᵃ[k] V)
    (h : ∀ K ∈ 𝒜, ℬ.Covers (K.comap φ)) (hf : 𝒜.Covers (zeroLocus f)) :
    mapUnits (complementMap φ 𝒜 ℬ h) (complementUnit 𝒜 f hf) =
      complementUnit ℬ (f.comp φ) (zeroLocus_comp f φ ▸ hf.comap h) := by
  ext
  simp

@[simp] lemma mapUnits_complementInclusion_complementUnit (h : 𝒜 ≤ ℬ)
    (hf : 𝒜.Covers (zeroLocus f)) :
    mapUnits (complementInclusion h) (complementUnit 𝒜 f hf) =
      complementUnit ℬ f (hf.mono h) := by
  ext
  simp

end Complement

/-! ### The empty arrangement -/

section Empty

variable (k V) in
/-- The ring of the empty arrangement is the coordinate ring of the whole space. -/
def complementEmptyIso [FiniteDimensional k V] :
    complement (∅ : Arrangement k V) ≅ affineSpace k V where
  hom := complementLift ∅ (𝟙 _) (by simp)
  inv := toComplement ∅
  hom_inv_id := by
    apply complement_hom_ext
    simp
  inv_hom_id := by simp

@[simp] lemma complementEmptyIso_inv [FiniteDimensional k V] :
    (complementEmptyIso k V).inv = toComplement ∅ := rfl

instance [FiniteDimensional k V] : IsIso (toComplement (∅ : Arrangement k V)) :=
  (complementEmptyIso k V).isIso_inv

/-- The base case of generation: a property of smooth algebras that holds for the point, passes from
`A` to `A[t]`, and is invariant under isomorphism, holds for the ring of the empty arrangement in
every dimension, including dimension zero. Affine-line invariance gives such a property: the map
from `point k` induces a bijection on cohomology.

Blueprint: `thm:generation`. -/
theorem complement_empty_induction {motive : SmoothAlg k → Prop} (point : motive (point k))
    (polynomial : ∀ A, motive A → motive (polynomial A))
    (iso : ∀ {A B : SmoothAlg k}, (A ≅ B) → motive A → motive B)
    (V : Type u) [AddCommGroup V] [Module k V] [FiniteDimensional k V] :
    motive (complement (∅ : Arrangement k V)) :=
  iso (complementEmptyIso k V).symm (affineSpace_induction point polynomial iso V)

end Empty

end SmoothAlg

/-! ### Two points of the line over the field with two elements -/

namespace Arrangement

open scoped Classical in
/-- The two rational points of the affine line over the field with two elements: the blueprint's
example of a complement with no `k`-points whose coordinate ring is nonzero. -/
def twoPoints : Arrangement (ZMod 2) (ZMod 2) :=
  ofFinset {zeroLocus (AffineMap.id _ _), zeroLocus (AffineMap.id _ _ - AffineMap.const _ _ 1)}

theorem zeroLocus_id_mem_twoPoints :
    zeroLocus (AffineMap.id (ZMod 2) (ZMod 2)) ∈ twoPoints := by
  refine mem_ofFinset.2 ⟨by simp, isHyperplane_zeroLocus_iff.2 ?_⟩
  simpa using fun h ↦ one_ne_zero (LinearMap.congr_fun h (1 : ZMod 2))

theorem zeroLocus_id_sub_one_mem_twoPoints :
    zeroLocus (AffineMap.id (ZMod 2) (ZMod 2) - AffineMap.const _ _ 1) ∈ twoPoints := by
  refine mem_ofFinset.2 ⟨by simp, isHyperplane_zeroLocus_iff.2 ?_⟩
  simpa using fun h ↦ one_ne_zero (LinearMap.congr_fun h (1 : ZMod 2))

/-- Every `F₂`-point of the line lies on one of the two hyperplanes. -/
theorem exists_mem_twoPoints (v : ZMod 2) : ∃ H ∈ twoPoints, v ∈ H := by
  obtain rfl | rfl : v = 0 ∨ v = 1 := by revert v; decide
  · exact ⟨_, zeroLocus_id_mem_twoPoints, by simp⟩
  · exact ⟨_, zeroLocus_id_sub_one_mem_twoPoints, by simp⟩

/-- The complement of the two points of the line over `F₂` has no `F₂`-points, even as a scheme: its
coordinate ring has no `F₂`-algebra map to `F₂`. -/
theorem isEmpty_algHom_twoPoints : IsEmpty (twoPoints.ComplementRing →ₐ[ZMod 2] ZMod 2) := by
  refine ⟨fun φ ↦ ?_⟩
  have h₀ := (ComplementRing.isUnit_coord (𝒜 := twoPoints)
    (.of_mem zeroLocus_id_mem_twoPoints)).map φ
  have h₁ := (ComplementRing.isUnit_coord (𝒜 := twoPoints)
    (.of_mem zeroLocus_id_sub_one_mem_twoPoints)).map φ
  rw [map_sub, map_sub, map_sub, coord_const] at h₁
  set a := φ (algebraMap _ _ (coord (AffineMap.id (ZMod 2) (ZMod 2))))
  have h1 : φ (algebraMap _ _ (algebraMap (ZMod 2) (CoordinateRing (ZMod 2) (ZMod 2)) 1)) = 1 := by
    simp
  rw [h1] at h₁
  obtain h | h := (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) a
  · simp [h] at h₀
  · simp [h] at h₁

/-- The coordinate ring of the complement of the two points of the line over `F₂` is nonzero, even
though the complement has no `F₂`-points, see `isEmpty_algHom_twoPoints`. This is why `O(U_𝒜)` is a
localization, and never a subset of `V`.

Blueprint: the regression list, "the two rational points in `𝔸¹` over `F₂`". -/
theorem nontrivial_complementRing_twoPoints : Nontrivial twoPoints.ComplementRing :=
  inferInstance

end Arrangement

end OrlikSolomon
