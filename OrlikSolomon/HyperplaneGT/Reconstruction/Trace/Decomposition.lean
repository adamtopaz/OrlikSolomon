module

public import OrlikSolomon.HyperplaneGT.Reconstruction.Trace.Kernel
public import OrlikSolomon.HyperplaneGT.Algebra.Dual.Coordinates

/-!
# Inertia and decomposition coordinates

The inertia line is the span of the coordinate delta at a hyperplane. Decomposition
functionals vanish on its strict parallels and take equal values on each nonempty trace
fiber. Their explicit coordinates are an arbitrary value at the hyperplane and an arbitrary
function on its intrinsic hyperplanes. The latter is a full function space, with no finite
support restriction.

## Main definitions

* `inertia` is the actual coordinate-delta line in the full algebraic dual.
* `decomposition` is the submodule defined by parallel and guarded-triple coordinate tests.
* `traceFunctional` assigns the explicit functional to its two coordinate components.

Blueprint: `def:l02` and the product-coordinate clause of `lem:l02`.
-/

@[expose] public section

noncomputable section

universe u v

namespace OrlikSolomon.HyperplaneGT

variable {k : Type u} [Field k] {n : ℕ} (R : Type v) [CommRing R]

/-- The line generated by the coordinate delta at a hyperplane, inside the full dual.
Blueprint: `I_H` in `def:l02`. -/
def inertia (H : Hyperplane k n) : Submodule R (Module.Dual R (Hyperplane k n →₀ R)) :=
  Submodule.span R {Finsupp.lapply H}

/-- Inertia membership means being an actual scalar multiple of the coordinate delta. -/
theorem mem_inertia (H : Hyperplane k n) (φ : Module.Dual R (Hyperplane k n →₀ R)) :
    φ ∈ inertia R H ↔ ∃ a : R, a • Finsupp.lapply H = φ :=
  Submodule.mem_span_singleton

/-- Functionals vanishing on strict parallel labels and constant on nonempty trace fibers.
The guarded-triple criterion identifies precisely the distinct labels in those fibers.
Blueprint: `D_H` in `def:l02`. -/
def decomposition (H : Hyperplane k n) :
    Submodule R (Module.Dual R (Hyperplane k n →₀ R)) where
  carrier := {φ | (∀ K, Parallel H K → φ (Finsupp.single K 1) = 0) ∧
    ∀ K L, DependentTriple H K L → φ (Finsupp.single K 1) = φ (Finsupp.single L 1)}
  zero_mem' := ⟨by simp, by simp⟩
  add_mem' := by
    rintro φ ψ ⟨hφp, hφt⟩ ⟨hψp, hψt⟩
    constructor
    · intro K hK
      simp only [LinearMap.add_apply, hφp K hK, hψp K hK, add_zero]
    · intro K L ht
      simp only [LinearMap.add_apply, hφt K L ht, hψt K L ht]
  smul_mem' := by
    rintro a φ ⟨hφp, hφt⟩
    constructor
    · intro K hK
      simp only [LinearMap.smul_apply, hφp K hK, smul_zero]
    · intro K L ht
      simp only [LinearMap.smul_apply, hφt K L ht]

/-- Membership is exactly the two coordinate tests, with all strictness guards retained. -/
@[simp]
theorem mem_decomposition (H : Hyperplane k n) (φ : Module.Dual R (Hyperplane k n →₀ R)) :
    φ ∈ decomposition R H ↔
      (∀ K, Parallel H K → dualCoordinates φ K = 0) ∧
      ∀ K L, DependentTriple H K L → dualCoordinates φ K = dualCoordinates φ L := Iff.rfl

/-- The coordinate delta satisfies the decomposition tests. -/
theorem delta_mem_decomposition (H : Hyperplane k n) :
    (Finsupp.lapply H : Module.Dual R (Hyperplane k n →₀ R)) ∈ decomposition R H := by
  classical
  constructor
  · intro K hK
    simp [hK.1.symm]
  · intro K L ht
    simp [ht.1.symm, ht.2.1.symm]

/-- Every multiple of the coordinate delta belongs to the decomposition submodule. -/
theorem inertia_le_decomposition (H : Hyperplane k n) : inertia R H ≤ decomposition R H := by
  rw [inertia, Submodule.span_singleton_le_iff_mem]
  exact delta_mem_decomposition R H

/-- The functional with prescribed value at the distinguished hyperplane and prescribed
values at its nonempty traces. The two components vary linearly over the coefficient ring.
Blueprint: the explicit inverse in `lem:l02`. -/
def traceFunctional (H : Hyperplane k n) :
    (R × (IntrinsicHyperplane H → R)) →ₗ[R] Module.Dual R (Hyperplane k n →₀ R) := by
  classical
  exact dualCoordinates.symm.toLinearMap.comp (LinearMap.pi fun K ↦
    if hK : K = H then LinearMap.fst R R (IntrinsicHyperplane H → R)
    else (traceLabel H ⟨K, hK⟩).elim 0
      (fun J ↦ (LinearMap.proj J).comp (LinearMap.snd R R (IntrinsicHyperplane H → R))))

/-- The first coordinate is precisely the value at the distinguished hyperplane. -/
@[simp]
theorem traceFunctional_self (H : Hyperplane k n) (a : R) (b : IntrinsicHyperplane H → R) :
    traceFunctional R H (a, b) (Finsupp.single H 1) = a := by
  classical
  change dualCoordinates (traceFunctional R H (a, b)) H = a
  simp [traceFunctional]

/-- A nonempty trace is assigned its specified trace coordinate. -/
theorem traceFunctional_of_traceLabel (H : Hyperplane k n)
    (K : {K : Hyperplane k n // K ≠ H}) (J : IntrinsicHyperplane H)
    (hK : traceLabel H K = some J) (a : R) (b : IntrinsicHyperplane H → R) :
    traceFunctional R H (a, b) (Finsupp.single K.val 1) = b J := by
  classical
  change dualCoordinates (traceFunctional R H (a, b)) K.val = b J
  simp [traceFunctional, K.property, hK]

/-- Strict parallel labels are assigned zero, independently of both coordinate components. -/
theorem traceFunctional_of_parallel (H K : Hyperplane k n) (hK : Parallel H K)
    (a : R) (b : IntrinsicHyperplane H → R) :
    traceFunctional R H (a, b) (Finsupp.single K 1) = 0 := by
  classical
  have ht := (traceLabel_eq_none_iff H ⟨K, hK.1.symm⟩).mpr hK
  change dualCoordinates (traceFunctional R H (a, b)) K = 0
  simp [traceFunctional, hK.1.symm, ht]

/-- Every prescribed coordinate pair gives an actual decomposition functional. -/
theorem traceFunctional_mem_decomposition (H : Hyperplane k n)
    (a : R) (b : IntrinsicHyperplane H → R) :
    traceFunctional R H (a, b) ∈ decomposition R H := by
  constructor
  · intro K hK
    exact traceFunctional_of_parallel R H K hK a b
  · intro K L ht
    let K' : {K : Hyperplane k n // K ≠ H} := ⟨K, ht.1.symm⟩
    let L' : {L : Hyperplane k n // L ≠ H} := ⟨L, ht.2.1.symm⟩
    obtain ⟨J, hK, hL⟩ := (exists_common_traceLabel_iff H K' L' ht.2.2.1).mpr ht
    exact (traceFunctional_of_traceLabel R H K' J hK a b).trans
      (traceFunctional_of_traceLabel R H L' J hL a b).symm

/-- The value at the distinguished label and all trace values determine the coordinate pair.
Surjectivity on trace labels is used here, including when the trace label type is empty. -/
theorem traceFunctional_injective (H : Hyperplane k n) :
    Function.Injective (traceFunctional R H) := by
  rintro ⟨a, b⟩ ⟨a', b'⟩ heq
  apply Prod.ext
  · have hv := congrArg (fun φ : Module.Dual R (Hyperplane k n →₀ R) ↦
        φ (Finsupp.single H 1)) heq
    simpa only [traceFunctional_self] using hv
  · funext J
    obtain ⟨K, hK⟩ := traceLabel_surjective H J
    have hv := congrArg (fun φ : Module.Dual R (Hyperplane k n →₀ R) ↦
        φ (Finsupp.single K.val 1)) heq
    simpa only [traceFunctional_of_traceLabel R H K J hK] using hv

private theorem exists_traceFunctional_of_mem_decomposition (H : Hyperplane k n)
    (φ : Module.Dual R (Hyperplane k n →₀ R)) (hφ : φ ∈ decomposition R H) :
    ∃ p, traceFunctional R H p = φ := by
  classical
  let representative (J : IntrinsicHyperplane H) := (traceLabel_surjective H J).choose
  have hr (J : IntrinsicHyperplane H) : traceLabel H (representative J) = some J :=
    (traceLabel_surjective H J).choose_spec
  let b (J : IntrinsicHyperplane H) : R := φ (Finsupp.single (representative J).val 1)
  refine ⟨(φ (Finsupp.single H 1), b), dualCoordinates_ext fun K ↦ ?_⟩
  by_cases hKH : K = H
  · subst K
    exact traceFunctional_self R H _ _
  · let K' : {K : Hyperplane k n // K ≠ H} := ⟨K, hKH⟩
    cases ht : traceLabel H K' with
    | none =>
      have hp := (traceLabel_eq_none_iff H K').mp ht
      exact (traceFunctional_of_parallel R H K hp _ _).trans (hφ.1 K hp).symm
    | some J =>
      rw [traceFunctional_of_traceLabel R H K' J ht]
      change φ (Finsupp.single (representative J).val 1) = φ (Finsupp.single K 1)
      by_cases hKr : K = (representative J).val
      · rw [hKr]
      · have hdep := (exists_common_traceLabel_iff H K' (representative J) hKr).mp
          ⟨J, ht, hr J⟩
        exact (hφ.2 K (representative J).val hdep).symm

/-- The explicit coordinate assignment, with codomain restricted to actual decomposition
functionals. -/
def decompositionCoordinates (H : Hyperplane k n) :
    (R × (IntrinsicHyperplane H → R)) →ₗ[R] decomposition R H :=
  (traceFunctional R H).codRestrict (decomposition R H)
    (fun p ↦ traceFunctional_mem_decomposition R H p.1 p.2)

/-- Every decomposition functional has exactly one explicit coordinate pair. -/
theorem decompositionCoordinates_bijective (H : Hyperplane k n) :
    Function.Bijective (decompositionCoordinates R H) := by
  constructor
  · intro p q hpq
    exact traceFunctional_injective R H (congrArg Subtype.val hpq)
  · intro φ
    obtain ⟨p, hp⟩ := exists_traceFunctional_of_mem_decomposition R H φ.val φ.property
    exact ⟨p, Subtype.ext hp⟩

/-- Decomposition functionals are the product of their value at the distinguished hyperplane
and their arbitrary function on all intrinsic traces. No finite support condition is imposed
on the latter. Blueprint: the explicit product equivalence in `lem:l02`. -/
def decompositionEquiv (H : Hyperplane k n) :
    decomposition R H ≃ₗ[R] R × (IntrinsicHyperplane H → R) :=
  (LinearEquiv.ofBijective (decompositionCoordinates R H)
    (decompositionCoordinates_bijective R H)).symm

/-- The inverse equivalence is the explicit coordinate functional. -/
@[simp]
theorem coe_decompositionEquiv_symm (H : Hyperplane k n)
    (p : R × (IntrinsicHyperplane H → R)) :
    ((decompositionEquiv R H).symm p : Module.Dual R (Hyperplane k n →₀ R)) =
      traceFunctional R H p := rfl

/-- The first component records exactly the distinguished coordinate value. -/
@[simp]
theorem decompositionEquiv_fst (H : Hyperplane k n) (φ : decomposition R H) :
    (decompositionEquiv R H φ).1 = φ.val (Finsupp.single H 1) := by
  have hs := congrArg Subtype.val ((decompositionEquiv R H).symm_apply_apply φ)
  change traceFunctional R H ((decompositionEquiv R H φ).1,
    (decompositionEquiv R H φ).2) = φ.val at hs
  have hv := congrArg (fun ψ : Module.Dual R (Hyperplane k n →₀ R) ↦
    ψ (Finsupp.single H 1)) hs
  simpa only [traceFunctional_self] using hv

/-- A trace component may be read using any of its representatives. -/
theorem decompositionEquiv_snd_apply_of_traceLabel (H : Hyperplane k n)
    (φ : decomposition R H) (K : {K : Hyperplane k n // K ≠ H})
    (J : IntrinsicHyperplane H) (hK : traceLabel H K = some J) :
    (decompositionEquiv R H φ).2 J = φ.val (Finsupp.single K.val 1) := by
  have hs := congrArg Subtype.val ((decompositionEquiv R H).symm_apply_apply φ)
  change traceFunctional R H ((decompositionEquiv R H φ).1,
    (decompositionEquiv R H φ).2) = φ.val at hs
  have hv := congrArg (fun ψ : Module.Dual R (Hyperplane k n →₀ R) ↦
    ψ (Finsupp.single K.val 1)) hs
  simpa only [traceFunctional_of_traceLabel R H K J hK] using hv

/-- Setting every trace coordinate to zero leaves precisely the prescribed multiple of delta.
-/
theorem traceFunctional_zero_snd (H : Hyperplane k n) (a : R) :
    traceFunctional R H (a, 0) = a • Finsupp.lapply H := by
  classical
  apply dualCoordinates_ext
  intro K
  by_cases hKH : K = H
  · subst K
    simp
  · let K' : {K : Hyperplane k n // K ≠ H} := ⟨K, hKH⟩
    cases ht : traceLabel H K' with
    | none =>
      have hp := (traceLabel_eq_none_iff H K').mp ht
      simp [traceFunctional_of_parallel R H K hp, hKH]
    | some J =>
      simpa [K', hKH] using traceFunctional_of_traceLabel R H K' J ht a 0

/-- Forget the value at the distinguished label and retain the full trace function.
Blueprint: the second projection in `lem:l02`. -/
def decompositionTrace (H : Hyperplane k n) :
    decomposition R H →ₗ[R] (IntrinsicHyperplane H → R) :=
  (LinearMap.snd R R (IntrinsicHyperplane H → R)).comp (decompositionEquiv R H).toLinearMap

/-- The trace projection is the second component of the explicit equivalence. -/
@[simp]
theorem decompositionTrace_apply (H : Hyperplane k n) (φ : decomposition R H) :
    decompositionTrace R H φ = (decompositionEquiv R H φ).2 := rfl

/-- Every full trace function occurs as the trace component of a decomposition functional. -/
theorem decompositionTrace_surjective (H : Hyperplane k n) :
    Function.Surjective (decompositionTrace R H) := by
  intro b
  refine ⟨(decompositionEquiv R H).symm (0, b), ?_⟩
  simp

/-- The zero-trace decomposition functionals are exactly the inertia line, with its actual
inclusion in decomposition. Blueprint: the kernel assertion of `lem:l02`. -/
theorem ker_decompositionTrace (H : Hyperplane k n) :
    LinearMap.ker (decompositionTrace R H) =
      (inertia R H).comap (decomposition R H).subtype := by
  ext φ
  change decompositionTrace R H φ = 0 ↔ φ.val ∈ inertia R H
  constructor
  · intro hφ
    rw [mem_inertia]
    refine ⟨(decompositionEquiv R H φ).1, ?_⟩
    have hs := congrArg Subtype.val ((decompositionEquiv R H).symm_apply_apply φ)
    change traceFunctional R H ((decompositionEquiv R H φ).1,
      (decompositionEquiv R H φ).2) = φ.val at hs
    change (decompositionEquiv R H φ).2 = 0 at hφ
    rw [hφ, traceFunctional_zero_snd] at hs
    exact hs
  · intro hφ
    obtain ⟨a, ha⟩ := (mem_inertia R H φ.val).mp hφ
    have heq : φ = (decompositionEquiv R H).symm (a, 0) := by
      apply Subtype.ext
      rw [coe_decompositionEquiv_symm, traceFunctional_zero_snd, ha]
    rw [heq]
    simp

/-- On the trace domain the explicit functional evaluates by pairing its trace function with
the actual trace map. Its distinguished coordinate makes no contribution. -/
theorem traceFunctional_apply_coe (H : Hyperplane k n) (a : R)
    (b : IntrinsicHyperplane H → R) (x : traceDomain R H) :
    traceFunctional R H (a, b) x.val = dualCoordinates.symm b (traceMap R H x) := by
  classical
  have hmaps : ((traceFunctional R H (a, b)).comp (traceDomain R H).subtype).comp
        (traceDomainEquiv R H).symm.toLinearMap =
      ((dualCoordinates.symm b).comp (traceMap R H)).comp
        (traceDomainEquiv R H).symm.toLinearMap := by
    apply Finsupp.lhom_ext
    intro K r
    change traceFunctional R H (a, b) (traceSingle R H K r).val =
      dualCoordinates.symm b (traceMap R H (traceSingle R H K r))
    rw [coe_traceSingle, traceMap_traceSingle]
    have hs : Finsupp.single K.val r = r • Finsupp.single K.val (1 : R) := by simp
    rw [hs, map_smul]
    cases ht : traceLabel H K with
    | none =>
      rw [traceFunctional_of_parallel R H K.val ((traceLabel_eq_none_iff H K).mp ht)]
      simp
    | some J =>
      rw [traceFunctional_of_traceLabel R H K J ht]
      simp
  have he := DFunLike.congr_fun hmaps (traceDomainEquiv R H x)
  simpa only [LinearMap.comp_apply, LinearEquiv.coe_toLinearMap,
    LinearEquiv.symm_apply_apply, Submodule.subtype_apply] using he

end OrlikSolomon.HyperplaneGT
