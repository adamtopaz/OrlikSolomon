module

public import OrlikSolomon.HyperplaneGT.Reconstruction.Trace.Map

/-!
# The complete kernel of the hyperplane trace map

The trace kernel is viewed as an ambient submodule of the literal universal free module.
The generic optional-label kernel calculation gives its generators: discarded labels are
strict parallel hyperplanes, and two distinct labels with a common retained trace form a
guarded dependent triple. Equal source labels contribute only zero.

## Main results

* `traceKernel` embeds the actual kernel of `traceMap` into the universal module.
* `traceKernel_eq_span` identifies its entire parallel/triple generator span.

Blueprint: the kernel assertion of L01 (`lem:l01`).
-/

@[expose] public section

noncomputable section

universe u v

namespace OrlikSolomon.HyperplaneGT

variable {k : Type u} [Field k] {n : ℕ} (R : Type v) [Ring R]

/-- The kernel of the actual trace map, viewed inside the literal universal free module.

Blueprint: `U_H¹` in `lem:l01`. -/
def traceKernel (H : Hyperplane k n) : Submodule R (Hyperplane k n →₀ R) :=
  (LinearMap.ker (traceMap R H)).map (traceDomain R H).subtype

/-- Every trace-kernel vector has coefficient zero at the fixed hyperplane. -/
theorem traceKernel_le_traceDomain (H : Hyperplane k n) :
    traceKernel R H ≤ traceDomain R H := by
  rintro _ ⟨x, _, rfl⟩
  exact x.property

/-- For a vector already in the trace domain, ambient kernel membership is exactly vanishing
of its trace. -/
@[simp]
theorem coe_mem_traceKernel_iff (H : Hyperplane k n) (x : traceDomain R H) :
    (x : Hyperplane k n →₀ R) ∈ traceKernel R H ↔ traceMap R H x = 0 := by
  constructor
  · rintro ⟨y, hy, hyx⟩
    have heq : y = x := Subtype.ext hyx
    change traceMap R H y = 0 at hy
    exact heq ▸ hy
  · intro hx
    exact ⟨x, hx, rfl⟩

private theorem traceKernel_eq_map_finsuppOptionRelationSpan (H : Hyperplane k n) :
    traceKernel R H = (finsuppOptionRelationSpan (R := R) (traceLabel H)).map
      (Finsupp.lmapDomain R R (Subtype.val : {K : Hyperplane k n // K ≠ H} → Hyperplane k n)) := by
  have hker : LinearMap.ker (traceMap R H) =
      (LinearMap.ker (finsuppOptionMap (R := R) (traceLabel H))).map
        (traceDomainEquiv R H).symm.toLinearMap := by
    rw [Submodule.map_equiv_eq_comap_symm, LinearEquiv.symm_symm]
    rfl
  rw [traceKernel, hker, ← Submodule.map_comp, traceDomain_subtype_comp_symm,
    ker_finsuppOptionMap]

/-- The whole trace kernel is generated by strict parallel labels and the differences from
nonempty dependent triples. The empty-intersection and distinctness guards are retained, and
no nontriviality, locality or commutativity assumption on the coefficient ring is needed.

Blueprint: the exact kernel formula in `lem:l01`. -/
theorem traceKernel_eq_span (H : Hyperplane k n) :
    traceKernel R H = Submodule.span R {x |
      (∃ K : Hyperplane k n, Parallel H K ∧ x = Finsupp.single K 1) ∨
      ∃ K L : Hyperplane k n, DependentTriple H K L ∧
        x = Finsupp.single K 1 - Finsupp.single L 1} := by
  rw [traceKernel_eq_map_finsuppOptionRelationSpan, finsuppOptionRelationSpan, Submodule.map_span]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨x, hx, rfl⟩
    rcases hx with hdiscard | hmerge
    · obtain ⟨K, hK, rfl⟩ := hdiscard
      simp only [Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      exact Submodule.subset_span
        (Or.inl ⟨K.val, (traceLabel_eq_none_iff H K).mp hK, rfl⟩)
    · obtain ⟨K, L, J, hK, hL, rfl⟩ := hmerge
      simp only [map_sub, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      by_cases hKL : K.val = L.val
      · rw [hKL, sub_self]
        exact Submodule.zero_mem _
      · have hdep := (exists_common_traceLabel_iff H K L hKL).mp ⟨J, hK, hL⟩
        exact Submodule.subset_span (Or.inr ⟨K.val, L.val, hdep, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro x (hparallel | htriple)
    · obtain ⟨K, hK, rfl⟩ := hparallel
      let K' : {K : Hyperplane k n // K ≠ H} := ⟨K, hK.1.symm⟩
      have ht : traceLabel H K' = none := (traceLabel_eq_none_iff H K').mpr hK
      apply Submodule.subset_span
      refine ⟨Finsupp.single K' 1, Or.inl ⟨K', ht, rfl⟩, ?_⟩
      simp only [Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      rfl
    · obtain ⟨K, L, hdep, rfl⟩ := htriple
      let K' : {K : Hyperplane k n // K ≠ H} := ⟨K, hdep.1.symm⟩
      let L' : {L : Hyperplane k n // L ≠ H} := ⟨L, hdep.2.1.symm⟩
      obtain ⟨J, hK, hL⟩ := (exists_common_traceLabel_iff H K' L' hdep.2.2.1).mpr hdep
      apply Submodule.subset_span
      refine ⟨Finsupp.single K' 1 - Finsupp.single L' 1,
        Or.inr ⟨K', L', J, hK, hL, rfl⟩, ?_⟩
      simp only [map_sub, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      rfl

end OrlikSolomon.HyperplaneGT
