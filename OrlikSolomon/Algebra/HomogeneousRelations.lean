module

public import Mathlib.LinearAlgebra.ExteriorAlgebra.Grading
public import OrlikSolomon.Algebra.RelationQuotient

/-!
# Relations in their lowest homogeneous degree

In a nonnegatively graded algebra, if every relator is homogeneous of degree at least `d`,
then the degree-`d` part of its two-sided relation submodule is spanned by degree-`d`
relators with degree-zero left and right contexts. If degree zero consists of scalars, those
contexts can be absorbed into the coefficients.

The algebra need not be commutative, and the coefficient ring need not be nonzero or a field.
The exterior-algebra specialization gives the kernel of a homogeneous quotient map without
assuming that its higher relations are generated by their lowest-degree part.

## Main results

* `relationSubmodule_inf_eq_span_degreeZeroContexts` describes the lowest relation component
  without a scalar-image assumption on degree zero.
* `relationSubmodule_inf_eq_span_of_degreeZero_le_range` absorbs degree-zero contexts into
  coefficients when they lie in the scalar image.
* `exteriorAlgebra_quotient_ker_eq_comap_span` specializes this to the kernel on an exterior
  power of a quotient by homogeneous relations.

Blueprint: the generic homogeneous-projection argument in M8 node `A02` (`thm:a02`). The
geometric identification of the degree-two relators is separate from this algebraic result.
-/

@[expose] public section

namespace OrlikSolomon

section Graded

variable {R T : Type*} [CommSemiring R] [Ring T] [Algebra R T]
  (𝒜 : ℕ → Submodule R T) [GradedAlgebra 𝒜] {ℛ : Set T} {d : ℕ}

/-- Projection to the lowest possible relator degree retains only degree-zero contexts and
relators of that degree. No assumption that degree zero consists of scalars is needed.

Blueprint: the homogeneous-projection argument of M8 node `A02`. -/
theorem relationSubmodule_proj_mem_span_degreeZeroContexts
    (hℛ : ∀ r ∈ ℛ, ∃ m, d ≤ m ∧ r ∈ 𝒜 m) {x : T}
    (hx : x ∈ relationSubmodule R ℛ) :
    GradedAlgebra.proj 𝒜 d x ∈ Submodule.span R
      {y | ∃ a ∈ 𝒜 0, ∃ r ∈ ℛ, r ∈ 𝒜 d ∧ ∃ b ∈ 𝒜 0, y = a * r * b} := by
  let N := Submodule.span R
    {y | ∃ a ∈ 𝒜 0, ∃ r ∈ ℛ, r ∈ 𝒜 d ∧ ∃ b ∈ 𝒜 0, y = a * r * b}
  suffices relationSubmodule R ℛ ≤ N.comap (GradedAlgebra.proj 𝒜 d) from this hx
  refine relationSubmodule_le_of_span_eq_top (span_isHomogeneousElem_eq_top R 𝒜)
    (span_isHomogeneousElem_eq_top R 𝒜) ?_
  rintro a ⟨i, ha⟩ r hr b ⟨j, hb⟩
  obtain ⟨m, hdm, hrm⟩ := hℛ r hr
  have hab := SetLike.mul_mem_graded (SetLike.mul_mem_graded ha hrm) hb
  change GradedAlgebra.proj 𝒜 d (a * r * b) ∈ N
  rw [GradedAlgebra.proj_apply]
  by_cases h : i + m + j = d
  · have hi : i = 0 := by omega
    have hm : m = d := by omega
    have hj : j = 0 := by omega
    subst i m j
    rw [DirectSum.decompose_of_mem_same 𝒜 (by simpa using hab)]
    exact Submodule.subset_span ⟨a, ha, r, hr, hrm, b, hb, rfl⟩
  · rw [DirectSum.decompose_of_mem_ne 𝒜 hab h]
    exact N.zero_mem

/-- The lowest homogeneous part of a two-sided relation submodule is the span of the
corresponding relators with degree-zero contexts. The grading is by natural numbers, so
positive context degrees cannot contribute to this component.

Blueprint: the homogeneous-projection argument of M8 node `A02`. -/
theorem relationSubmodule_inf_eq_span_degreeZeroContexts
    (hℛ : ∀ r ∈ ℛ, ∃ m, d ≤ m ∧ r ∈ 𝒜 m) :
    relationSubmodule R ℛ ⊓ 𝒜 d = Submodule.span R
      {y | ∃ a ∈ 𝒜 0, ∃ r ∈ ℛ, r ∈ 𝒜 d ∧ ∃ b ∈ 𝒜 0, y = a * r * b} := by
  refine le_antisymm ?_ (Submodule.span_le.2 ?_)
  · intro x hx
    have h := relationSubmodule_proj_mem_span_degreeZeroContexts 𝒜 hℛ hx.1
    rwa [GradedAlgebra.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hx.2] at h
  · rintro _ ⟨a, ha, r, hr, hrd, b, hb, rfl⟩
    refine ⟨mul_mul_mem_relationSubmodule R a hr b, ?_⟩
    simpa using SetLike.mul_mem_graded (SetLike.mul_mem_graded ha hrd) hb

/-- If every degree-zero element comes from the coefficient semiring, the lowest homogeneous
part of the relation submodule is the scalar span of the relators in that degree. The
scalar-image assumption does not require injectivity of the coefficient map.

Blueprint: the scalar-context argument of M8 node `A02`. -/
theorem relationSubmodule_inf_eq_span_of_degreeZero_le_range
    (hℛ : ∀ r ∈ ℛ, ∃ m, d ≤ m ∧ r ∈ 𝒜 m)
    (hzero : 𝒜 0 ≤ (Algebra.linearMap R T).range) :
    relationSubmodule R ℛ ⊓ 𝒜 d = Submodule.span R (ℛ ∩ (𝒜 d : Set T)) := by
  rw [relationSubmodule_inf_eq_span_degreeZeroContexts 𝒜 hℛ]
  refine le_antisymm (Submodule.span_le.2 ?_) (Submodule.span_le.2 ?_)
  · rintro _ ⟨a, ha, r, hr, hrd, b, hb, rfl⟩
    obtain ⟨s, rfl⟩ := hzero ha
    obtain ⟨t, rfl⟩ := hzero hb
    have h := (Submodule.span R (ℛ ∩ (𝒜 d : Set T))).smul_mem s
      ((Submodule.span R (ℛ ∩ (𝒜 d : Set T))).smul_mem t
        (Submodule.subset_span ⟨hr, hrd⟩))
    change algebraMap R T s * r * algebraMap R T t ∈
      Submodule.span R (ℛ ∩ (𝒜 d : Set T))
    rw [mul_assoc, ← Algebra.commutes t r]
    simpa only [Algebra.smul_def] using h
  · rintro r ⟨hr, hrd⟩
    exact Submodule.subset_span
      ⟨1, SetLike.one_mem_graded 𝒜, r, hr, hrd, 1, SetLike.one_mem_graded 𝒜, by simp⟩

end Graded

section Exterior

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  {ℛ : Set (ExteriorAlgebra R M)} {d : ℕ}

/-- In the lowest relator degree, an exterior-algebra quotient has precisely the scalar span
of its homogeneous relators as kernel. In particular this applies at degree two over arbitrary
commutative rings, including characteristic two and the zero ring.

This is the algebraic input for M8 node `A02`; the later application must identify which
relators lie in degree two. -/
theorem exteriorAlgebra_quotient_eq_zero_iff
    (hℛ : ∀ r ∈ ℛ, ∃ m, d ≤ m ∧ r ∈ ⋀[R]^m M) (x : ⋀[R]^d M) :
    RelationQuotient.mk ℛ (x : ExteriorAlgebra R M) = 0 ↔
      (x : ExteriorAlgebra R M) ∈ Submodule.span R (ℛ ∩ (⋀[R]^d M : Set _)) := by
  have hzero : (⋀[R]^0 M) ≤ (Algebra.linearMap R (ExteriorAlgebra R M)).range := by
    intro a ha
    exact Submodule.mem_one.mp (by simpa only [ExteriorAlgebra.exteriorPower, pow_zero] using ha)
  have h := relationSubmodule_inf_eq_span_of_degreeZero_le_range (fun m ↦ ⋀[R]^m M) hℛ hzero
  rw [RelationQuotient.mk_eq_zero_iff R]
  constructor
  · intro hx
    exact h ▸ (show (x : ExteriorAlgebra R M) ∈ relationSubmodule R ℛ ⊓ (⋀[R]^d M) from
      ⟨hx, x.2⟩)
  · intro hx
    exact (show (x : ExteriorAlgebra R M) ∈ relationSubmodule R ℛ ⊓ (⋀[R]^d M) from h ▸ hx).1

/-- The kernel of an exterior-algebra quotient restricted to its lowest relator degree is the
inverse image of the scalar span of the relators in that degree. This is a statement about the
actual quotient map, and applies to the quadratic kernel at `d = 2`.

Blueprint: the homogeneous-projection argument of M8 node `A02`. -/
theorem exteriorAlgebra_quotient_ker_eq_comap_span
    (hℛ : ∀ r ∈ ℛ, ∃ m, d ≤ m ∧ r ∈ ⋀[R]^m M) :
    LinearMap.ker ((RelationQuotient.mkₐ R ℛ).toLinearMap.comp (⋀[R]^d M).subtype) =
      (Submodule.span R (ℛ ∩ (⋀[R]^d M : Set _))).comap (⋀[R]^d M).subtype := by
  ext x
  exact exteriorAlgebra_quotient_eq_zero_iff hℛ x

end Exterior

end OrlikSolomon
