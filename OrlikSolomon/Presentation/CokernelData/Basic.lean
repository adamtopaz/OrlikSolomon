module

public import OrlikSolomon.Presentation.Grading

/-!
# The module cokernel of deletion

`OSAlgebra.DeletionCokernel` is the module quotient by the linear range of the deletion map.
The old image contains the unit, so its ideal quotient would be zero and is not used here.
The preliminary representative map is linear: it sends a restricted exterior word to the
class of the same old word preceded by the deleted generator.

Blueprint: the module quotient and preliminary map in `def:lift-map`.
-/

@[expose] public section

noncomputable section

universe u v

namespace OrlikSolomon.OSAlgebra

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V]
  (B : Type v) [CommRing B] (𝒜 : Arrangement k V) (H : AffineSubspace k V)

/-- The old image is the range of the deletion map as a `B`-linear map. It is a submodule,
not the ideal generated by the old generators. Blueprint: `def:lift-map`. -/
def deletionRange : Submodule B (OSAlgebra B 𝒜) :=
  LinearMap.range (deletionMap B 𝒜 H).toLinearMap

/-- The module cokernel of deletion. Its quotient is taken only in `B`-modules.
Blueprint: `def:lift-map`. -/
def DeletionCokernel : Type (max u v) :=
  OSAlgebra B 𝒜 ⧸ deletionRange B 𝒜 H

instance : AddCommGroup (DeletionCokernel B 𝒜 H) :=
  inferInstanceAs (AddCommGroup (OSAlgebra B 𝒜 ⧸ deletionRange B 𝒜 H))

instance {R : Type*} [CommSemiring R] [Algebra R B] : Module R (DeletionCokernel B 𝒜 H) :=
  inferInstanceAs (Module R (OSAlgebra B 𝒜 ⧸ deletionRange B 𝒜 H))

instance {R S : Type*} [CommSemiring R] [CommSemiring S] [Algebra R B] [Algebra S B]
    [SMul R S] [IsScalarTower R S B] : IsScalarTower R S (DeletionCokernel B 𝒜 H) :=
  inferInstanceAs (IsScalarTower R S (OSAlgebra B 𝒜 ⧸ deletionRange B 𝒜 H))

/-- The linear quotient map to the deletion cokernel. -/
def cokernelMk : OSAlgebra B 𝒜 →ₗ[B] DeletionCokernel B 𝒜 H :=
  (deletionRange B 𝒜 H).mkQ

/-- Every element of the deletion cokernel has a representative in the affine presentation. -/
theorem cokernelMk_surjective : Function.Surjective (cokernelMk B 𝒜 H) :=
  (deletionRange B 𝒜 H).mkQ_surjective

/-- A class in the deletion cokernel is zero exactly when it comes from deletion. -/
@[simp]
theorem cokernelMk_eq_zero_iff {x : OSAlgebra B 𝒜} :
    cokernelMk B 𝒜 H x = 0 ↔ x ∈ deletionRange B 𝒜 H :=
  Submodule.Quotient.mk_eq_zero _

/-- Two representatives define the same cokernel class exactly when their difference is old. -/
theorem cokernelMk_eq_iff {x y : OSAlgebra B 𝒜} :
    cokernelMk B 𝒜 H x = cokernelMk B 𝒜 H y ↔ x - y ∈ deletionRange B 𝒜 H := by
  rw [← sub_eq_zero, ← map_sub, cokernelMk_eq_zero_iff]

/-- The old image contains every element obtained by the deletion map. -/
theorem deletionMap_mem_deletionRange (x : OSAlgebra B (𝒜.deletion H)) :
    deletionMap B 𝒜 H x ∈ deletionRange B 𝒜 H :=
  ⟨x, rfl⟩

/-- The old image contains the unit; this is why an ideal quotient would be inappropriate. -/
theorem one_mem_deletionRange : (1 : OSAlgebra B 𝒜) ∈ deletionRange B 𝒜 H :=
  ⟨1, map_one (deletionMap B 𝒜 H)⟩

/-- The unit is old, so its class in the module cokernel is zero. -/
@[simp]
theorem cokernelMk_one : cokernelMk B 𝒜 H 1 = 0 :=
  (cokernelMk_eq_zero_iff B 𝒜 H).2 (one_mem_deletionRange B 𝒜 H)

/-- Products of old elements are old. This asserts stability only by other old elements. -/
theorem mul_mem_deletionRange {x y : OSAlgebra B 𝒜}
    (hx : x ∈ deletionRange B 𝒜 H) (hy : y ∈ deletionRange B 𝒜 H) :
    x * y ∈ deletionRange B 𝒜 H := by
  obtain ⟨x, rfl⟩ := hx
  obtain ⟨y, rfl⟩ := hy
  exact ⟨x * y, map_mul (deletionMap B 𝒜 H) x y⟩

/-- Multiplying a difference in the old image on either side by old elements leaves its
cokernel class unchanged. This does not assert that the old image is an ideal. -/
theorem cokernelMk_mul_mul_eq_of_sub_mem {u x y v : OSAlgebra B 𝒜}
    (hu : u ∈ deletionRange B 𝒜 H) (hv : v ∈ deletionRange B 𝒜 H)
    (hxy : x - y ∈ deletionRange B 𝒜 H) :
    cokernelMk B 𝒜 H (u * x * v) = cokernelMk B 𝒜 H (u * y * v) := by
  apply (cokernelMk_eq_iff B 𝒜 H).2
  rw [← sub_mul, ← mul_sub]
  exact mul_mem_deletionRange B 𝒜 H (mul_mem_deletionRange B 𝒜 H hu hxy) hv

/-- The class of an old element is zero. -/
@[simp]
theorem cokernelMk_deletionMap (x : OSAlgebra B (𝒜.deletion H)) :
    cokernelMk B 𝒜 H (deletionMap B 𝒜 H x) = 0 :=
  (cokernelMk_eq_zero_iff B 𝒜 H).2 ⟨x, rfl⟩

variable {H}

/-- An old generator belongs to the deletion image. -/
theorem generator_mem_deletionRange (K : 𝒜.deletion H) :
    generator B 𝒜 (Arrangement.inclusion (𝒜.deletion_le H) K) ∈ deletionRange B 𝒜 H := by
  rw [← deletionMap_generator]
  exact deletionMap_mem_deletionRange B 𝒜 H _

/-- A word in old generators belongs to the deletion image. -/
theorem word_mem_deletionRange (I : List (𝒜.deletion H)) :
    word (fun K ↦ generator B 𝒜 (Arrangement.inclusion (𝒜.deletion_le H) K)) I ∈
      deletionRange B 𝒜 H := by
  refine ⟨word (generator B (𝒜.deletion H)) I, ?_⟩
  change deletionMap B 𝒜 H (word (generator B (𝒜.deletion H)) I) = _
  simp only [OrlikSolomon.map_word, deletionMap_generator]

/-- Chosen old representatives define an algebra map from the restricted exterior algebra to
the deletion algebra. There is no assertion that it descends as an algebra map. -/
def representativeLift (r : 𝒜.restriction H → 𝒜.deletion H) :
    ExteriorAlgebra B (𝒜.restriction H →₀ B) →ₐ[B] OSAlgebra B (𝒜.deletion H) :=
  exteriorLift B ⟨_, (isExteriorFamily_generator B (𝒜.deletion H)).comp r⟩

@[simp]
theorem representativeLift_exteriorGen (r : 𝒜.restriction H → 𝒜.deletion H)
    (L : 𝒜.restriction H) :
    representativeLift B 𝒜 r (exteriorGen B L) = generator B (𝒜.deletion H) (r L) :=
  exteriorLift_exteriorGen _ _ _

/-- The chosen old representatives, viewed as a family of generators in the original algebra. -/
def representativeGenerator (r : 𝒜.restriction H → 𝒜.deletion H) (L : 𝒜.restriction H) :
    OSAlgebra B 𝒜 :=
  generator B 𝒜 (Arrangement.inclusion (𝒜.deletion_le H) (r L))

/-- The old representative map followed by deletion is an algebra map on exterior algebras. -/
def representativeMap (r : 𝒜.restriction H → 𝒜.deletion H) :
    ExteriorAlgebra B (𝒜.restriction H →₀ B) →ₐ[B] OSAlgebra B 𝒜 :=
  (deletionMap B 𝒜 H).comp (representativeLift B 𝒜 r)

@[simp]
theorem representativeMap_exteriorGen (r : 𝒜.restriction H → 𝒜.deletion H)
    (L : 𝒜.restriction H) :
    representativeMap B 𝒜 r (exteriorGen B L) = representativeGenerator B 𝒜 r L := by
  simp [representativeMap, representativeGenerator]

/-- The representative map sends exterior words to their old generator words. -/
@[simp]
theorem representativeMap_word (r : 𝒜.restriction H → 𝒜.deletion H)
    (I : List (𝒜.restriction H)) :
    representativeMap B 𝒜 r (word (exteriorGen B) I) = word (representativeGenerator B 𝒜 r) I := by
  simp

/-- The representative map sends signed boundaries to the same signed old boundaries. -/
@[simp]
theorem representativeMap_wordBoundary (r : 𝒜.restriction H → 𝒜.deletion H)
    (I : List (𝒜.restriction H)) :
    representativeMap B 𝒜 r (wordBoundary (exteriorGen B) I) =
      wordBoundary (representativeGenerator B 𝒜 r) I := by
  simp

/-- Every value of the representative algebra map is old. -/
theorem representativeMap_mem_deletionRange (r : 𝒜.restriction H → 𝒜.deletion H)
    (x : ExteriorAlgebra B (𝒜.restriction H →₀ B)) :
    representativeMap B 𝒜 r x ∈ deletionRange B 𝒜 H :=
  ⟨representativeLift B 𝒜 r x, rfl⟩

variable (H : 𝒜)

/-- The preliminary linear map on the restricted exterior algebra: take old representatives,
multiply by the deleted generator on the left, then pass to the module cokernel.
Blueprint: the map `s₀` in `def:lift-map`. -/
def preRestrictionToCokernel (r : 𝒜.restriction H → 𝒜.deletion H) :
    ExteriorAlgebra B (𝒜.restriction H →₀ B) →ₗ[B] DeletionCokernel B 𝒜 H :=
  (cokernelMk B 𝒜 H).comp
    ((LinearMap.mulLeft B (generator B 𝒜 H)).comp (representativeMap B 𝒜 r).toLinearMap)

/-- The preliminary map is multiplication by the deleted generator, followed by the module
quotient map. It is not an algebra map. -/
theorem preRestrictionToCokernel_apply (r : 𝒜.restriction H → 𝒜.deletion H)
    (x : ExteriorAlgebra B (𝒜.restriction H →₀ B)) :
    preRestrictionToCokernel B 𝒜 H r x =
      cokernelMk B 𝒜 H (generator B 𝒜 H * representativeMap B 𝒜 r x) := rfl

/-- To kill all two-sided contexts of the restricted relators, it suffices that left
multiplication by the deleted generator carries each relator into the old image. The proof
expands the left context in exterior words and moves the deleted generator past each word
with its exterior sign. Right multiplication is only by an old element.
Blueprint: the context argument in `def:lift-map`. -/
theorem preRestrictionToCokernel_context_eq_zero
    (r : 𝒜.restriction H → 𝒜.deletion H)
    (hrel : ∀ x ∈ osRelations B (𝒜.restriction H),
      generator B 𝒜 H * representativeMap B 𝒜 r x ∈ deletionRange B 𝒜 H)
    (u : ExteriorAlgebra B (𝒜.restriction H →₀ B))
    (x : ExteriorAlgebra B (𝒜.restriction H →₀ B)) (hx : x ∈ osRelations B (𝒜.restriction H))
    (v : ExteriorAlgebra B (𝒜.restriction H →₀ B)) :
    preRestrictionToCokernel B 𝒜 H r (u * x * v) = 0 := by
  have hu : u ∈ Submodule.span B (Set.range
      (word (exteriorGen B) : List (𝒜.restriction H) → _)) :=
    OrlikSolomon.span_range_word B ▸ Submodule.mem_top
  induction hu using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨I, rfl⟩ := hu
    have hcomm : generator B 𝒜 H * word (representativeGenerator B 𝒜 r) I =
        (I.length : ℤ).negOnePow • (word (representativeGenerator B 𝒜 r) I * generator B 𝒜 H) := by
      have h := (isExteriorFamily_generator B 𝒜).mul_word_comm H
        (I.map fun L ↦ Arrangement.inclusion (𝒜.deletion_le H) (r L))
      simp only [word_map, List.length_map] at h
      exact h
    have hleft : word (representativeGenerator B 𝒜 r) I ∈ deletionRange B 𝒜 H := by
      rw [← representativeMap_word]
      exact representativeMap_mem_deletionRange B 𝒜 r _
    have hold := mul_mem_deletionRange B 𝒜 H
      (mul_mem_deletionRange B 𝒜 H hleft (hrel x hx))
      (representativeMap_mem_deletionRange B 𝒜 r v)
    rw [preRestrictionToCokernel_apply, map_mul (representativeMap B 𝒜 r),
      map_mul (representativeMap B 𝒜 r), representativeMap_word]
    have heq : generator B 𝒜 H *
        (word (representativeGenerator B 𝒜 r) I * representativeMap B 𝒜 r x *
          representativeMap B 𝒜 r v) =
        (I.length : ℤ).negOnePow •
          (word (representativeGenerator B 𝒜 r) I *
            (generator B 𝒜 H * representativeMap B 𝒜 r x) * representativeMap B 𝒜 r v) := by
      calc
        _ = (generator B 𝒜 H * word (representativeGenerator B 𝒜 r) I) *
            representativeMap B 𝒜 r x * representativeMap B 𝒜 r v := by simp only [mul_assoc]
        _ = _ := by
          rw [hcomm, smul_mul_assoc, smul_mul_assoc]
          simp only [mul_assoc]
    rw [heq, map_zsmul_unit, (cokernelMk_eq_zero_iff B 𝒜 H).2 hold, smul_zero]
  | zero => simp
  | add u v _ _ hu hv => simp only [add_mul, map_add, hu, hv, add_zero]
  | smul b u _ hu => simp only [smul_mul_assoc, map_smul, hu, smul_zero]

end OrlikSolomon.OSAlgebra
