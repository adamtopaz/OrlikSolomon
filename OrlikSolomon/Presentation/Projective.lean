module

public import OrlikSolomon.Geometry.Projective
public import OrlikSolomon.Presentation.ProjectiveGrading
public import OrlikSolomon.Presentation.Structure

/-!
# The projective structure theorem

The projective Orlik–Solomon algebra is canonically the cohomology of the projective
complement. The map is characterized by its pullback to the cone complement; a hyperplane
at infinity is used only to prove that this map is bijective. Differences of generators map
to logarithms of ratios of arbitrary equations. The equivalence preserves the bigrading.

Blueprint: `thm:projective`.
-/

@[expose] public section

noncomputable section

open CategoryTheory Module DirectSum
open OrlikSolomon.SmoothAlg OrlikSolomon.Arrangement OrlikSolomon.OSAlgebra
open OrlikSolomon.ProjectiveArrangement OrlikSolomon.ProjectiveArrangement.ComplementRing

universe u v w z

namespace OrlikSolomon

/-- A nonempty projective arrangement has a nonempty central cone arrangement. -/
instance ProjectiveArrangement.nonempty_cone {k : Type u} [Field k] {W : Type u}
    [AddCommGroup W] [Module k W] (P : ProjectiveArrangement k W) [Nonempty P] :
    Nonempty P.cone := P.coneHyperplaneEquiv.symm.nonempty

namespace OrdinaryTheory

variable {k : Type u} [Field k] {R : Type v} [CommRing R] {B : Type w} [CommRing B]
  [Algebra R B] {ℬ : ℤ → Submodule R B} [GradedAlgebra ℬ]
  (T : OrdinaryTheory.{u, v, w, z} k ℬ)
  {W : Type u} [AddCommGroup W] [Module k W] [FiniteDimensional k W]
  (P : ProjectiveArrangement k W) [Nonempty P]

/-- Pullback along the cone projection is injective: the product with `𝔾ₘ` has the section
`t = 1`. No rational point of the complement is needed. -/
theorem injective_map_projectiveToCone : Function.Injective (T.C.map (projectiveToCone P)) := by
  obtain ⟨ℓ₀, h₀⟩ := P.exists_ker_mem
  apply Function.LeftInverse.injective
    (g := T.C.map ((coneIso h₀).hom ≫ laurentSection (projectiveComplement P)))
  intro x
  rw [T.map_map, projectiveToCone_comp_coneIso_hom_comp_laurentSection]
  simp

/-- Pullback of the logarithm of a ratio is the realization of the corresponding difference
of cone generators, for arbitrary equations. -/
theorem map_projectiveToCone_logClass_ratio {ℓ ℓ' : Dual k W}
    (hℓ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P) :
    T.C.map (projectiveToCone P) (T.logClass (projectiveRatioUnit hℓ hℓ')) =
      T.realization P.cone
        (generator B P.cone (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ, hℓ⟩) -
          generator B P.cone (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ', hℓ'⟩)) := by
  rw [map_sub, T.realization_generator_of_isEquation _
      (isEquation_toAffineMap (ne_zero_of_ker_mem hℓ)),
    T.realization_generator_of_isEquation _ (isEquation_toAffineMap (ne_zero_of_ker_mem hℓ')),
    T.map_logClass, mapUnits_projectiveToCone_projectiveRatioUnit,
    T.logClass_mul, T.logClass_inv, sub_eq_add_neg]

/-- Every realized projective class descends along the cone projection. The proof uses the
algebra generated by differences from one hyperplane; the assertion makes no such choice. -/
theorem realization_mem_range_projectiveToCone
    (x : projectiveAlgebra B P.cone_isCentral) :
    T.realization P.cone x ∈ (T.C.map (projectiveToCone P)).hom.range := by
  obtain ⟨ℓ₀, h₀⟩ := P.exists_ker_mem
  have hle : projectiveAlgebra B P.cone_isCentral ≤
      ((T.C.map (projectiveToCone P)).hom.range).comap (T.realization P.cone) := by
    rw [projectiveAlgebra_eq_adjoin B P.cone_isCentral
      (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ₀, h₀⟩)]
    apply Algebra.adjoin_le
    rintro _ ⟨H, rfl⟩
    obtain ⟨K, rfl⟩ := P.coneHyperplaneEquiv.surjective H
    obtain ⟨ℓ, hℓ⟩ := exists_ker_eq K.2
    have hmem : LinearMap.ker ℓ ∈ P := hℓ ▸ K.2
    refine ⟨T.logClass (projectiveRatioUnit hmem h₀), ?_⟩
    change T.C.map (projectiveToCone P) _ = T.realization P.cone _
    have hK : (⟨LinearMap.ker ℓ, hmem⟩ : P) = K := Subtype.ext hℓ
    simpa only [hK] using T.map_projectiveToCone_logClass_ratio P hmem h₀
  exact hle x.2

/-- The canonical projective realization map. It is the unique descent of affine realization
on the boundary kernel through the injective cone pullback. In particular its definition
makes no choice of an equation or of a hyperplane at infinity.

Blueprint: `thm:projective`. -/
def projectiveRealization :
    projectiveAlgebra B P.cone_isCentral →ₐ[B] T.C.obj (projectiveComplement P) :=
  (AlgEquiv.ofInjective (T.C.map (projectiveToCone P)).hom
      (T.injective_map_projectiveToCone P)).symm.toAlgHom.comp
    (((T.realization P.cone).comp (projectiveAlgebra B P.cone_isCentral).val).codRestrict
      (T.C.map (projectiveToCone P)).hom.range
      (T.realization_mem_range_projectiveToCone P))

/-- The projective realization pulls back to the affine realization of the cone. -/
@[simp]
theorem map_projectiveToCone_projectiveRealization
    (x : projectiveAlgebra B P.cone_isCentral) :
    T.C.map (projectiveToCone P) (T.projectiveRealization P x) = T.realization P.cone x := by
  exact congrArg Subtype.val ((AlgEquiv.ofInjective (T.C.map (projectiveToCone P)).hom
    (T.injective_map_projectiveToCone P)).apply_symm_apply _)

/-- Differences of cone generators go to logarithms of ratios of any defining forms.

Blueprint: `thm:projective`. -/
theorem projectiveRealization_generator_sub_generator {ℓ ℓ' : Dual k W}
    (hℓ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P) :
    T.projectiveRealization P
      ⟨generator B P.cone (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ, hℓ⟩) -
        generator B P.cone (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ', hℓ'⟩),
        generator_sub_generator_mem_projectiveAlgebra B P.cone_isCentral _ _⟩ =
      T.logClass (projectiveRatioUnit hℓ hℓ') := by
  apply T.injective_map_projectiveToCone P
  rw [T.map_projectiveToCone_projectiveRealization,
    T.map_projectiveToCone_logClass_ratio]

/-- The projective realization is injective by the affine theorem and the cone pullback. -/
theorem injective_projectiveRealization : Function.Injective (T.projectiveRealization P) := by
  intro x y h
  apply Subtype.ext
  apply (T.bijective_realization P.cone).1
  simpa only [T.map_projectiveToCone_projectiveRealization] using
    congrArg (T.C.map (projectiveToCone P)) h

/-- The projective realization is surjective. In the decone chart, each logarithmic generator
is the logarithm of an equation ratio, and arbitrary classes are linear combinations of
products of these generators. -/
theorem surjective_projectiveRealization : Function.Surjective (T.projectiveRealization P) := by
  obtain ⟨ℓ₀, h₀⟩ := P.exists_ker_mem
  let f := (T.C.map (deconeIso h₀).hom).hom.comp (T.projectiveRealization P)
  have hgen (L : P.decone ℓ₀) : T.logClass (equationUnit (P.decone ℓ₀) L) ∈ f.range := by
    obtain ⟨M, hM, hne, hML⟩ := (mem_decone h₀).1 L.2
    obtain ⟨ℓ, rfl⟩ := exists_ker_eq hM
    refine ⟨⟨generator B P.cone (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ, hM⟩) -
        generator B P.cone (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ₀, h₀⟩),
        generator_sub_generator_mem_projectiveAlgebra B P.cone_isCentral _ _⟩, ?_⟩
    change T.C.map (deconeIso h₀).hom (T.projectiveRealization P _) = _
    rw [T.projectiveRealization_generator_sub_generator,
      T.map_logClass, mapUnits_deconeIso_hom_projectiveRatioUnit_self]
    apply T.logClass_complementUnit_eq_logClass_equationUnit L.2
    exact hML ▸ isEquation_comp_chart_slice h₀ hM hne
  have hspan : Submodule.span B (Set.range (T.logMonomial (P.decone ℓ₀))) ≤
      f.range.toSubmodule := by
    apply Submodule.span_le.2
    rintro _ ⟨I, rfl⟩
    induction I with
    | nil => exact f.range.one_mem
    | cons L I ih =>
      rw [T.logMonomial_cons]
      exact f.range.mul_mem (hgen L) ih
  intro x
  have hx : T.C.map (deconeIso h₀).hom x ∈ f.range :=
    hspan ((T.generated (P.decone ℓ₀)).mem_span _)
  obtain ⟨y, hy⟩ := hx
  exact ⟨y, (T.bijective_map_hom (deconeIso h₀)).1 hy⟩

/-- The projective realization is bijective over every commutative coefficient ring.

Blueprint: `thm:projective`. -/
theorem bijective_projectiveRealization : Function.Bijective (T.projectiveRealization P) :=
  ⟨T.injective_projectiveRealization P, T.surjective_projectiveRealization P⟩

/-- The canonical projective structure theorem, as an equivalence of `B`-algebras.
Its defining formula is pullback compatibility with the cone realization, and differences
of generators go to logarithms of arbitrary equation ratios.

Blueprint: `thm:projective`. -/
def projectiveEquiv :
    projectiveAlgebra B P.cone_isCentral ≃ₐ[B] T.C.obj (projectiveComplement P) :=
  AlgEquiv.ofBijective (T.projectiveRealization P) (T.bijective_projectiveRealization P)

/-- The projective equivalence is the canonical realization map. -/
theorem projectiveEquiv_apply (x : projectiveAlgebra B P.cone_isCentral) :
    T.projectiveEquiv P x = T.projectiveRealization P x := rfl

/-- The algebra homomorphism underlying the projective equivalence is realization. -/
@[simp]
theorem toAlgHom_projectiveEquiv :
    (T.projectiveEquiv P : projectiveAlgebra B P.cone_isCentral →ₐ[B] _) =
      T.projectiveRealization P := rfl

/-- The projective equivalence pulls back to the affine cone equivalence. -/
@[simp]
theorem map_projectiveToCone_projectiveEquiv (x : projectiveAlgebra B P.cone_isCentral) :
    T.C.map (projectiveToCone P) (T.projectiveEquiv P x) = T.affineEquiv P.cone x :=
  T.map_projectiveToCone_projectiveRealization P x

/-- A cone class is in the pullback image exactly when its inverse affine realization
belongs to the projective boundary kernel. -/
theorem mem_range_projectiveToCone_iff (x : T.C.obj (complement P.cone)) :
    x ∈ (T.C.map (projectiveToCone P)).hom.range ↔
      (T.affineEquiv P.cone).symm x ∈ projectiveAlgebra B P.cone_isCentral := by
  constructor
  · rintro ⟨y, rfl⟩
    obtain ⟨a, rfl⟩ := (T.projectiveEquiv P).surjective y
    change (T.affineEquiv P.cone).symm
      (T.C.map (projectiveToCone P) (T.projectiveEquiv P a)) ∈ _
    rw [T.map_projectiveToCone_projectiveEquiv, AlgEquiv.symm_apply_apply]
    exact a.2
  · intro hx
    refine ⟨T.projectiveEquiv P ⟨(T.affineEquiv P.cone).symm x, hx⟩, ?_⟩
    change T.C.map (projectiveToCone P) (T.projectiveEquiv P _) = x
    rw [T.map_projectiveToCone_projectiveEquiv, AlgEquiv.apply_symm_apply]

/-- The canonical projective realization is uniquely characterized by its cone pullback.
In particular it is independent of any hyperplane used to prove descent or surjectivity. -/
theorem projectiveRealization_unique
    (φ : projectiveAlgebra B P.cone_isCentral →ₐ[B] T.C.obj (projectiveComplement P))
    (hφ : ∀ x, T.C.map (projectiveToCone P) (φ x) = T.realization P.cone x) :
    φ = T.projectiveRealization P := by
  ext x
  apply T.injective_map_projectiveToCone P
  rw [hφ, T.map_projectiveToCone_projectiveRealization]

/-- The projective equivalence sends a difference of cone generators to the logarithm
of the ratio of any equations of the two hyperplanes.

Blueprint: `thm:projective`. -/
theorem projectiveEquiv_difference {ℓ ℓ' : Dual k W}
    (hℓ : LinearMap.ker ℓ ∈ P) (hℓ' : LinearMap.ker ℓ' ∈ P) :
    T.projectiveEquiv P (projectiveDifference B P.cone_isCentral
      (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ, hℓ⟩)
      (P.coneHyperplaneEquiv ⟨LinearMap.ker ℓ', hℓ'⟩)) =
      T.logClass (projectiveRatioUnit hℓ hℓ') :=
  T.projectiveRealization_generator_sub_generator P hℓ hℓ'

/-- Realization preserves the inherited projective bigrading. -/
theorem isHomogeneousOfShift_projectiveRealization :
    IsHomogeneousOfShift (projectiveBigrading B ℬ P.cone_isCentral)
      (T.grading (projectiveComplement P)) 0 (T.projectiveRealization P) := by
  intro i x hx
  have h := T.realization_mem_grading
    ((mem_projectiveBigrading_iff B ℬ P.cone_isCentral).1 hx)
  rw [← T.map_projectiveToCone_projectiveRealization P x] at h
  have hx' := (T.isHomogeneousOfShift_map (projectiveToCone P)).mem_of_map_mem
    (T.injective_map_projectiveToCone P) (add_zero i) h
  simpa only [add_zero] using hx'

/-- The projective equivalence preserves the bigrading. -/
theorem isHomogeneousOfShift_projectiveEquiv :
    IsHomogeneousOfShift (projectiveBigrading B ℬ P.cone_isCentral)
      (T.grading (projectiveComplement P)) 0 (T.projectiveEquiv P) :=
  T.isHomogeneousOfShift_projectiveRealization P

/-- The inverse projective equivalence preserves the bigrading. -/
theorem isHomogeneousOfShift_projectiveEquiv_symm :
    IsHomogeneousOfShift (T.grading (projectiveComplement P))
      (projectiveBigrading B ℬ P.cone_isCentral) 0 (T.projectiveEquiv P).symm := by
  simpa only [neg_zero] using (T.isHomogeneousOfShift_projectiveEquiv P).algEquiv_symm

/-- A projective class has bidegree `i` exactly when its realization does. -/
theorem projectiveEquiv_mem_grading_iff {i : ℤ × ℤ}
    {x : projectiveAlgebra B P.cone_isCentral} :
    T.projectiveEquiv P x ∈ T.grading (projectiveComplement P) i ↔
      x ∈ projectiveBigrading B ℬ P.cone_isCentral i :=
  ⟨(T.isHomogeneousOfShift_projectiveEquiv P).mem_of_map_mem
      (T.projectiveEquiv P).injective (add_zero i),
    fun hx ↦ isHomogeneousOfShift_zero_iff.1
      (T.isHomogeneousOfShift_projectiveEquiv P) hx⟩

/-- The inverse projective equivalence detects the same homogeneous pieces. -/
theorem projectiveEquiv_symm_mem_bigrading_iff {i : ℤ × ℤ}
    {y : T.C.obj (projectiveComplement P)} :
    (T.projectiveEquiv P).symm y ∈ projectiveBigrading B ℬ P.cone_isCentral i ↔
      y ∈ T.grading (projectiveComplement P) i := by
  rw [← T.projectiveEquiv_mem_grading_iff, AlgEquiv.apply_symm_apply]

/-- Projective realization commutes with taking homogeneous components. -/
theorem decompose_projectiveEquiv (x : projectiveAlgebra B P.cone_isCentral) (i : ℤ × ℤ) :
    (decompose (T.grading (projectiveComplement P)) (T.projectiveEquiv P x) i :
      T.C.obj (projectiveComplement P)) =
      T.projectiveEquiv P (decompose (projectiveBigrading B ℬ P.cone_isCentral) x i) :=
  (T.isHomogeneousOfShift_projectiveEquiv P).decompose_map (add_zero i) x

/-- The projective structure theorem on each homogeneous piece, as an `R`-linear equivalence.

Blueprint: `thm:projective`. -/
def projectiveComponentEquiv (i : ℤ × ℤ) :
    projectiveBigrading B ℬ P.cone_isCentral i ≃ₗ[R]
      T.grading (projectiveComplement P) i :=
  IsHomogeneousOfShift.componentEquiv (e := (T.projectiveEquiv P).toLinearEquiv)
    (T.isHomogeneousOfShift_projectiveEquiv P) (add_zero i)

/-- The component equivalence is the restriction of the projective equivalence. -/
@[simp]
theorem coe_projectiveComponentEquiv_apply (i : ℤ × ℤ)
    (x : projectiveBigrading B ℬ P.cone_isCentral i) :
    (T.projectiveComponentEquiv P i x : T.C.obj (projectiveComplement P)) =
      T.projectiveEquiv P x := rfl

end OrdinaryTheory

end OrlikSolomon
