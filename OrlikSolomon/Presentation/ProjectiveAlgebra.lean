import Mathlib.Tactic.NoncommRing

/-!
# The projective Orlik–Solomon algebra

The kernel of the central word boundary is a subalgebra. After choosing a hyperplane, it is
generated by the differences from that hyperplane, and two copies of it give a linear
decomposition of the full algebra. The second copy is inserted by left multiplication by the
chosen generator, and therefore has bidegree shifted by `(1,1)`.

Blueprint: `lem:projective-algebra`. This is a module decomposition; its multiplication is not
the multiplication of an ordinary ungraded tensor product of algebras.
-/

@[expose] public section

noncomputable section

universe u

namespace OrlikSolomon.IsExteriorFamily

/-- If words in a square-zero anticommuting family span an algebra, any coefficient subalgebra
containing its differences from one generator spans the algebra together with its left multiple
by that generator. -/
theorem exists_mem_decomposition_of_sub_mem {I A B : Type*} [CommRing B] [Ring A]
    [Algebra B A] {f : I → A} (hf : IsExteriorFamily f)
    (hspan : Submodule.span B (Set.range (word f : List I → A)) = ⊤)
    (S : Subalgebra B A) (H₀ : I) (hS : ∀ H, f H - f H₀ ∈ S) (x : A) :
    ∃ b ∈ S, ∃ c ∈ S, x = b + f H₀ * c := by
  have hword (I : List I) :
      ∃ b ∈ S, ∃ c ∈ S, word f I = b + f H₀ * c := by
    induction I with
    | nil => exact ⟨1, S.one_mem, 0, S.zero_mem, by simp⟩
    | cons H I ih =>
      obtain ⟨b, hb, c, hc, hI⟩ := ih
      let d := f H - f H₀
      refine ⟨d * b, S.mul_mem (hS H) hb, b - d * c,
        S.sub_mem hb (S.mul_mem (hS H) hc), ?_⟩
      rw [word_cons, hI, mul_add, ← mul_assoc (f H),
        hf.mul_eq_neg_mul_swap H H₀]
      dsimp [d]
      noncomm_ring
      simp only [← mul_assoc, hf.mul_self, zero_mul, add_zero]
  have hx : x ∈ Submodule.span B (Set.range (word f : List I → _)) := by
    rw [hspan]
    exact Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem x hx => obtain ⟨I, rfl⟩ := hx; exact hword I
  | zero => exact ⟨0, S.zero_mem, 0, S.zero_mem, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨b, hb, c, hc, rfl⟩ := hx
    obtain ⟨b', hb', c', hc', rfl⟩ := hy
    refine ⟨b + b', S.add_mem hb hb', c + c', S.add_mem hc hc', ?_⟩
    noncomm_ring
  | smul a x _ hx =>
    obtain ⟨b, hb, c, hc, rfl⟩ := hx
    exact ⟨a • b, S.smul_mem hb a, a • c, S.smul_mem hc a, by
      rw [smul_add, mul_smul_comm]⟩

end OrlikSolomon.IsExteriorFamily

namespace OrlikSolomon.OSAlgebra

variable {k : Type u} [Field k] {V : Type u} [AddCommGroup V] [Module k V]
  (B : Type*) [CommRing B] {𝒜 : Arrangement k V}

/-- With a boundary-closed right factor, the signed Leibniz rule has no second term, even when
the left factor is not homogeneous. -/
theorem boundary_mul_of_boundary_eq_zero (h𝒜 : 𝒜.IsCentral) (x : OSAlgebra B 𝒜)
    {y : OSAlgebra B 𝒜} (hy : boundary B h𝒜 y = 0) :
    boundary B h𝒜 (x * y) = boundary B h𝒜 x * y := by
  have hx : x ∈ Submodule.span B (Set.range (word (generator B 𝒜) : List 𝒜 → _)) := by
    rw [span_range_word]
    exact Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨I, rfl⟩ := hx
    simp only [boundary_word_mul, hy, mul_zero, smul_zero, add_zero, boundary_word]
  | zero => simp
  | add x z _ _ hx hz => simp only [add_mul, map_add, hx, hz]
  | smul b x _ hx => simp only [smul_mul_assoc, map_smul, hx]

/-- The projective Orlik–Solomon algebra is the kernel of the boundary on a central algebra.
Blueprint: `lem:projective-algebra`. -/
def projectiveAlgebra (h𝒜 : 𝒜.IsCentral) : Subalgebra B (OSAlgebra B 𝒜) :=
  (LinearMap.ker (boundary B h𝒜)).toSubalgebra (boundary_one B h𝒜) fun x y hx hy ↦ by
    change boundary B h𝒜 (x * y) = 0
    rw [boundary_mul_of_boundary_eq_zero B h𝒜 x hy, hx, zero_mul]

/-- Membership in the projective algebra is exactly vanishing of the central boundary. -/
@[simp]
theorem mem_projectiveAlgebra_iff (h𝒜 : 𝒜.IsCentral) {x : OSAlgebra B 𝒜} :
    x ∈ projectiveAlgebra B h𝒜 ↔ boundary B h𝒜 x = 0 := Iff.rfl

/-- The projective algebra has the boundary kernel as its underlying coefficient submodule. -/
@[simp]
theorem projectiveAlgebra_toSubmodule (h𝒜 : 𝒜.IsCentral) :
    (projectiveAlgebra B h𝒜).toSubmodule = LinearMap.ker (boundary B h𝒜) := rfl

/-- Differences of hyperplane generators are projective classes. -/
theorem generator_sub_generator_mem_projectiveAlgebra (h𝒜 : 𝒜.IsCentral) (H K : 𝒜) :
    generator B 𝒜 H - generator B 𝒜 K ∈ projectiveAlgebra B h𝒜 := by
  simp

/-- Relative to any chosen hyperplane, the differences of generators generate the projective
algebra over the full coefficient ring. Blueprint: `lem:projective-algebra`. -/
theorem projectiveAlgebra_eq_adjoin (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜) :
    projectiveAlgebra B h𝒜 = Algebra.adjoin B
      (Set.range fun H : 𝒜 ↦ generator B 𝒜 H - generator B 𝒜 H₀) := by
  let S := Algebra.adjoin B (Set.range fun H : 𝒜 ↦ generator B 𝒜 H - generator B 𝒜 H₀)
  have hS : ∀ H, generator B 𝒜 H - generator B 𝒜 H₀ ∈ S :=
    fun H ↦ Algebra.subset_adjoin ⟨H, rfl⟩
  have hle : S ≤ projectiveAlgebra B h𝒜 :=
    Algebra.adjoin_le (by rintro _ ⟨H, rfl⟩; exact
      generator_sub_generator_mem_projectiveAlgebra B h𝒜 H H₀)
  apply le_antisymm ?_ hle
  intro x hx
  obtain ⟨b, hb, c, hc, hbc⟩ :=
    (isExteriorFamily_generator B 𝒜).exists_mem_decomposition_of_sub_mem
      (span_range_word B 𝒜) S H₀ hS x
  have hb' : boundary B h𝒜 b = 0 := hle hb
  have hc' : boundary B h𝒜 c = 0 := hle hc
  have hc0 : c = 0 := by
    have h := hx
    rw [mem_projectiveAlgebra_iff, hbc, map_add, hb', boundary_generator_mul, hc'] at h
    simpa only [mul_zero, sub_zero, zero_add] using h
  simpa only [hbc, hc0, mul_zero, add_zero] using hb

/-- The boundary itself takes values in the projective algebra. -/
def projectiveBoundary (h𝒜 : 𝒜.IsCentral) : OSAlgebra B 𝒜 →ₗ[B] projectiveAlgebra B h𝒜 :=
  (boundary B h𝒜).codRestrict _ (boundary_boundary B h𝒜)

/-- The boundary with projective codomain has the original boundary as its underlying map. -/
@[simp]
theorem coe_projectiveBoundary (h𝒜 : 𝒜.IsCentral) (x : OSAlgebra B 𝒜) :
    (projectiveBoundary B h𝒜 x : OSAlgebra B 𝒜) = boundary B h𝒜 x := rfl

/-- Subtracting the chosen generator times the boundary projects onto the projective algebra. -/
def projectiveProjection (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜) :
    OSAlgebra B 𝒜 →ₗ[B] projectiveAlgebra B h𝒜 :=
  (LinearMap.id - (LinearMap.mulLeft B (generator B 𝒜 H₀)).comp (boundary B h𝒜)).codRestrict
    _ fun x ↦ by simp

/-- The projective projection has the contracting-homotopy formula on underlying elements. -/
@[simp]
theorem coe_projectiveProjection (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜) (x : OSAlgebra B 𝒜) :
    (projectiveProjection B h𝒜 H₀ x : OSAlgebra B 𝒜) =
      x - generator B 𝒜 H₀ * boundary B h𝒜 x := rfl

/-- Every element splits uniquely into a projective class and the chosen generator times a
projective class. The second summand has degree shifted by `(1,1)`.
Blueprint: `lem:projective-algebra`. -/
def projectiveDecomposition (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜) :
    (projectiveAlgebra B h𝒜 × projectiveAlgebra B h𝒜) ≃ₗ[B] OSAlgebra B 𝒜 where
  toFun x := x.1 + generator B 𝒜 H₀ * x.2
  invFun x := (projectiveProjection B h𝒜 H₀ x, projectiveBoundary B h𝒜 x)
  map_add' x y := by simp only [Prod.fst_add, Prod.snd_add, Subalgebra.coe_add, mul_add]; abel
  map_smul' b x := by simp only [Prod.smul_fst, Prod.smul_snd, Subalgebra.coe_smul,
    mul_smul_comm, smul_add, RingHom.id_apply]
  left_inv x := by
    rcases x with ⟨b, c⟩
    have hb : boundary B h𝒜 (b : OSAlgebra B 𝒜) = 0 := b.property
    have hc : boundary B h𝒜 (c : OSAlgebra B 𝒜) = 0 := c.property
    apply Prod.ext <;> apply Subtype.ext <;> simp_all
  right_inv x := by simp

/-- The projective module decomposition inserts the second term by left multiplication. -/
@[simp]
theorem projectiveDecomposition_apply (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    (x : projectiveAlgebra B h𝒜 × projectiveAlgebra B h𝒜) :
    projectiveDecomposition B h𝒜 H₀ x = x.1 + generator B 𝒜 H₀ * x.2 := rfl

/-- The first inverse component is the projective projection. -/
@[simp]
theorem projectiveDecomposition_symm_fst (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    (x : OSAlgebra B 𝒜) :
    ((projectiveDecomposition B h𝒜 H₀).symm x).1 = projectiveProjection B h𝒜 H₀ x := rfl

/-- The second inverse component is the boundary. -/
@[simp]
theorem projectiveDecomposition_symm_snd (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    (x : OSAlgebra B 𝒜) :
    ((projectiveDecomposition B h𝒜 H₀).symm x).2 = projectiveBoundary B h𝒜 x := rfl

/-- The inclusion of the second projective summand is multiplication by the chosen generator
on the left. It is injective, even for characteristic two and degenerate coefficients. -/
def generatorMulProjective (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜) :
    projectiveAlgebra B h𝒜 →ₗ[B] OSAlgebra B 𝒜 :=
  (LinearMap.mulLeft B (generator B 𝒜 H₀)).comp (projectiveAlgebra B h𝒜).val.toLinearMap

@[simp]
theorem generatorMulProjective_apply (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    (x : projectiveAlgebra B h𝒜) :
    generatorMulProjective B h𝒜 H₀ x = generator B 𝒜 H₀ * x := rfl

/-- Taking the boundary recovers the second projective summand. -/
@[simp]
theorem projectiveBoundary_generator_mul (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    (x : projectiveAlgebra B h𝒜) :
    projectiveBoundary B h𝒜 (generator B 𝒜 H₀ * x) = x := by
  apply Subtype.ext
  have hx : boundary B h𝒜 (x : OSAlgebra B 𝒜) = 0 := x.property
  simp [hx]

/-- The second projective inclusion is injective because the boundary is a left inverse. -/
theorem generatorMulProjective_injective (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜) :
    Function.Injective (generatorMulProjective B h𝒜 H₀) :=
  Function.LeftInverse.injective (projectiveBoundary_generator_mul B h𝒜 H₀)

section Bigrading

variable {R : Type*} [CommRing R] [Algebra R B]
  (ℬ : ℤ → Submodule R B)

/-- The inherited weighted bigrading on the projective subalgebra. -/
def projectiveBigrading (h𝒜 : 𝒜.IsCentral) (i : ℤ × ℤ) :
    Submodule R (projectiveAlgebra B h𝒜) :=
  (bigrading 𝒜 ℬ i).comap ((projectiveAlgebra B h𝒜).val.toLinearMap.restrictScalars R)

/-- An element of the projective algebra has precisely its degree in the full algebra. -/
@[simp]
theorem mem_projectiveBigrading_iff (h𝒜 : 𝒜.IsCentral) {i : ℤ × ℤ}
    {x : projectiveAlgebra B h𝒜} :
    x ∈ projectiveBigrading B ℬ h𝒜 i ↔ (x : OSAlgebra B 𝒜) ∈ bigrading 𝒜 ℬ i := Iff.rfl

/-- The projective inclusion preserves the inherited bigrading. -/
theorem isHomogeneousOfShift_projectiveInclusion (h𝒜 : 𝒜.IsCentral) :
    IsHomogeneousOfShift (projectiveBigrading B ℬ h𝒜) (bigrading 𝒜 ℬ) 0
      (projectiveAlgebra B h𝒜).val := by
  intro i x hx
  change (x : OSAlgebra B 𝒜) ∈ bigrading 𝒜 ℬ (i + 0)
  simpa only [add_zero] using (mem_projectiveBigrading_iff B ℬ h𝒜).1 hx

/-- The boundary, with projective codomain, lowers both degrees by one. -/
theorem isHomogeneousOfShift_projectiveBoundary (h𝒜 : 𝒜.IsCentral) :
    IsHomogeneousOfShift (bigrading 𝒜 ℬ) (projectiveBigrading B ℬ h𝒜) (-1, -1)
      (projectiveBoundary B h𝒜) :=
  isHomogeneousOfShift_boundary B ℬ h𝒜

variable [GradedAlgebra ℬ]

/-- Projection onto the first projective summand preserves bidegree. -/
theorem isHomogeneousOfShift_projectiveProjection (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜) :
    IsHomogeneousOfShift (bigrading 𝒜 ℬ) (projectiveBigrading B ℬ h𝒜) 0
      (projectiveProjection B h𝒜 H₀) := by
  intro i x hx
  change x - generator B 𝒜 H₀ * boundary B h𝒜 x ∈ bigrading 𝒜 ℬ (i + 0)
  rw [add_zero]
  refine Submodule.sub_mem _ hx ?_
  have h := SetLike.mul_mem_graded (generator_mem_bigrading 𝒜 ℬ H₀)
    (isHomogeneousOfShift_boundary B ℬ h𝒜 hx)
  convert h using 1
  congr 1
  abel

/-- The second inclusion raises both degrees by one, making the decomposition a shifted
graded module decomposition. -/
theorem isHomogeneousOfShift_generatorMulProjective (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜) :
    IsHomogeneousOfShift (projectiveBigrading B ℬ h𝒜) (bigrading 𝒜 ℬ) (1, 1)
      (generatorMulProjective B h𝒜 H₀) := by
  intro i x hx
  change generator B 𝒜 H₀ * (x : OSAlgebra B 𝒜) ∈ bigrading 𝒜 ℬ (i + (1, 1))
  rw [add_comm]
  exact SetLike.mul_mem_graded (generator_mem_bigrading 𝒜 ℬ H₀) hx

/-- Every homogeneous component of a projective class is still projective.
Blueprint: `lem:projective-algebra`. -/
theorem projectiveAlgebra_isHomogeneous (h𝒜 : 𝒜.IsCentral) :
    DirectSum.SetLike.IsHomogeneous (bigrading 𝒜 ℬ) (projectiveAlgebra B h𝒜) := by
  intro i x hx
  exact ((isHomogeneousOfShift_boundary B ℬ h𝒜).map_eq_zero_iff_forall_decompose.1 hx) i

/-- The boundary kernel is an internally bigraded coefficient subalgebra.
Blueprint: `lem:projective-algebra`. -/
instance projectiveBigradingGradedAlgebra (h𝒜 : 𝒜.IsCentral) :
    GradedAlgebra (projectiveBigrading B ℬ h𝒜) :=
  homogeneousSubalgebraGradedAlgebra (bigrading 𝒜 ℬ)
    ((projectiveAlgebra B h𝒜).restrictScalars R) (projectiveAlgebra_isHomogeneous B ℬ h𝒜)

/-- Homogeneous decomposition inside the projective algebra agrees with decomposition inside
the full algebra. -/
@[simp]
theorem coe_decompose_projectiveBigrading (h𝒜 : 𝒜.IsCentral)
    (x : projectiveAlgebra B h𝒜) (i : ℤ × ℤ) :
    ((DirectSum.decompose (projectiveBigrading B ℬ h𝒜) x i : projectiveAlgebra B h𝒜) :
        OSAlgebra B 𝒜) = (DirectSum.decompose (bigrading 𝒜 ℬ) (x : OSAlgebra B 𝒜) i :
        OSAlgebra B 𝒜) :=
  ((isHomogeneousOfShift_projectiveInclusion B ℬ h𝒜).decompose_map (add_zero i) x).symm

/-- The projective module decomposition identifies degree `i` with the projective degree `i`
and the projective degree `j`, where `j + (1,1) = i`. This states the shift on the original
homogeneous pieces. Blueprint: `lem:projective-algebra`. -/
def projectiveDecompositionComponentEquiv (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    {i j : ℤ × ℤ} (hji : j + (1, 1) = i) :
    (projectiveBigrading B ℬ h𝒜 i × projectiveBigrading B ℬ h𝒜 j) ≃ₗ[R] bigrading 𝒜 ℬ i where
  toFun x := ⟨projectiveDecomposition B h𝒜 H₀ (x.1, x.2), by
    apply Submodule.add_mem
    · exact x.1.property
    · exact (isHomogeneousOfShift_generatorMulProjective B ℬ h𝒜 H₀).map_mem hji x.2.property⟩
  invFun x :=
    (⟨((projectiveDecomposition B h𝒜 H₀).symm x).1,
      (isHomogeneousOfShift_projectiveProjection B ℬ h𝒜 H₀).map_mem (add_zero i) x.property⟩,
      ⟨((projectiveDecomposition B h𝒜 H₀).symm x).2,
        (isHomogeneousOfShift_projectiveBoundary B ℬ h𝒜).map_mem
          (by rw [← hji]; abel) x.property⟩)
  map_add' x y := by
    apply Subtype.ext
    simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add,
      projectiveDecomposition_apply, Subalgebra.coe_add, mul_add]
    abel
  map_smul' r x := by
    apply Subtype.ext
    simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul,
      projectiveDecomposition_apply, Subalgebra.coe_smul, RingHom.id_apply, smul_add,
      mul_smul_comm]
  left_inv x := by
    have h := (projectiveDecomposition B h𝒜 H₀).symm_apply_apply
      ((x.1 : projectiveAlgebra B h𝒜), (x.2 : projectiveAlgebra B h𝒜))
    exact Prod.ext (Subtype.ext (congrArg Prod.fst h)) (Subtype.ext (congrArg Prod.snd h))
  right_inv x := Subtype.ext ((projectiveDecomposition B h𝒜 H₀).apply_symm_apply x)

/-- On underlying elements, the homogeneous decomposition is the original two-summand map. -/
@[simp]
theorem coe_projectiveDecompositionComponentEquiv (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    {i j : ℤ × ℤ} (hji : j + (1, 1) = i)
    (x : projectiveBigrading B ℬ h𝒜 i × projectiveBigrading B ℬ h𝒜 j) :
    (projectiveDecompositionComponentEquiv B ℬ h𝒜 H₀ hji x : OSAlgebra B 𝒜) =
      (x.1 : OSAlgebra B 𝒜) + generator B 𝒜 H₀ * (x.2 : OSAlgebra B 𝒜) := rfl

/-- The first inverse homogeneous component is the projective projection. -/
@[simp]
theorem coe_projectiveDecompositionComponentEquiv_symm_fst (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    {i j : ℤ × ℤ} (hji : j + (1, 1) = i) (x : bigrading 𝒜 ℬ i) :
    (((projectiveDecompositionComponentEquiv B ℬ h𝒜 H₀ hji).symm x).1 : OSAlgebra B 𝒜) =
      x - generator B 𝒜 H₀ * boundary B h𝒜 x := rfl

/-- The second inverse homogeneous component is the boundary. -/
@[simp]
theorem coe_projectiveDecompositionComponentEquiv_symm_snd (h𝒜 : 𝒜.IsCentral) (H₀ : 𝒜)
    {i j : ℤ × ℤ} (hji : j + (1, 1) = i) (x : bigrading 𝒜 ℬ i) :
    (((projectiveDecompositionComponentEquiv B ℬ h𝒜 H₀ hji).symm x).2 : OSAlgebra B 𝒜) =
      boundary B h𝒜 x := rfl

end Bigrading

end OrlikSolomon.OSAlgebra
