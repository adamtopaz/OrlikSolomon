module

public import Mathlib.Data.ZMod.Basic
public import OrlikSolomon.Algebra.FinsuppKernel

/-!
# Consumers of the discard-and-merge kernel API

These calculations use only the public optional-label map and kernel API. They cover an empty
retained-label type, one discarded label, two identified labels, characteristic two and the zero
coefficient ring. All kernel calculations are stated over arbitrary rings, without dimension or
nonzero hypotheses.

Blueprint: regressions for the generic free-module calculation used in `lem:l01`, not the affine
trace geometry itself.
-/

@[expose] public section

noncomputable section

namespace OrlikSolomon.FinsuppKernelExamples

open Finsupp

variable {R ι κ : Type*}

/-- With no retained labels, the whole free module is the kernel. -/
theorem ker_empty_target [Ring R] (f : ι → Option Empty) :
    LinearMap.ker (finsuppOptionMap (R := R) f) = ⊤ := by
  have hf : f = fun _ => none := by
    funext i
    cases hi : f i with
    | none => rfl
    | some j => exact j.elim
  rw [hf]
  simp

/-- Surjectivity onto an empty free module needs no source labels. -/
theorem surjective_empty_target [Semiring R] (f : ι → Option Empty) :
    Function.Surjective (finsuppOptionMap (R := R) f) :=
  finsuppOptionMap_surjective f fun j => j.elim

/-- Dropping the `none` label and retaining each `some` label has a one-generator kernel. -/
theorem ker_discard_none [Ring R] :
    LinearMap.ker (finsuppOptionMap (R := R) (id : Option κ → Option κ)) =
      Submodule.span R {single none 1} := by
  apply le_antisymm
  · rw [ker_finsuppOptionMap_le_iff]
    constructor
    · intro i hi
      change i = none at hi
      subst i
      exact Submodule.subset_span (Set.mem_singleton _)
    · intro i i' j hi hi'
      change i = some j at hi
      change i' = some j at hi'
      rw [hi, hi']
      simp
  · rw [Submodule.span_singleton_le_iff_mem]
    simp

/-- Discard one label and merge the other two: the kernel is generated by the discarded basis
vector and the difference of the merged vectors. -/
theorem ker_discard_and_merge [Ring R] :
    LinearMap.ker (finsuppOptionMap (R := R) (Option.map fun _ : Bool => ())) =
      Submodule.span R {single none 1, single (some false) 1 - single (some true) 1} := by
  let S : Submodule R (Option Bool →₀ R) :=
    Submodule.span R {single none 1, single (some false) 1 - single (some true) 1}
  have hdiscard : single none 1 ∈ S := Submodule.subset_span (by simp)
  have hmerge : single (some false) 1 - single (some true) 1 ∈ S :=
    Submodule.subset_span (by simp)
  change _ = S
  apply le_antisymm
  · rw [ker_finsuppOptionMap_le_iff]
    constructor
    · rintro (_ | i) hi
      · exact hdiscard
      · simp at hi
    · rintro (_ | i) (_ | i') j hi hi'
      · simp at hi
      · simp at hi
      · simp at hi'
      · cases i <;> cases i'
        · simp
        · exact hmerge
        · simpa only [neg_sub] using S.neg_mem hmerge
        · simp
  · refine Submodule.span_le.mpr ?_
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl <;> simp

/-- The combined discard-and-merge map is onto its one retained label over every semiring. -/
theorem surjective_discard_and_merge [Semiring R] :
    Function.Surjective (finsuppOptionMap (R := R) (Option.map fun _ : Bool => ())) := by
  apply finsuppOptionMap_surjective
  rintro ⟨⟩
  exact ⟨some false, rfl⟩

/-- A map annihilates this kernel precisely when it kills the discarded vector and agrees on
the merged pair. This is the form of the API used by trace-annihilator calculations. -/
theorem annihilates_discard_and_merge_iff [Ring R] {M : Type*} [AddCommGroup M] [Module R M]
    (g : (Option Bool →₀ R) →ₗ[R] M) :
    LinearMap.ker (finsuppOptionMap (Option.map fun _ : Bool => ())) ≤ LinearMap.ker g ↔
      g (single none 1) = 0 ∧ g (single (some false) 1) = g (single (some true) 1) := by
  rw [ker_finsuppOptionMap_le_ker_iff]
  constructor
  · rintro ⟨hnone, hsome⟩
    exact ⟨hnone none rfl, hsome (some false) (some true) () rfl rfl⟩
  · rintro ⟨hnone, hsome⟩
    constructor
    · rintro (_ | i) hi
      · exact hnone
      · simp at hi
    · rintro (_ | i) (_ | i') j hi hi'
      · simp at hi
      · simp at hi
      · simp at hi'
      · cases i <;> cases i'
        · rfl
        · exact hsome
        · exact hsome.symm
        · rfl

/-- Merging labels does not identify their original basis vectors over a nonzero ring. -/
theorem merged_difference_ne_zero [Ring R] [Nontrivial R] :
    (single (some false) 1 - single (some true) 1 : Option Bool →₀ R) ≠ 0 := by
  intro h
  have := congrArg (fun x : Option Bool →₀ R => x (some false)) h
  simp at this

/-- The nonzero relation vector remains nonzero in characteristic two. -/
theorem merged_difference_ne_zero_zmod_two :
    (single (some false) 1 - single (some true) 1 : Option Bool →₀ ZMod 2) ≠ 0 :=
  merged_difference_ne_zero

/-- With zero coefficients the relation span is the whole, zero, free module, for any label map. -/
theorem relationSpan_zero_coefficients (f : ι → Option κ) :
    finsuppOptionRelationSpan (R := PUnit) f = ⊤ := by
  rw [← ker_finsuppOptionMap, LinearMap.ker_eq_top]
  apply LinearMap.ext
  intro x
  exact Subsingleton.elim _ _

/-- Over the zero ring, an empty source can map onto a nonempty retained-label module even though
there is no label covering hypothesis. -/
theorem surjective_zero_coefficients_empty_source :
    Function.Surjective
      (finsuppOptionMap (R := PUnit) (fun _ : Empty => (none : Option Unit))) := by
  intro x
  exact ⟨0, Subsingleton.elim _ _⟩

end OrlikSolomon.FinsuppKernelExamples
